async function sendGiphyPreview(target, session) {
  const embeds = buildGiphyPreviewEmbeds(session.attachments, session.giphyQuery);
  const rows = buildGiphyActionRows();
  return target.edit({ content: "", embeds, components: rows });
}

async function translateToEnglish(text) {
  try {
    const url = "https://api.mymemory.translated.net/get?q=" + encodeURIComponent(text) + "&langpair=ar|en";
    const res = await fetch(url);
    const data = await res.json();
    const out = data?.responseData?.translatedText;
    if (out && typeof out === "string" && out.length > 0 && !out.includes("MYMEMORY WARNING")) {
      return out;
    }
    return null;
  } catch (e) { return null; }
}

async function giphySearchOnce(query, limit, offset, lang) {
  const key = process.env.GIPHY_KEY;
  if (!key) return null;
  const safeLimit = Math.min(Math.max(limit, 1), 50);
  const off = Math.max(0, parseInt(offset) || 0);
  const url = "https://api.giphy.com/v1/stickers/search?api_key=" + key +
    "&q=" + encodeURIComponent(query) +
    "&limit=" + safeLimit +
    "&offset=" + off +
    "&rating=pg-13&lang=" + lang;
  try {
    const res = await fetch(url);
    const data = await res.json();
    if (!data.data || !data.data.length) return [];
    return data.data.map((g) => ({
      url: g.images.fixed_height_small?.url || g.images.fixed_height?.url || g.images.original.url,
      emojiUrl: g.images.fixed_height_small?.url || g.images.fixed_height?.url,
      stickerUrl: g.images.downsized?.url || g.images.fixed_height?.url,
      staticUrl: g.images.fixed_height_small_still?.url || g.images.fixed_height_still?.url || g.images.original_still?.url || g.images.fixed_height_small?.url,
      _id: g.id,
    }));
  } catch (e) {
    console.log("❌ Giphy error:", e.message);
    return [];
  }
}

async function searchGiphy(query, limit, offset) {
  const safeLimit = Math.min(Math.max(limit, 1), 50);
  const off = Math.max(0, parseInt(offset) || 0);

  // تنظيف الكلمة: نشيل التشكيل والرموز الزائدة
  let q = query.trim().replace(/[\u064B-\u065F\u0670]/g, "").replace(/\s+/g, " ");
  if (!q) q = query;

  const hasArabic = /[\u0600-\u06FF]/.test(q);

  // 1) جرب البحث الأصلي
  let results = await giphySearchOnce(q, safeLimit, off, hasArabic ? "ar" : "en");

  // 2) إذا عربي ونتائج قليلة → نترجم للإنجليزي
  let usedQuery = q;
  if (hasArabic && results.length < Math.ceil(safeLimit / 2)) {
    const translated = await translateToEnglish(q);
    if (translated && translated !== q) {
      console.log("🌐 ترجمة: " + q + " → " + translated);
      const tr = await giphySearchOnce(translated, safeLimit, off, "en");
      // دمج: ناخذ العربي أولاً، بعدين الإنجليزي (بدون تكرار)
      const seen = new Set(results.map((r) => r._id));
      for (const r of tr) {
        if (!seen.has(r._id)) { results.push(r); seen.add(r._id); }
      }
      usedQuery = translated;
    }
  }

  // 3) إذا بعدها فاضي → نجرب trending
  if (results.length === 0) {
    const key = process.env.GIPHY_KEY;
    if (key) {
      try {
        const url = "https://api.giphy.com/v1/stickers/trending?api_key=" + key + "&limit=" + safeLimit + "&rating=pg-13";
        const res = await fetch(url);
        const data = await res.json();
        if (data.data && data.data.length) {
          results = data.data.map((g) => ({
            url: g.images.fixed_height_small?.url || g.images.fixed_height?.url,
            emojiUrl: g.images.fixed_height_small?.url || g.images.fixed_height?.url,
            stickerUrl: g.images.downsized?.url || g.images.fixed_height?.url,
            staticUrl: g.images.fixed_height_small_still?.url || g.images.fixed_height_still?.url || g.images.fixed_height_small?.url,
            _id: g.id,
          }));
          console.log("🔥 رجعت trending بدل البحث");
        }
      } catch {}
    }
  }

  if (!results.length) return null;

  // نحدد الاسم النهائي
  let clean = usedQuery.replace(/[^a-zA-Z0-9]/g, "_").replace(/_+/g, "_").replace(/^_+|_+$/g, "").slice(0, 18);
  if (!clean) clean = "pack";

  return results.slice(0, safeLimit).map((r, i) => ({
    url: r.url,
    emojiUrl: r.emojiUrl,
    stickerUrl: r.stickerUrl,
    staticUrl: r.staticUrl,
    name: (clean + "_" + (i + 1)).slice(0, 30),
  }));
}

