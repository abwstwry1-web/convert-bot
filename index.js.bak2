function getFeatures(uid) {
  if (uid === OWNER_ID) return new Set(["convert","delete","giphy","admin"]);
  if (ALLOWED.includes(uid)) return new Set(["convert","delete","giphy"]);
  const m = members.get(uid);
  return m ? new Set(m.features) : null;
}
function isAllowed(id) {
  return ALLOWED.includes(id) || members.has(id);
}
function hasFeature(uid, feat) {
  const f = getFeatures(uid);
  return f ? f.has(feat) : false;
}
function checkFeature(id, uid) {
  if (!id) return true;
  if (id === "panel_back" || id.startsWith("stk_page_")) return true;
  if (id.startsWith("cat_")) return hasFeature(uid, "giphy");
  const map = {
    panel_convert:"convert", conv_emoji:"convert", conv_emoji_static:"convert",
    conv_sticker:"convert", conv_sticker_static:"convert",
    conv_more:"convert", conv_reset:"convert",
    panel_stickers:"delete", list_stickers:"delete", list_emojis:"delete",
    stk_delete_selected:"delete", stk_delete_all:"delete",
    panel_giphy:"giphy", giphy_retry:"giphy",
    panel_add_member:"admin", panel_add_roles:"admin", 
    panel_channels:"admin", chan_add:"admin", chan_del:"admin", chan_backup:"admin", chan_back:"admin",
    panel_broadcast:"admin", bc_send:"admin", bc_cancel:"admin", bc_back:"admin",
    panel_matches:"admin", match_add:"admin", match_list:"admin", match_del:"admin", match_back:"admin",
    panel_auto_matches:"admin", auto_set_ch:"admin", auto_refresh:"admin", auto_view:"admin", auto_clear:"admin", auto_test:"admin",
    member_features:"admin", member_confirm:"admin", member_cancel:"admin",
  };
  const f = map[id];
  return f ? hasFeature(uid, f) : true;
}

function buildGiphyPreviewEmbeds(items, query) {
  const embeds = [];
  const max = Math.min(items.length, 10);
  for (let i = 0; i < max; i++) {
    const e = new EmbedBuilder().setColor(0x5865f2).setImage(items[i].url);
    if (i === 0) {
      e.setTitle("🔎 " + query + " — " + items.length + " ملصق");
      e.setDescription("👇 إذا عجبك الملصقات اختر نوع الإضافة، وإذا ما عجبك اضغط **إعادة**");
    }
    e.setFooter({ text: "#" + (i + 1) });
    embeds.push(e);
  }
  return embeds;
}

