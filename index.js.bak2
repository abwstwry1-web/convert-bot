// ═══════════════════════════════════════════
// 🧠 نظام المطابقة الذكية
// ═══════════════════════════════════════════

function levenshtein(a, b) {
  if (a.length === 0) return b.length;
  if (b.length === 0) return a.length;
  const matrix = [];
  for (let i = 0; i <= b.length; i++) matrix[i] = [i];
  for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
  for (let i = 1; i <= b.length; i++) {
    for (let j = 1; j <= a.length; j++) {
      if (b.charAt(i - 1) === a.charAt(j - 1)) {
        matrix[i][j] = matrix[i - 1][j - 1];
      } else {
        matrix[i][j] = Math.min(
          matrix[i - 1][j - 1] + 1,
          matrix[i][j - 1] + 1,
          matrix[i - 1][j] + 1
        );
      }
    }
  }
  return matrix[b.length][a.length];
}

function similarity(a, b) {
  const A = normName(a), B = normName(b);
  if (!A || !B) return 0;
  if (A === B) return 1;
  const maxLen = Math.max(A.length, B.length);
  return 1 - levenshtein(A, B) / maxLen;
}

// ترانسليتريشن عربي تقريبي
function transliterateArabic(str) {
  const map = {
    'ا': 'a', 'أ': 'a', 'إ': 'i', 'آ': 'aa', 'ب': 'b', 'ت': 't', 'ث': 'th',
    'ج': 'j', 'ح': 'h', 'خ': 'kh', 'د': 'd', 'ذ': 'dh', 'ر': 'r', 'ز': 'z',
    'س': 's', 'ش': 'sh', 'ص': 's', 'ض': 'd', 'ط': 't', 'ظ': 'dh', 'ع': 'a',
    'غ': 'gh', 'ف': 'f', 'ق': 'q', 'ك': 'k', 'ل': 'l', 'م': 'm', 'ن': 'n',
    'ه': 'h', 'و': 'w', 'ي': 'y', 'ى': 'a', 'ة': 'a', 'ء': 'a', 'ئ': 'y',
    'ؤ': 'w', 'ﻻ': 'la', 'لا': 'la',
  };
  return str.split('').map((c) => map[c] || c).join('').replace(/\s+/g, ' ').trim();
}

// كلمات مشتركة نتجاهلها
const STOPWORDS = new Set(["de", "da", "do", "van", "der", "den", "la", "le", "el", "al", "bin", "ibn", "ben", "the", "jr", "sr", "ii", "iii"]);

function normName(str) {
  if (!str) return "";
  let out = str.toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  // لو فيه عربي، نحوله
  if (/[\u0600-\u06FF]/.test(out)) {
    out = transliterateArabic(out);
  }
  out = out.replace(/[^a-z0-9 ]/g, " ")
    .replace(/\s+/g, " ").trim();
  // نشيل كلمات مشتركة
  const words = out.split(" ").filter((w) => !STOPWORDS.has(w));
  return words.join(" ");
}

function nameMatch(a, b) {
  const A = normName(a), B = normName(b);
  if (!A || !B) return false;
  if (A === B) return true;
  const sim = similarity(A, B);
  if (sim >= 0.75) return true;
  // كل كلمات a موجودة في b
  const aW = A.split(" ").filter((w) => w.length > 2);
  const bW = B.split(" ").filter((w) => w.length > 2);
  if (aW.length === 0 || bW.length === 0) return false;
  return aW.every((w) => B.includes(w)) || bW.every((w) => A.includes(w));
}

// ═══════════════════════════════════════════
// 🔍 نظام البحث عن اللاعبين (متعدد المصادر)
// ═══════════════════════════════════════════

function normName(str) {
  if (!str) return "";
  return str.toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9 ]/g, " ")
    .replace(/\s+/g, " ").trim();
}

function nameMatch(a, b) {
  const A = normName(a), B = normName(b);
  if (!A || !B) return false;
  if (A === B) return true;
  // نتحقق من كلمات الاسم
  const aW = A.split(" ").filter((w) => w.length > 2);
  const bW = B.split(" ").filter((w) => w.length > 2);
  if (aW.length === 0 || bW.length === 0) return false;
  // كل كلمات a موجودة في b أو العكس
  const allA = aW.every((w) => B.includes(w));
  const allB = bW.every((w) => A.includes(w));
  return allA || allB;
}

// ═══ المصدر 1: API-Football ═══
async function searchAPIFootballPlayer(playerName) {
  try {
    const key = process.env.FOOTBALL_API_KEY;
    if (!key) return null;
    const url = "https://v3.football.api-sports.io/players?search=" + encodeURIComponent(playerName);
    const r = await fetch(url, { headers: { "x-apisports-key": key } });
    const j = await r.json();
    if (!j.response || !j.response.length) return null;

    // نختار اللاعب الأقرب للاسم
    let best = null;
    let bestScore = 0;
    for (const item of j.response) {
      if (!item.player || !item.player.name) continue;
      const n = item.player.name;
      if (!nameMatch(n, playerName)) continue;
      // نفضل من عنده photo
      let score = 0;
      if (item.player.photo) score += 10;
      if (item.player.nationality) score += 3;
      if (item.player.age) score += 1;
      // نفضل نفس الاسم بالضبط
      if (normName(n) === normName(playerName)) score += 50;
      if (score > bestScore) { bestScore = score; best = item.player; }
    }
    if (!best || !best.photo) return null;
    return { url: best.photo, source: "apifootball", matchedName: best.name };
  } catch (e) {
    console.log("❌ APIFootball [" + playerName + "]: " + e.message);
    return null;
  }
}

// ═══ المصدر 2: TheSportsDB ═══
async function searchSportsDBPlayer(playerName) {
  try {
    const url = "https://www.thesportsdb.com/api/v1/json/3/searchplayers.php?p=" + encodeURIComponent(playerName);
    const r = await fetch(url);
    const j = await r.json();
    if (!j.player || !j.player.length) return null;

    let best = null;
    let bestScore = 0;
    for (const p of j.player) {
      if (!p.strPlayer) continue;
      if (!nameMatch(p.strPlayer, playerName)) continue;
      if (p.strSport && p.strSport.toLowerCase() !== "soccer") continue;
      // نفضل cutout
      let score = 0;
      if (p.strCutout) score += 30;
      else if (p.strRender) score += 15;
      else if (p.strThumb) score += 5;
      else continue;
      // مطابقة بالضبط
      if (normName(p.strPlayer) === normName(playerName)) score += 50;
      // نفس الجنسية (منتخب)
      if (score > bestScore) { bestScore = score; best = p; }
    }
    if (!best) return null;
    const imgUrl = best.strCutout || best.strRender || best.strThumb;
    if (!imgUrl) return null;
    return { url: imgUrl, source: "thesportsdb", matchedName: best.strPlayer, hasCutout: !!best.strCutout };
  } catch (e) {
    console.log("❌ SportsDB [" + playerName + "]: " + e.message);
    return null;
  }
}

// ═══ المصدر 3: Wikipedia ═══
async function searchWikipediaPlayer(playerName) {
  try {
    const query = encodeURIComponent(playerName + " footballer");
    const url = "https://en.wikipedia.org/w/api.php?action=query&format=json&prop=pageimages&pithumbsize=500&generator=search&gsrsearch=" + query + "&gsrlimit=5&redirects=1";
    const r = await fetch(url, { headers: { "User-Agent": "MRBOT/1.0" } });
    const j = await r.json();
    if (!j.query || !j.query.pages) return null;

    const pages = Object.values(j.query.pages);
    let best = null;
    for (const pg of pages) {
      if (!pg.title) continue;
      if (!pg.thumbnail || !pg.thumbnail.source) continue;
      // نتحقق من الاسم
      const titleClean = pg.title.replace(/\(.*?\)/g, "").trim();
      if (!nameMatch(titleClean, playerName)) continue;
      if (!best) best = pg;
      // نفضل الاسم الأقرب
      if (normName(titleClean) === normName(playerName)) { best = pg; break; }
    }
    if (!best) return null;
    return { url: best.thumbnail.source, source: "wikipedia", matchedName: best.title };
  } catch (e) {
    console.log("❌ Wikipedia [" + playerName + "]: " + e.message);
    return null;
  }
}

// ═══ المصدر 4: FotMob ═══
async function searchFotMobPlayer(playerName) {
  try {
    // FotMob search
    const url = "https://www.fotmob.com/api/searchapi/suggest?term=" + encodeURIComponent(playerName) + "&lang=en";
    const r = await fetch(url, { headers: { "User-Agent": "Mozilla/5.0" } });
    if (!r.ok) return null;
    const j = await r.json();
    if (!j || !j.suggestions) return null;
    for (const sug of j.suggestions) {
      if (sug.type !== "player") continue;
      const n = sug.name || "";
      if (!nameMatch(n, playerName)) continue;
      const id = sug.id;
      if (!id) continue;
      // نجيب معلومات اللاعب (فيها الصورة)
      const r2 = await fetch("https://www.fotmob.com/api/playerData?id=" + id, { headers: { "User-Agent": "Mozilla/5.0" } });
      if (!r2.ok) continue;
      const j2 = await r2.json();
      const img = j2?.player?.img || j2?.player?.imageUrl;
      if (img && img.startsWith("http")) {
        return { url: img, source: "fotmob", matchedName: n, hasCutout: false };
      }
    }
    return null;
  } catch (e) { console.log("❌ FotMob [" + playerName + "]: " + e.message); return null; }
}

// ═══ المصدر 5: Wikidata ═══
async function searchWikidataPlayer(playerName) {
  try {
    // نبحث بالاسم
    const searchUrl = "https://www.wikidata.org/w/api.php?action=wbsearchentities&format=json&language=en&limit=5&search=" + encodeURIComponent(playerName + " footballer");
    const r = await fetch(searchUrl, { headers: { "User-Agent": "MRBOT/1.0" } });
    const j = await r.json();
    if (!j.search || !j.search.length) return null;
    for (const item of j.search) {
      if (!item.label) continue;
      if (!nameMatch(item.label, playerName)) continue;
      const id = item.id;
      // نجيب claims + image
      const detailUrl = "https://www.wikidata.org/w/api.php?action=wbgetentities&format=json&props=claims&ids=" + id;
      const r2 = await fetch(detailUrl, { headers: { "User-Agent": "MRBOT/1.0" } });
      const j2 = await r2.json();
      const ent = j2.entities && j2.entities[id];
      if (!ent || !ent.claims || !ent.claims.P18) continue;
      const file = ent.claims.P18[0]?.mainsnak?.datavalue?.value;
      if (!file) continue;
      const clean = file.replace(/ /g, "_");
      const imgUrl = "https://commons.wikimedia.org/wiki/Special:FilePath/" + encodeURIComponent(clean) + "?width=500";
      return { url: imgUrl, source: "wikidata", matchedName: item.label, hasCutout: false };
    }
    return null;
  } catch (e) { console.log("❌ Wikidata [" + playerName + "]: " + e.message); return null; }
}

// ═══ المصدر 6: DuckDuckGo Images ═══
async function searchDuckDuckGoPlayer(playerName, teamHint) {
  try {
    const query = playerName + (teamHint ? " " + teamHint : "") + " footballer portrait";
    // نجيب vqd من DuckDuckGo
    const vqdUrl = "https://duckduckgo.com/?q=" + encodeURIComponent(query) + "&iax=images&ia=images";
    const r0 = await fetch(vqdUrl, { headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" } });
    const html0 = await r0.text();
    const vqdMatch = html0.match(/vqd=["']?([\d-]+)["']?/);
    if (!vqdMatch) return null;
    const vqd = vqdMatch[1];

    const apiUrl = "https://duckduckgo.com/i.js?l=us-en&o=json&q=" + encodeURIComponent(query) + "&vqd=" + vqd + "&f=,,,,,&p=1";
    const r = await fetch(apiUrl, {
      headers: {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "Referer": "https://duckduckgo.com/",
      },
    });
    if (!r.ok) return null;
    const j = await r.json();
    if (!j.results || !j.results.length) return null;
    // ناخذ أول نتيجة موقوقة
    for (const res of j.results.slice(0, 5)) {
      if (res.image && res.image.startsWith("http") && res.width >= 300) {
        return { url: res.image, source: "ddg", matchedName: playerName, hasCutout: false };
      }
    }
    return null;
  } catch (e) { console.log("❌ DDG [" + playerName + "]: " + e.message); return null; }
}

// ═══ المصدر 7: SofaScore ═══
async function searchSofaScorePlayer(playerName) {
  try {
    const url = "https://api.sofascore.com/api/v1/search/all?q=" + encodeURIComponent(playerName);
    const r = await fetch(url, { headers: { "User-Agent": "Mozilla/5.0" } });
    if (!r.ok) return null;
    const j = await r.json();
    if (!j.results || !j.results.length) return null;
    for (const item of j.results) {
      if (item.type !== "player") continue;
      const entity = item.entity || {};
      if (!entity.name || !entity.id) continue;
      if (!nameMatch(entity.name, playerName)) continue;
      // جيب الصورة
      const imgUrl = "https://api.sofascore.app/api/v1/player/" + entity.id + "/image";
      return { url: imgUrl, source: "sofascore", matchedName: entity.name, hasCutout: false };
    }
    return null;
  } catch (e) { console.log("❌ SofaScore [" + playerName + "]: " + e.message); return null; }
}

// ═══ معالجة الصور: شيل الخلفية البيضاء/الرمادية ═══
async function removeWhiteBg(imgBuffer) {
  try {
    const { createCanvas, loadImage } = require("@napi-rs/canvas");
    const img = await loadImage(imgBuffer);
    const canvas = createCanvas(img.width, img.height);
    const ctx = canvas.getContext("2d");
    ctx.drawImage(img, 0, 0);
    const imgData = ctx.getImageData(0, 0, img.width, img.height);
    const d = imgData.data;
    for (let i = 0; i < d.length; i += 4) {
      const r = d[i], g = d[i + 1], b = d[i + 2];
      // لو اللون قريب من الأبيض/الرمادي الفاتح → شفاف
      if (r > 235 && g > 235 && b > 235) {
        d[i + 3] = 0;
      }
      // قريب من الرمادي الفاتح
      const diff = Math.max(r, g, b) - Math.min(r, g, b);
      if (diff < 15 && r > 200) {
        d[i + 3] = Math.min(d[i + 3], 80);
      }
    }
    ctx.putImageData(imgData, 0, 0);
    return canvas.toBuffer("image/png");
  } catch (e) { return imgBuffer; }
}

// ═══════════════════════════════════════════════
// ⚽ جلب التشكيلات والأحداث الحية
// ═══════════════════════════════════════════════

async function apiFetch(path) {
  const key = process.env.FOOTBALL_API_KEY;
  if (!key) return null;
  try {
    const r = await fetch("https://v3.football.api-sports.io" + path, {
      headers: { "x-apisports-key": key },
    });
    const j = await r.json();
    if (j.errors && Object.keys(j.errors).length) {
      const errStr = JSON.stringify(j.errors).slice(0, 120);
      if (!errStr.includes("free") && !errStr.includes("subscription")) console.log("⚠️ API " + path + ": " + errStr);
      return null;
    }
    return j;
  } catch (e) {
    console.log("api err " + path + ": " + e.message);
    return null;
  }
}

async function fetchLineup(fixtureId) {
  const j = await apiFetch("/fixtures/lineups?fixture=" + fixtureId);
  return j ? j.response : null;
}

async function fetchLiveEvents(fixtureId) {
  const j = await apiFetch("/fixtures/events?fixture=" + fixtureId);
  return j && j.response ? j.response : [];
}

async function fetchFixtureInfo(fixtureId) {
  const j = await apiFetch("/fixtures?id=" + fixtureId);
  return j && j.response && j.response[0] ? j.response[0] : null;
}

// تنسيقات مساعدة
function pitchPos(grid, teamSide) {
  // grid like "1:1" = row:col
  if (!grid) return null;
  const parts = grid.split(":").map((x) => parseInt(x));
  if (parts.length < 2) return null;
  const row = parts[0], col = parts[1];
  return { row, col };
}

function jerseyColor(teamName) {
  const t = (teamName || "").toLowerCase();
  if (t.includes("china")) return { bg: "#c8102e", text: "#ffffff" };
  if (t.includes("iraq")) return { bg: "#ce1126", text: "#ffffff" };
  if (t.includes("saudi")) return { bg: "#006c35", text: "#ffffff" };
  if (t.includes("new zealand")) return { bg: "#000000", text: "#ffffff" };
  if (t.includes("argentina")) return { bg: "#75aadb", text: "#000000" };
  if (t.includes("brazil")) return { bg: "#fedf00", text: "#009c3b" };
  if (t.includes("france")) return { bg: "#0055a4", text: "#ffffff" };
  if (t.includes("germany")) return { bg: "#000000", text: "#ffffff" };
  if (t.includes("spain")) return { bg: "#c60b1e", text: "#ffc400" };
  if (t.includes("italy")) return { bg: "#0066cc", text: "#ffffff" };
  if (t.includes("england")) return { bg: "#ffffff", text: "#cf142b" };
  if (t.includes("portugal")) return { bg: "#006600", text: "#ff0000" };
  if (t.includes("netherlands")) return { bg: "#f36c21", text: "#000000" };
  if (t.includes("mexico")) return { bg: "#006341", text: "#ffffff" };
  if (t.includes("usa") || t.includes("united states")) return { bg: "#002868", text: "#ffffff" };
  if (t.includes("japan")) return { bg: "#0b0f6a", text: "#ffffff" };
  if (t.includes("south korea")) return { bg: "#cd2e3a", text: "#ffffff" };
  return { bg: "#5865f2", text: "#ffffff" };
}

// ═══ الدالة الرئيسية: 8 مصادر ═══
async function findPlayerImage(playerName, teamHint) {
  if (!playerName && !teamHint) return null;

  // ═══ المصدر الجديد الأول: التشكيلة الكاملة ═══
  if (teamHint) {
    try {
      const squadResult = await findPlayerFromSquad(teamHint);
      if (squadResult) {
        console.log("🏆 تشكيلة: " + teamHint + " → " + squadResult.name);
        return { url: squadResult.imgUrl, source: "squad_auto", matchedName: squadResult.name, hasCutout: squadResult.hasCutout };
      }
    } catch (e) { console.log("squad lookup err:", e.message); }
  }

  if (!playerName) return null;

  // APIFootball
  const r1 = await searchAPIFootballPlayer(playerName);
  if (r1) return r1;

  // 5 مصادر متوازية
  const results = await Promise.all([
    searchSportsDBPlayer(playerName).catch(() => null),
    searchWikipediaPlayer(playerName).catch(() => null),
    searchFotMobPlayer(playerName).catch(() => null),
    searchWikidataPlayer(playerName).catch(() => null),
    searchSofaScorePlayer(playerName).catch(() => null),
  ]);

  const valid = results.filter((r) => r && r.url);
  const scored = valid.map((r) => {
    let score = 0;
    if (r.hasCutout) score += 100;
    if (r.source === "thesportsdb") score += 50;
    if (r.source === "apifootball") score += 60;
    if (r.source === "fotmob") score += 40;
    if (r.source === "sofascore") score += 35;
    if (r.source === "wikidata") score += 25;
    if (r.source === "wikipedia") score += 20;
    score += similarity(r.matchedName, playerName) * 30;
    return { ...r, score };
  }).sort((a, b) => b.score - a.score);

  if (scored.length) return scored[0];

  // DDG احتياط
  const ddg = await searchDuckDuckGoPlayer(playerName, teamHint);
  if (ddg) return ddg;

  return null;
}

async function fetchPlayerImage(playerName, teamHint) {
  const keyForCache = playerName || teamHint;
  if (!keyForCache) return null;
  const safeName = keyForCache.replace(/[^a-zA-Z0-9]/g, "_");
  const cacheImg = require("path").join(PLAYER_CACHE_DIR, safeName + ".png");
  const cacheMeta = require("path").join(PLAYER_CACHE_DIR, safeName + ".json");

  // كاش
  if (fs.existsSync(cacheImg) && fs.statSync(cacheImg).size > 1000) {
    try {
      const meta = fs.existsSync(cacheMeta) ? JSON.parse(fs.readFileSync(cacheMeta, "utf8")) : {};
      console.log("📦 كاش: " + playerName + " (" + (meta.source || "?") + ")");
      return await loadImage(fs.readFileSync(cacheImg));
    } catch {}
  }

  // نبحث بالمصادر المتعددة
  const result = await findPlayerImage(playerName, teamHint);
  if (!result || !result.url) {
    console.log("❌ ما لكيت صورة: " + playerName);
    return null;
  }

  try {
    const r = await fetch(result.url, { headers: { "User-Agent": "MRBOT/1.0" } });
    if (!r.ok) { console.log("❌ فشل تحميل: " + playerName); return null; }
    let buf = Buffer.from(await r.arrayBuffer());
    if (buf.length < 2000) { console.log("⚠️ صورة صغيرة: " + playerName); return null; }
    // إذا مو cutout، نحاول نشيل الخلفية
    if (!result.hasCutout) {
      try {
        const processed = await removeWhiteBg(buf);
        if (processed && processed.length > 1000) buf = processed;
      } catch {}
    }
    fs.writeFileSync(cacheImg, buf);
    fs.writeFileSync(cacheMeta, JSON.stringify({
      source: result.source,
      matchedName: result.matchedName,
      originalName: playerName || teamHint,
      hasCutout: result.hasCutout || false,
      size: buf.length,
      date: Date.now(),
    }));
    // نحفظ meta للفريق أيضاً
    if (teamHint) {
      const teamKey = teamHint.replace(/[^a-zA-Z0-9]/g, "_");
      const teamMetaPath = require("path").join(SQUAD_CACHE_DIR, "squad_meta_" + teamKey + ".json");
      fs.writeFileSync(teamMetaPath, JSON.stringify({ name: result.matchedName, source: result.source, date: Date.now() }));
    }
    console.log("✅ " + playerName + " → " + result.matchedName + " (" + result.source + ")");
    return await loadImage(buf);
  } catch (e) {
    console.log("❌ تحميل " + playerName + ": " + e.message);
    return null;
  }
}

// ═══════════════════════════════════════════════
// 🎨 رسم التشكيلة (ملعب + لاعبين + أحداث)
// ═══════════════════════════════════════════════

async function generateLineupCard(m, fixtureId) {
  const W = 1600, H = 1200;
  const canvas = createCanvas(W, H);
  const ctx = canvas.getContext("2d");

  // ═══ الخلفية ═══
  const bg = ctx.createLinearGradient(0, 0, 0, H);
  bg.addColorStop(0, "#0a0e27");
  bg.addColorStop(1, "#050816");
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // ═══ الملعب ═══
  const pitchX = 80, pitchY = 180, pitchW = W - 160, pitchH = H - 300;
  const pg = ctx.createLinearGradient(0, pitchY, 0, pitchY + pitchH);
  pg.addColorStop(0, "#0d5c2e");
  pg.addColorStop(0.5, "#0e6b35");
  pg.addColorStop(1, "#0d5c2e");
  ctx.fillStyle = pg;
  roundRect(ctx, pitchX, pitchY, pitchW, pitchH, 25);
  ctx.fill();

  // خطوط الملعب
  ctx.strokeStyle = "rgba(255, 255, 255, 0.35)";
  ctx.lineWidth = 3;
  ctx.strokeRect(pitchX, pitchY, pitchW, pitchH);

  // خط المنتصف
  ctx.beginPath();
  ctx.moveTo(pitchX + pitchW / 2, pitchY);
  ctx.lineTo(pitchX + pitchW / 2, pitchY + pitchH);
  ctx.stroke();

  // دائرة المنتصف
  ctx.beginPath();
  ctx.arc(pitchX + pitchW / 2, pitchY + pitchH / 2, 90, 0, Math.PI * 2);
  ctx.stroke();

  // منطقة الجزاء العلوية
  ctx.strokeRect(pitchX + pitchW / 2 - 250, pitchY, 500, 130);
  ctx.strokeRect(pitchX + pitchW / 2 - 130, pitchY, 260, 55);
  // منطقة الجزاء السفلية
  ctx.strokeRect(pitchX + pitchW / 2 - 250, pitchY + pitchH - 130, 500, 130);
  ctx.strokeRect(pitchX + pitchW / 2 - 130, pitchY + pitchH - 55, 260, 55);

  // ═══ جلب البيانات ═══
  const [lineup, events, info] = await Promise.all([
    fetchLineup(fixtureId),
    fetchLiveEvents(fixtureId),
    fetchFixtureInfo(fixtureId),
  ]);

  const homeScore = info?.goals?.home ?? 0;
  const awayScore = info?.goals?.away ?? 0;
  const minute = info?.fixture?.status?.elapsed ?? 0;
  const status = info?.fixture?.status?.short ?? "NS";

  // ═══ الهيدر (نتيجة حية) ═══
  ctx.fillStyle = "rgba(20, 25, 50, 0.9)";
  roundRect(ctx, W / 2 - 350, 30, 700, 130, 25);
  ctx.fill();
  ctx.strokeStyle = "rgba(120, 160, 255, 0.6)";
  ctx.lineWidth = 3;
  roundRect(ctx, W / 2 - 350, 30, 700, 130, 25);
  ctx.stroke();

  // الأعلام
  const f1 = await loadImageFromUrl(m.logo1).catch(() => null);
  const f2 = await loadImageFromUrl(m.logo2).catch(() => null);
  if (f1) ctx.drawImage(f1, W / 2 - 320, 55, 80, 80);
  if (f2) ctx.drawImage(f2, W / 2 + 240, 55, 80, 80);

  // النتيجة
  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 70px LatinFont, ArabicFont, sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText(homeScore + " - " + awayScore, W / 2, 95);

  // الدقيقة
  ctx.font = "bold 24px LatinFont, ArabicFont, sans-serif";
  ctx.fillStyle = "rgba(180, 200, 255, 0.9)";
  const statusTxt = status === "FT" ? "انتهت" : status === "HT" ? "استراحة" : status === "1H" || status === "2H" ? minute + "'" : "قريباً";
  ctx.fillText(statusTxt, W / 2, 140);

  // أسماء الفرق
  ctx.font = "bold 22px LatinFont, ArabicFont, sans-serif";
  ctx.fillStyle = "#ffffff";
  ctx.textAlign = "left";
  ctx.fillText(m.team1.slice(0, 20), W / 2 - 230, 95);
  ctx.textAlign = "right";
  ctx.fillText(m.team2.slice(0, 20), W / 2 + 230, 95);

  // ═══ رسم اللاعبين ═══
  function drawTeamPlayers(teamLineup, side) {
    if (!teamLineup || !teamLineup.startXI) return;
    const side_ = side === "home" ? 1 : -1; // 1 = فوق، -1 = تحت
    const colors = jerseyColor(teamLineup.team?.name || "");

    // نجمع حسب الصفوف
    const rows = {};
    for (const p of teamLineup.startXI) {
      const grid = p.player?.grid;
      if (!grid) continue;
      const parts = grid.split(":");
      const row = parseInt(parts[0]);
      const col = parseInt(parts[1]);
      if (isNaN(row) || isNaN(col)) continue;
      if (!rows[row]) rows[row] = [];
      rows[row].push({ ...p.player, _col: col, _row: row });
    }

    const rowKeys = Object.keys(rows).map(Number).sort((a, b) => a - b);
    const maxRow = rowKeys.length ? Math.max(...rowKeys) : 4;

    const fieldTop = pitchY + 60;
    const fieldBot = pitchY + pitchH - 60;
    const fieldH = fieldBot - fieldTop;

    for (const rk of rowKeys) {
      const players = rows[rk].sort((a, b) => a._col - b._col);
      const n = players.length;

      // موقع الصف
      let yPos;
      if (side === "home") {
        // فريق فوق: يبدأ من الأعلى
        const fraction = rk === 1 ? 0.06 : (rk - 1) / (maxRow - 1) * 0.42 + 0.06;
        yPos = fieldTop + fieldH * fraction;
      } else {
        // فريق تحت: يبدأ من الأسفل
        const fraction = rk === 1 ? 0.94 : 1 - ((rk - 1) / (maxRow - 1) * 0.42 + 0.06);
        yPos = fieldTop + fieldH * fraction;
      }

      for (let i = 0; i < n; i++) {
        const p = players[i];
        const xFrac = (i + 1) / (n + 1);
        const xPos = pitchX + pitchW * xFrac;

        // دائرة اللاعب
        const circleR = 26;
        ctx.fillStyle = colors.bg;
        ctx.beginPath();
        ctx.arc(xPos, yPos, circleR, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "rgba(255, 255, 255, 0.9)";
        ctx.lineWidth = 2.5;
        ctx.stroke();

        // الرقم
        ctx.fillStyle = colors.text;
        ctx.font = "bold 24px LatinFont, ArabicFont, sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(p.number || "?", xPos, yPos + 1);

        // الاسم
        ctx.fillStyle = "rgba(255, 255, 255, 0.95)";
        ctx.font = "bold 14px LatinFont, ArabicFont, sans-serif";
        const fullName = p.name || "";
        const lastName = fullName.split(" ").slice(-1)[0] || fullName;
        ctx.fillText(lastName.slice(0, 12), xPos, yPos + circleR + 15);

        // ═══ الأحداث فوق الرأس ═══
        if (events && events.length) {
          const myEvents = events.filter((e) => e.player && (e.player.id == p.id || (e.player.name && nameMatch(e.player.name, p.name))));
          let offsetY = -circleR - 15;
          for (const ev of myEvents) {
            const type = ev.type || "";
            const detail = ev.detail || "";
            let icon = "";
            if (type === "Goal") icon = "⚽";
            else if (type === "Card" && detail === "Yellow Card") icon = "🟨";
            else if (type === "Card" && detail === "Red Card") icon = "🟥";
            else if (type === "subst") icon = "🔁";

            if (icon) {
              ctx.font = "28px sans-serif";
              ctx.fillText(icon, xPos, offsetY);
              offsetY -= 32;
            }
          }
        }
      }
    }
  }

  if (lineup && lineup.length >= 2) {
    drawTeamPlayers(lineup[0], "home");
    drawTeamPlayers(lineup[1], "away");
  } else {
    // ماكو تشكيلة — نعرض رسالة
    ctx.fillStyle = "rgba(255, 255, 255, 0.7)";
    ctx.font = "bold 40px LatinFont, ArabicFont, sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("⏳ التشكيلة ما نزلت بعد", W / 2, pitchY + pitchH / 2);
    ctx.font = "bold 24px LatinFont, ArabicFont, sans-serif";
    ctx.fillStyle = "rgba(180, 200, 255, 0.7)";
    ctx.fillText("التشكيلة تظهر عادة قبل المباراة بساعة", W / 2, pitchY + pitchH / 2 + 50);
  }

  // ═══ الفوتر ═══
  ctx.fillStyle = "rgba(120, 130, 180, 0.5)";
  ctx.font = "bold 18px LatinFont, ArabicFont, sans-serif";
  ctx.textAlign = "center";
  ctx.fillText("MRBOT Live • " + (m.league || ""), W / 2, H - 40);

  return canvas.toBuffer("image/png");
}

async function generateMatchCard(m) {
  const W = 1400, H = 750;
  const canvas = createCanvas(W, H);
  const ctx = canvas.getContext("2d");

  // نجيب أشهر لاعب لكل منتخب
  const p1Name = getFamousPlayer(m.team1);
  const p2Name = getFamousPlayer(m.team2);
  // نجرب: أولاً التشكيلة الكاملة، وإذا فشلت نستخدم الاسم
  const [player1Img, player2Img] = await Promise.all([
    fetchPlayerImage(p1Name, m.team1).catch(() => null),
    fetchPlayerImage(p2Name, m.team2).catch(() => null),
  ]);

  // ═══════════ الخلفية ═══════════
  // تدرج أساسي
  const bg = ctx.createLinearGradient(0, 0, 0, H);
  bg.addColorStop(0, "#050816");
  bg.addColorStop(0.4, "#0a0f2c");
  bg.addColorStop(0.6, "#0a0f2c");
  bg.addColorStop(1, "#050816");
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // شبكة خفيفة
  ctx.strokeStyle = "rgba(80, 110, 255, 0.04)";
  ctx.lineWidth = 1;
  for (let x = 0; x < W; x += 50) {
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
  }
  for (let y = 0; y < H; y += 50) {
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
  }

  // توهج زرق يسار
  const glowL = ctx.createRadialGradient(300, 400, 50, 300, 400, 500);
  glowL.addColorStop(0, "rgba(60, 90, 255, 0.5)");
  glowL.addColorStop(0.5, "rgba(60, 90, 255, 0.12)");
  glowL.addColorStop(1, "rgba(0, 0, 0, 0)");
  ctx.fillStyle = glowL;
  ctx.fillRect(0, 0, W / 2 + 200, H);

  // توهج وردي يمين
  const glowR = ctx.createRadialGradient(W - 300, 400, 50, W - 300, 400, 500);
  glowR.addColorStop(0, "rgba(235, 40, 130, 0.5)");
  glowR.addColorStop(0.5, "rgba(235, 40, 130, 0.12)");
  glowR.addColorStop(1, "rgba(0, 0, 0, 0)");
  ctx.fillStyle = glowR;
  ctx.fillRect(W / 2 - 200, 0, W / 2 + 200, H);

  // شريط علوي متوهج
  const topBar = ctx.createLinearGradient(0, 0, W, 0);
  topBar.addColorStop(0, "rgba(88, 101, 242, 0)");
  topBar.addColorStop(0.3, "rgba(88, 150, 255, 1)");
  topBar.addColorStop(0.5, "rgba(180, 200, 255, 1)");
  topBar.addColorStop(0.7, "rgba(235, 40, 130, 1)");
  topBar.addColorStop(1, "rgba(235, 40, 130, 0)");
  ctx.fillStyle = topBar;
  ctx.fillRect(0, 0, W, 4);
  ctx.fillRect(0, H - 4, W, 4);

  // ═══════════ رسم صور اللاعبين (Cutouts شفافة) ═══════════
  ctx.save();
  ctx.globalAlpha = 0.22;
  if (player1Img) {
    const pH = 500;
    const pW = (player1Img.width / player1Img.height) * pH;
    ctx.drawImage(player1Img, 20, H - pH, pW, pH);
  }
  if (player2Img) {
    const pH = 500;
    const pW = (player2Img.width / player2Img.height) * pH;
    ctx.drawImage(player2Img, W - pW - 20, H - pH, pW, pH);
  }
  ctx.restore();

  // ═══════════ الشعارات ═══════════
  const [img1, img2] = await Promise.all([
    loadImageFromUrl(m.logo1),
    loadImageFromUrl(m.logo2),
  ]);

  const cx1 = 260;
  const cx2 = W - 260;
  const cy = H / 2 + 20;
  const hexR = 130;

  // رسم سداسي
  function drawHex(cx, cy, r) {
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const ang = (Math.PI / 3) * i - Math.PI / 6;
      const x = cx + r * Math.cos(ang);
      const y = cy + r * Math.sin(ang);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.closePath();
  }

  // ═══ الفريق الأول ═══
  // هالة خارجية
  const halo1 = ctx.createRadialGradient(cx1, cy, hexR - 20, cx1, cy, hexR + 80);
  halo1.addColorStop(0, "rgba(80, 130, 255, 0.6)");
  halo1.addColorStop(1, "rgba(80, 130, 255, 0)");
  ctx.fillStyle = halo1;
  ctx.beginPath();
  ctx.arc(cx1, cy, hexR + 80, 0, Math.PI * 2);
  ctx.fill();

  // سداسي الخارجي
  ctx.save();
  drawHex(cx1, cy, hexR + 15);
  ctx.fillStyle = "rgba(20, 30, 70, 0.85)";
  ctx.fill();
  ctx.strokeStyle = "rgba(100, 150, 255, 0.9)";
  ctx.lineWidth = 4;
  ctx.stroke();
  ctx.restore();

  // سداسي داخلي
  ctx.save();
  drawHex(cx1, cy, hexR);
  ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
  ctx.fill();
  ctx.strokeStyle = "rgba(150, 190, 255, 0.5)";
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.clip();

  if (img1) {
    const pad = 30;
    const maxW = (hexR - pad) * 2;
    const maxH = (hexR - pad) * 2;
    const ratio = Math.min(maxW / img1.width, maxH / img1.height);
    const dw = img1.width * ratio;
    const dh = img1.height * ratio;
    ctx.drawImage(img1, cx1 - dw / 2, cy - dh / 2, dw, dh);
  }
  ctx.restore();

  // ═══ الفريق الثاني ═══
  const halo2 = ctx.createRadialGradient(cx2, cy, hexR - 20, cx2, cy, hexR + 80);
  halo2.addColorStop(0, "rgba(235, 50, 140, 0.6)");
  halo2.addColorStop(1, "rgba(235, 50, 140, 0)");
  ctx.fillStyle = halo2;
  ctx.beginPath();
  ctx.arc(cx2, cy, hexR + 80, 0, Math.PI * 2);
  ctx.fill();

  ctx.save();
  drawHex(cx2, cy, hexR + 15);
  ctx.fillStyle = "rgba(70, 20, 50, 0.85)";
  ctx.fill();
  ctx.strokeStyle = "rgba(235, 70, 150, 0.9)";
  ctx.lineWidth = 4;
  ctx.stroke();
  ctx.restore();

  ctx.save();
  drawHex(cx2, cy, hexR);
  ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
  ctx.fill();
  ctx.strokeStyle = "rgba(255, 120, 190, 0.5)";
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.clip();

  if (img2) {
    const pad = 30;
    const maxW = (hexR - pad) * 2;
    const maxH = (hexR - pad) * 2;
    const ratio = Math.min(maxW / img2.width, maxH / img2.height);
    const dw = img2.width * ratio;
    const dh = img2.height * ratio;
    ctx.drawImage(img2, cx2 - dw / 2, cy - dh / 2, dw, dh);
  }
  ctx.restore();

  // ═══════════ أسماء الفرق ═══════════
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";

  const nameY = cy + hexR + 70;

  // اسم 1
  ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
  ctx.font = AR;
  fitFont(ctx, m.team1, 460, 42);
  const tw1 = ctx.measureText(m.team1).width;
  roundRect(ctx, cx1 - tw1 / 2 - 25, nameY - 30, tw1 + 50, 60, 15);
  ctx.fill();
  ctx.strokeStyle = "rgba(100, 150, 255, 0.7)";
  ctx.lineWidth = 2;
  roundRect(ctx, cx1 - tw1 / 2 - 25, nameY - 30, tw1 + 50, 60, 15);
  ctx.stroke();

  ctx.fillStyle = "#ffffff";
  ctx.shadowColor = "rgba(100, 150, 255, 0.9)";
  ctx.shadowBlur = 15;
  ctx.fillText(m.team1, cx1, nameY);
  ctx.shadowBlur = 0;

  // اسم اللاعب الفعلي (من cache)
  let realP1Name = p1Name;
  try {
    const cacheKey = p1Name ? p1Name.replace(/[^a-zA-Z0-9]/g, "_") : null;
    const metaPath = cacheKey ? require("path").join(PLAYER_CACHE_DIR, cacheKey + ".json") : null;
    if (metaPath && fs.existsSync(metaPath)) {
      const meta = JSON.parse(fs.readFileSync(metaPath, "utf8"));
      if (meta.matchedName) realP1Name = meta.matchedName;
    }
    if (!realP1Name) {
      const autoKey = m.team1.replace(/[^a-zA-Z0-9]/g, "_");
      const autoPath = require("path").join(SQUAD_CACHE_DIR, "squad_meta_" + autoKey + ".json");
      if (fs.existsSync(autoPath)) {
        const meta = JSON.parse(fs.readFileSync(autoPath, "utf8"));
        if (meta.name) realP1Name = meta.name;
      }
    }
  } catch {}
  if (realP1Name) {
    ctx.font = "bold 20px LatinFont, ArabicFont, sans-serif";
    ctx.fillStyle = "rgba(180, 200, 255, 0.9)";
    ctx.fillText("⭐ " + realP1Name, cx1, nameY + 42);
  }

  // اسم 2
  ctx.font = AR;
  fitFont(ctx, m.team2, 460, 42);
  const tw2 = ctx.measureText(m.team2).width;

  ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
  roundRect(ctx, cx2 - tw2 / 2 - 25, nameY - 30, tw2 + 50, 60, 15);
  ctx.fill();
  ctx.strokeStyle = "rgba(235, 70, 150, 0.7)";
  ctx.lineWidth = 2;
  roundRect(ctx, cx2 - tw2 / 2 - 25, nameY - 30, tw2 + 50, 60, 15);
  ctx.stroke();

  ctx.fillStyle = "#ffffff";
  ctx.shadowColor = "rgba(235, 70, 150, 0.9)";
  ctx.shadowBlur = 15;
  ctx.fillText(m.team2, cx2, nameY);
  ctx.shadowBlur = 0;

  // اسم اللاعب الثاني
  let realP2Name = p2Name;
  try {
    const cacheKey = p2Name ? p2Name.replace(/[^a-zA-Z0-9]/g, "_") : null;
    const metaPath = cacheKey ? require("path").join(PLAYER_CACHE_DIR, cacheKey + ".json") : null;
    if (metaPath && fs.existsSync(metaPath)) {
      const meta = JSON.parse(fs.readFileSync(metaPath, "utf8"));
      if (meta.matchedName) realP2Name = meta.matchedName;
    }
    if (!realP2Name) {
      const autoKey = m.team2.replace(/[^a-zA-Z0-9]/g, "_");
      const autoPath = require("path").join(SQUAD_CACHE_DIR, "squad_meta_" + autoKey + ".json");
      if (fs.existsSync(autoPath)) {
        const meta = JSON.parse(fs.readFileSync(autoPath, "utf8"));
        if (meta.name) realP2Name = meta.name;
      }
    }
  } catch {}
  if (realP2Name) {
    ctx.font = "bold 20px LatinFont, ArabicFont, sans-serif";
    ctx.fillStyle = "rgba(255, 200, 230, 0.9)";
    ctx.fillText("⭐ " + realP2Name, cx2, nameY + 42);
  }

  // ═══════════ VS في الوسط ═══════════
  ctx.save();
  // خلفية VS
  const vsGrad = ctx.createRadialGradient(W / 2, cy - 30, 20, W / 2, cy - 30, 140);
  vsGrad.addColorStop(0, "rgba(88, 101, 242, 0.4)");
  vsGrad.addColorStop(1, "rgba(88, 101, 242, 0)");
  ctx.fillStyle = vsGrad;
  ctx.beginPath();
  ctx.arc(W / 2, cy - 30, 140, 0, Math.PI * 2);
  ctx.fill();

  // دائرة VS
  ctx.beginPath();
  ctx.arc(W / 2, cy - 30, 75, 0, Math.PI * 2);
  const vsCircleGrad = ctx.createLinearGradient(W / 2 - 75, cy - 105, W / 2 + 75, cy + 45);
  vsCircleGrad.addColorStop(0, "rgba(80, 120, 255, 0.3)");
  vsCircleGrad.addColorStop(1, "rgba(235, 50, 140, 0.3)");
  ctx.fillStyle = vsCircleGrad;
  ctx.fill();
  ctx.strokeStyle = "rgba(255, 255, 255, 0.35)";
  ctx.lineWidth = 3;
  ctx.stroke();

  // نص VS
  const vsTextGrad = ctx.createLinearGradient(W / 2 - 60, cy - 90, W / 2 + 60, cy + 30);
  vsTextGrad.addColorStop(0, "#7ca5ff");
  vsTextGrad.addColorStop(0.5, "#ffffff");
  vsTextGrad.addColorStop(1, "#ff64a8");

  ctx.font = AR;
  ctx.textBaseline = "middle";
  ctx.textAlign = "center";
  ctx.fillStyle = vsTextGrad;
  ctx.shadowColor = "rgba(120, 160, 255, 0.9)";
  ctx.shadowBlur = 25;
  ctx.fillText("VS", W / 2, cy - 30);
  ctx.shadowBlur = 0;
  ctx.restore();

  // ═══════════ الوقت والتاريخ ═══════════
  const iraq = new Date(m.startTime + 3 * 3600 * 1000);
  const dayNames = ["الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"];
  const monthNames = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
  const dayName = dayNames[iraq.getUTCDay()];
  const monthName = monthNames[iraq.getUTCMonth()];
  const dayNum = iraq.getUTCDate();
  const year = iraq.getUTCFullYear();
  const hour = iraq.getUTCHours();
  const min = String(iraq.getUTCMinutes()).padStart(2, "0");
  const ampm = hour >= 12 ? "م" : "ص";
  const h12 = hour % 12 || 12;

  // ═══ الوقت ═══
  const timeY = cy + 130;
  ctx.save();

  // خلفية الوقت (زجاج)
  ctx.shadowColor = "rgba(88, 101, 242, 0.6)";
  ctx.shadowBlur = 30;

  ctx.fillStyle = "rgba(15, 20, 50, 0.85)";
  roundRect(ctx, W / 2 - 240, timeY - 55, 480, 110, 25);
  ctx.fill();

  ctx.shadowBlur = 0;
  ctx.strokeStyle = "rgba(120, 160, 255, 0.5)";
  ctx.lineWidth = 2;
  roundRect(ctx, W / 2 - 240, timeY - 55, 480, 110, 25);
  ctx.stroke();

  // التاريخ داخل الوقت
  ctx.fillStyle = "rgba(160, 180, 255, 0.9)";
  ctx.font = AR;
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText(dayName + " " + dayNum + " " + monthName + " " + year, W / 2, timeY - 25);

  // الساعة
  ctx.fillStyle = "#ffffff";
  ctx.font = AR;
  ctx.shadowColor = "rgba(120, 160, 255, 0.8)";
  ctx.shadowBlur = 20;
  ctx.fillText(h12 + ":" + min + " " + ampm, W / 2, timeY + 25);
  ctx.shadowBlur = 0;
  ctx.restore();

  // ═══════════ اسم الدوري (أعلى) ═══════════
  if (m.league) {
    const lgTxt = m.league;
    ctx.font = AR;
    const tw = ctx.measureText(lgTxt).width;
    const pillW = tw + 90;
    const pillX = W / 2 - pillW / 2;
    const pillY = 45;

    // توهج
    ctx.shadowColor = "rgba(88, 101, 242, 0.6)";
    ctx.shadowBlur = 20;

    const pillGrad = ctx.createLinearGradient(pillX, 0, pillX + pillW, 0);
    pillGrad.addColorStop(0, "rgba(80, 130, 255, 0.5)");
    pillGrad.addColorStop(0.5, "rgba(120, 100, 255, 0.6)");
    pillGrad.addColorStop(1, "rgba(235, 50, 140, 0.5)");
    ctx.fillStyle = pillGrad;
    roundRect(ctx, pillX, pillY, pillW, 55, 28);
    ctx.fill();

    ctx.shadowBlur = 0;
    ctx.strokeStyle = "rgba(180, 200, 255, 0.7)";
    ctx.lineWidth = 2;
    roundRect(ctx, pillX, pillY, pillW, 55, 28);
    ctx.stroke();

    ctx.fillStyle = "#ffffff";
    ctx.font = AR;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText("🏆  " + lgTxt, W / 2, pillY + 28);
  }

  // ═══════════ عدد المتوقعين ═══════════
  const predsCount = Object.keys(m.predictions || {}).length;
  ctx.textAlign = "center";
  ctx.fillStyle = "rgba(180, 200, 255, 0.85)";
  ctx.font = AR;
  ctx.fillText("🎯 المتوقعين: " + predsCount, W / 2, H - 60);

  // ═══════════ MRBOT ═══════════
  ctx.fillStyle = "rgba(140, 160, 220, 0.45)";
  ctx.font = AR;
  ctx.fillText("MRBOT • 2026", W / 2, H - 25);

  return canvas.toBuffer("image/png");
}

