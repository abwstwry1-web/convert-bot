async function fetchFixturesFromApi() {
  const key = process.env.FOOTBALL_API_KEY;
  if (!key) { console.log("❌ ماكو FOOTBALL_API_KEY"); return []; }
  const all = [];
  const seenIds = new Set();

  // نجيب اليوم + باجر بس (حدود الخطة المجانية)
  const today = new Date();
  for (let i = 0; i < 2; i++) {
    const d = new Date(today);
    d.setDate(d.getDate() + i);
    const dateStr = d.toISOString().slice(0, 10);
    try {
      const r = await fetch("https://v3.football.api-sports.io/fixtures?date=" + dateStr, {
        headers: { "x-apisports-key": key },
      });
      const txt = await r.text();
      let j;
      try { j = JSON.parse(txt); } catch (e) {
        console.log("❌ رد غير JSON [" + dateStr + "]: " + txt.slice(0, 120));
        continue;
      }
      if (j.errors && Object.keys(j.errors).length) {
        console.log("❌ API error [" + dateStr + "]: " + JSON.stringify(j.errors).slice(0, 200));
        continue;
      }
      if (j.results) console.log("📅 " + dateStr + ": " + j.results + " مباريات");
      if (j.response && Array.isArray(j.response)) {
        for (const f of j.response) {
          if (!f || !f.fixture || !f.fixture.id) continue;
          if (seenIds.has(f.fixture.id)) continue;
          seenIds.add(f.fixture.id);
          all.push(f);
        }
      }
    } catch (e) { console.log("fetch " + dateStr + " err: " + e.message); }
    await new Promise((r) => setTimeout(r, 600));
  }

  const now = Date.now();
  const twoHours = 2 * 3600 * 1000;
  const inWindow = (f) => {
    const t = new Date(f.fixture.date).getTime();
    return t > now + twoHours && t < now + 48 * 3600 * 1000;
  };

  // ═══ الفلتر: منتخبات وطنية فقط ═══
  // 1) نتأكد إن الاتحاد الدولي (league.id في القائمة)
  // 2) نتأكد إن الفريقين عندهم علم دولة
  const filtered = all.filter((f) => {
    if (!f.league || !f.teams || !f.teams.home || !f.teams.away) return false;
    if (!NATIONAL_LEAGUES.has(f.league.id)) return false;
    if (!inWindow(f)) return false;
    return true;
  });

  console.log("🌍 مباريات منتخبات وطنية: " + filtered.length + " من " + all.length);

  // نسجل البطولات
  const leagues = {};
  for (const f of filtered) {
    const k = f.league.name + " (" + (f.league.country || "World") + ")";
    leagues[k] = (leagues[k] || 0) + 1;
  }
  const top = Object.entries(leagues).sort((a, b) => b[1] - a[1]);
  if (top.length) {
    console.log("📊 البطولات:");
    for (const [n, c] of top.slice(0, 10)) console.log("   • " + n + " → " + c);
  } else {
    console.log("ℹ️ ماكو مباريات منتخبات حالياً باليوم/باجر");
  }

  return filtered;
}

function parseApiFixtures(fixtures) {
  const out = [];
  for (const f of fixtures) {
    try {
      const startTime = new Date(f.fixture.date).getTime();
      if (startTime < Date.now() - 3600000) continue; // نتجاهل اللي بدأت
      out.push({
        id: "auto_" + f.fixture.id,
        fixtureId: f.fixture.id,
        team1: f.teams.home.name,
        team2: f.teams.away.name,
        logo1: f.teams.home.logo,
        logo2: f.teams.away.logo,
        league: f.league.name,
        leagueLogo: f.league.logo,
        startTime,
        channelId: autoData.channelId,
        sentAt: null,
        messageId: null,
        closed: false,
        predictions: {},
        source: "auto",
      });
    } catch (e) {}
  }
  return out;
}

async function refreshAutoMatches(force) {
  const now = Date.now();
  // نحدث كل 6 ساعات
  if (!force && autoData.lastFetch && now - autoData.lastFetch < 6 * 3600 * 1000) {
    console.log("⏭️ آخر تحديث قبل " + Math.round((now - autoData.lastFetch) / 60000) + " دقيقة");
    return 0;
  }
  console.log("🔄 جاري تحديث المباريات من API...");
  const fixtures = await fetchFixturesFromApi();
  const parsed = parseApiFixtures(fixtures);

  // نمسح القديمة (اللي انتهت) + نضيف الجديدة
  const oldIds = new Set(autoData.matches.map((m) => m.id));
  const newMatches = autoData.matches.filter((m) => m.startTime > now);
  let added = 0;
  for (const nm of parsed) {
    if (!oldIds.has(nm.id)) { newMatches.push(nm); added++; }
  }
  autoData.matches = newMatches;
  autoData.lastFetch = now;
  saveAutoData();
  console.log("✅ تم تحديث " + added + " مباراة جديدة. المجموع: " + autoData.matches.length);
  return added;
}

