function ensureBackupDir() {
  const dir = path.join(__dirname, "data", "backups");
  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  try { fs.chmodSync(dir, 0o700); } catch {}
  return dir;
}

async function getChannelsData(client) {
  let guild = client.guilds.cache.get(GUILD_ID);
  if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
  if (!guild) return null;
  await guild.channels.fetch().catch(() => {});

  const ignoreIds = [guild.rulesChannelId, guild.publicUpdatesChannelId, guild.systemChannelId, guild.afkChannelId].filter(Boolean);

  const cats = [...guild.channels.cache.values()]
    .filter((c) => c.type === 4)
    .sort((a, b) => a.position - b.position)
    .map((cat, ci) => {
      const rooms = [...guild.channels.cache.values()]
        .filter((c) => c.type !== 4 && c.parentId === cat.id)
        .sort((a, b) => a.position - b.position)
        .map((c, ri) => ({
          id: c.id,
          name: c.name,
          type: c.type === 2 ? "voice" : c.type === 5 ? "announcement" : "text",
          catIdx: ci + 1,
          roomIdx: ri + 1,
        }));
      return { id: cat.id, name: cat.name, idx: ci + 1, rooms };
    });

  const orphans = [...guild.channels.cache.values()]
    .filter((c) => c.type !== 4 && !c.parentId && !ignoreIds.includes(c.id))
    .sort((a, b) => a.position - b.position)
    .map((c, ri) => ({
      id: c.id,
      name: c.name,
      type: c.type === 2 ? "voice" : "text",
      catIdx: 0,
      roomIdx: ri + 1,
    }));

  return { guild, cats, orphans, ignoreIds };
}

function buildChannelsTree(data, title, color) {
  const { cats, orphans } = data;
  const lines = [];
  lines.push("📁 **القنوات** (" + cats.length + ")");
  for (const cat of cats) {
    lines.push("**[C" + cat.idx + "]** 📁 " + cat.name + "  \`" + cat.id + "\`");
    if (cat.rooms.length === 0) {
      lines.push("   " + "_ماكو رومات_");
    } else {
      for (const r of cat.rooms) {
        const icon = r.type === "voice" ? "🔊" : r.type === "announcement" ? "📢" : "💬";
        lines.push("   [" + cat.idx + ":" + r.roomIdx + "] " + icon + " " + r.name);
      }
    }
  }
  if (orphans.length > 0) {
    lines.push("");
    lines.push("📁 **رومات بدون قناة** (" + orphans.length + ")");
    for (const r of orphans) {
      const icon = r.type === "voice" ? "🔊" : "💬";
      lines.push("   [0:" + r.roomIdx + "] " + icon + " " + r.name);
    }
  }
  const embed = new EmbedBuilder()
    .setColor(color || 0x3498db)
    .setTitle(title)
    .setDescription(lines.join("\n").slice(0, 3000))
    .setFooter({ text: "MRBOT Channels" });
  return embed;
}

function buildChannelPreview(channels, categories) {
  const lines = [];
  for (const cat of categories) {
    lines.push("📁 **" + cat.name + "**");
    for (const ch of cat.channels) lines.push("   💬 " + ch.name);
  }
  if (categories.length === 0 && channels.length > 0) lines.push("**رومات بدون قناة:**");
  for (const ch of channels) lines.push("💬 " + ch.name);

  const embed = new EmbedBuilder()
    .setColor(0x2ecc71)
    .setTitle("➕ إضافة رومات")
    .setDescription(
      "**الرومات اللي راح تنسوي:**\n\n" +
      (lines.join("\n") || "ماكو شي") +
      "\n\n**القنوات:** " + categories.length + " | **الرومات:** " + channels.length
    );
  return embed;
}

