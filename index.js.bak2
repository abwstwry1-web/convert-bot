function getFamousPlayer(teamName) {
  if (!teamName) return null;
  if (PLAYERS_MAP[teamName]) return PLAYERS_MAP[teamName];
  // نجرب بشوية تعديلات
  const clean = teamName.replace(/^(منتخب|Team)\s+/i, "").trim();
  if (PLAYERS_MAP[clean]) return PLAYERS_MAP[clean];
  for (const k of Object.keys(PLAYERS_MAP)) {
    if (k.toLowerCase() === clean.toLowerCase()) return PLAYERS_MAP[k];
  }
  return null;
}

