};

function getTeamColors(teamName) {
  const t = (teamName || "").toLowerCase().trim();
  for (const k in TEAM_COLORS) {
    if (t.includes(k) || k.includes(t)) return TEAM_COLORS[k];
  }
  return { c1: "#5865f2", c2: "#eb459e" };
}

function hexToRgba(hex, a) {
  const h = hex.replace("#", "");
  const r = parseInt(h.substring(0, 2), 16);
  const g = parseInt(h.substring(2, 4), 16);
  const b = parseInt(h.substring(4, 6), 16);
  return "rgba(" + r + "," + g + "," + b + "," + a + ")";
}

async function generateMatchCard(m) {
  const W = 1400, H = 750;
  const canvas = createCanvas(W, H);
  const ctx = canvas.getContext("2d");

  const colors1 = getTeamColors(m.team1);
  const colors2 = getTeamColors(m.team2);

  // ═══ 1) الخلفية ═══
  const bg = ctx.createLinearGradient(0, 0, 0, H);
  bg.addColorStop(0, "#050816");
  bg.addColorStop(1, "#0a0f2c");
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // ═══ 3) توهج بلون الفريق الأول (يسار) ═══
  const glowL = ctx.createRadialGradient(280, H/2, 50, 280, H/2, 700);
  glowL.addColorStop(0, hexToRgba(colors1.c1, 0.85));
  glowL.addColorStop(0.5, hexToRgba(colors1.c1, 0.3));
  glowL.addColorStop(1, hexToRgba(colors1.c1, 0));
  ctx.fillStyle = glowL;
  ctx.fillRect(0, 0, W/2 + 100, H);

  // ═══ 4) توهج بلون الفريق الثاني (يمين) ═══
  const glowR = ctx.createRadialGradient(W - 280, H/2, 50, W - 280, H/2, 700);
  glowR.addColorStop(0, hexToRgba(colors2.c1, 0.85));
  glowR.addColorStop(0.5, hexToRgba(colors2.c1, 0.3));
  glowR.addColorStop(1, hexToRgba(colors2.c1, 0));
  ctx.fillStyle = glowR;
  ctx.fillRect(W/2 - 100, 0, W/2 + 100, H);

  // ═══ توهج مركزي بين الفريقين ═══
  const centralGlow = ctx.createRadialGradient(W/2, H/2 + 30, 50, W/2, H/2 + 30, 500);
  centralGlow.addColorStop(0, hexToRgba(colors1.c1, 0.3));
  centralGlow.addColorStop(0.4, hexToRgba(colors2.c1, 0.2));
  centralGlow.addColorStop(1, "rgba(0,0,0,0)");
  ctx.fillStyle = centralGlow;
  ctx.fillRect(W/2 - 500, H/2 - 500, 1000, 1000);

  // ═══ 5) شريط علوي وسفلي ═══
  const topBar = ctx.createLinearGradient(0, 0, W, 0);
  topBar.addColorStop(0, hexToRgba(colors1.c1, 0));
  topBar.addColorStop(0.3, hexToRgba(colors1.c1, 1));
  topBar.addColorStop(0.5, "rgba(255,255,255,1)");
  topBar.addColorStop(0.7, hexToRgba(colors2.c1, 1));
  topBar.addColorStop(1, hexToRgba(colors2.c1, 0));
  ctx.fillStyle = topBar;
  ctx.fillRect(0, 0, W, 5);
  ctx.fillRect(0, H - 5, W, 5);

  // ═══ 6) الشعارات ═══
  const [img1, img2] = await Promise.all([
    loadImageFromUrl(m.logo1),
    loadImageFromUrl(m.logo2),
  ]);

  const cx1 = 250;
  const cx2 = W - 250;
  const cy = H / 2 - 30;
  const hexR = 135;

  function drawHex(cx, cy, r) {
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const ang = (Math.PI / 3) * i - Math.PI / 6;
      const x = cx + r * Math.cos(ang);
      const y = cy + r * Math.sin(ang);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.closePath();
  }

  // هالة الفريق الأول
  const halo1 = ctx.createRadialGradient(cx1, cy, hexR - 20, cx1, cy, hexR + 90);
  halo1.addColorStop(0, hexToRgba(colors1.c1, 0.85));
  halo1.addColorStop(1, hexToRgba(colors1.c1, 0));
  ctx.fillStyle = halo1;
  ctx.beginPath();
  ctx.arc(cx1, cy, hexR + 90, 0, Math.PI * 2);
  ctx.fill();

  ctx.save();
  drawHex(cx1, cy, hexR + 15);
  ctx.fillStyle = "rgba(15, 20, 45, 0.95)";
  ctx.fill();
  ctx.strokeStyle = hexToRgba(colors1.c1, 1);
  ctx.lineWidth = 5;
  ctx.stroke();
  ctx.restore();

  ctx.save();
  drawHex(cx1, cy, hexR);
  ctx.fillStyle = "rgba(0, 0, 0, 0.8)";
  ctx.fill();
  ctx.clip();
  if (img1) {
    const pad = 20;
    const maxW = (hexR - pad) * 2;
    const maxH = (hexR - pad) * 2;
    const ratio = Math.min(maxW / img1.width, maxH / img1.height);
    ctx.drawImage(img1, cx1 - (img1.width * ratio) / 2, cy - (img1.height * ratio) / 2, img1.width * ratio, img1.height * ratio);
  }
  ctx.restore();

  // هالة الفريق الثاني
  const halo2 = ctx.createRadialGradient(cx2, cy, hexR - 20, cx2, cy, hexR + 90);
  halo2.addColorStop(0, hexToRgba(colors2.c1, 0.85));
  halo2.addColorStop(1, hexToRgba(colors2.c1, 0));
  ctx.fillStyle = halo2;
  ctx.beginPath();
  ctx.arc(cx2, cy, hexR + 90, 0, Math.PI * 2);
  ctx.fill();

  ctx.save();
  drawHex(cx2, cy, hexR + 15);
  ctx.fillStyle = "rgba(15, 20, 45, 0.95)";
  ctx.fill();
  ctx.strokeStyle = hexToRgba(colors2.c1, 1);
  ctx.lineWidth = 5;
  ctx.stroke();
  ctx.restore();

  ctx.save();
  drawHex(cx2, cy, hexR);
  ctx.fillStyle = "rgba(0, 0, 0, 0.8)";
  ctx.fill();
  ctx.clip();
  if (img2) {
    const pad = 20;
    const maxW = (hexR - pad) * 2;
    const maxH = (hexR - pad) * 2;
    const ratio = Math.min(maxW / img2.width, maxH / img2.height);
    ctx.drawImage(img2, cx2 - (img2.width * ratio) / 2, cy - (img2.height * ratio) / 2, img2.width * ratio, img2.height * ratio);
  }
  ctx.restore();

  // ═══ 7) أسماء الفرق ═══
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";

  const nameY = cy + hexR + 70;

  ctx.font = "bold 42px LatinFont, ArabicFont, sans-serif";
  fitFont(ctx, m.team1, 450, 42);
  const tw1 = ctx.measureText(m.team1).width;
  ctx.fillStyle = "rgba(0, 0, 0, 0.8)";
  roundRect(ctx, cx1 - tw1 / 2 - 25, nameY - 30, tw1 + 50, 60, 15);
  ctx.fill();
  ctx.strokeStyle = hexToRgba(colors1.c1, 1);
  ctx.lineWidth = 3;
  roundRect(ctx, cx1 - tw1 / 2 - 25, nameY - 30, tw1 + 50, 60, 15);
  ctx.stroke();
  ctx.fillStyle = "#ffffff";
  ctx.shadowColor = hexToRgba(colors1.c1, 1);
  ctx.shadowBlur = 15;
  ctx.fillText(m.team1, cx1, nameY);
  ctx.shadowBlur = 0;

  ctx.font = "bold 42px LatinFont, ArabicFont, sans-serif";
  fitFont(ctx, m.team2, 450, 42);
  const tw2 = ctx.measureText(m.team2).width;
  ctx.fillStyle = "rgba(0, 0, 0, 0.8)";
  roundRect(ctx, cx2 - tw2 / 2 - 25, nameY - 30, tw2 + 50, 60, 15);
  ctx.fill();
  ctx.strokeStyle = hexToRgba(colors2.c1, 1);
  ctx.lineWidth = 3;
  roundRect(ctx, cx2 - tw2 / 2 - 25, nameY - 30, tw2 + 50, 60, 15);
  ctx.stroke();
  ctx.fillStyle = "#ffffff";
  ctx.shadowColor = hexToRgba(colors2.c1, 1);
  ctx.shadowBlur = 15;
  ctx.fillText(m.team2, cx2, nameY);
  ctx.shadowBlur = 0;

  // ═══ 8) الوقت في الوسط ═══
  const iraq = new Date(m.startTime + 3 * 3600 * 1000);
  const dayNames = ["الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"];
  const monthNames = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
  const dayName = dayNames[iraq.getUTCDay()];
  const monthName = monthNames[iraq.getUTCMonth()];
  const dayNum = iraq.getUTCDate();
  const year = iraq.getUTCFullYear();
  const hour = iraq.getUTCHours();
  const min = String(iraq.getUTCMinutes()).padStart(2, "0");
  const ampm = hour >= 12 ? "م" : "ص";
  const h12 = hour % 12 || 12;

  // خلفية الوقت (زجاجية وسط الصورة)
  const timeBoxY = cy + 30;
  ctx.save();
  ctx.fillStyle = "rgba(15, 20, 50, 0.92)";
  roundRect(ctx, W / 2 - 200, timeBoxY - 80, 400, 160, 22);
  ctx.fill();
  ctx.strokeStyle = "rgba(180, 200, 255, 0.7)";
  ctx.lineWidth = 3;
  roundRect(ctx, W / 2 - 200, timeBoxY - 80, 400, 160, 22);
  ctx.stroke();
  ctx.restore();

  // الوقت (كبير في الوسط)
  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 90px LatinFont, ArabicFont, sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.shadowColor = "rgba(120, 160, 255, 1)";
  ctx.shadowBlur = 30;
  ctx.fillText(h12 + ":" + min, W / 2, timeBoxY - 10);
  ctx.shadowBlur = 0;

  // ص/م
  ctx.font = "bold 32px LatinFont, ArabicFont, sans-serif";
  ctx.fillStyle = "rgba(200, 215, 255, 0.9)";
  ctx.fillText(ampm, W / 2, timeBoxY + 45);

  // ═══ 9) التاريخ تحت ═══
  const dateY = timeBoxY + 130;
  ctx.font = "bold 26px LatinFont, ArabicFont, sans-serif";
  ctx.fillStyle = "rgba(200, 215, 255, 0.85)";
  ctx.fillText(dayName + " " + dayNum + " " + monthName + " " + year, W / 2, dateY);

  // ═══ 10) الدوري (أعلى) ═══
  if (m.league) {
    const lgTxt = m.league;
    ctx.font = "bold 22px LatinFont, ArabicFont, sans-serif";
    const tw = ctx.measureText(lgTxt).width;
    const pillW = tw + 80;
    const pillX = W / 2 - pillW / 2;
    const pillY = 40;

    const pillGrad = ctx.createLinearGradient(pillX, 0, pillX + pillW, 0);
    pillGrad.addColorStop(0, hexToRgba(colors1.c1, 0.8));
    pillGrad.addColorStop(0.5, "rgba(80, 80, 160, 0.9)");
    pillGrad.addColorStop(1, hexToRgba(colors2.c1, 0.8));
    ctx.fillStyle = pillGrad;
    roundRect(ctx, pillX, pillY, pillW, 55, 28);
    ctx.fill();
    ctx.strokeStyle = "rgba(220, 230, 255, 0.9)";
    ctx.lineWidth = 2.5;
    roundRect(ctx, pillX, pillY, pillW, 55, 28);
    ctx.stroke();

    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 22px LatinFont, ArabicFont, sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText("🏆 " + lgTxt, W / 2, pillY + 28);
  }

  // ═══ 11) المتوقعين ═══
  const predsCount = Object.keys(m.predictions || {}).length;
  ctx.textAlign = "center";
  ctx.fillStyle = "rgba(200, 215, 255, 0.9)";
  ctx.font = "bold 20px LatinFont, ArabicFont, sans-serif";
  ctx.fillText("🎯 المتوقعين: " + predsCount, W / 2, H - 50);

  ctx.fillStyle = "rgba(140, 160, 220, 0.5)";
  ctx.font = "bold 14px LatinFont, ArabicFont, sans-serif";
  ctx.fillText("MRBOT • 2026", W / 2, H - 20);

  return canvas.toBuffer("image/png");
}

