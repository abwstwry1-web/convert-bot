async function fetchPlayerImage(playerName, teamHint) {
  const keyForCache = playerName || teamHint;
  if (!keyForCache) return null;
  const safeName = keyForCache.replace(/[^a-zA-Z0-9]/g, "_");
  const cacheImg = require("path").join(PLAYER_CACHE_DIR, safeName + ".png");
  const cacheMeta = require("path").join(PLAYER_CACHE_DIR, safeName + ".json");

  // كاش
  if (fs.existsSync(cacheImg) && fs.statSync(cacheImg).size > 1000) {
    try {
      const meta = fs.existsSync(cacheMeta) ? JSON.parse(fs.readFileSync(cacheMeta, "utf8")) : {};
      console.log("📦 كاش: " + playerName + " (" + (meta.source || "?") + ")");
      return await loadImage(fs.readFileSync(cacheImg));
    } catch {}
  }

  // نبحث بالمصادر المتعددة
  const result = await findPlayerImage(playerName, teamHint);
  if (!result || !result.url) {
    console.log("❌ ما لكيت صورة: " + playerName);
    return null;
  }

  try {
    const r = await fetch(result.url, { headers: { "User-Agent": "MRBOT/1.0" } });
    if (!r.ok) { console.log("❌ فشل تحميل: " + playerName); return null; }
    let buf = Buffer.from(await r.arrayBuffer());
    if (buf.length < 2000) { console.log("⚠️ صورة صغيرة: " + playerName); return null; }
    // إذا مو cutout، نحاول نشيل الخلفية
    if (!result.hasCutout) {
      try {
        const processed = await removeWhiteBg(buf);
        if (processed && processed.length > 1000) buf = processed;
      } catch {}
    }
    fs.writeFileSync(cacheImg, buf);
    fs.writeFileSync(cacheMeta, JSON.stringify({
      source: result.source,
      matchedName: result.matchedName,
      originalName: playerName || teamHint,
      hasCutout: result.hasCutout || false,
      size: buf.length,
      date: Date.now(),
    }));
    // نحفظ meta للفريق أيضاً
    if (teamHint) {
      const teamKey = teamHint.replace(/[^a-zA-Z0-9]/g, "_");
      const teamMetaPath = require("path").join(SQUAD_CACHE_DIR, "squad_meta_" + teamKey + ".json");
      fs.writeFileSync(teamMetaPath, JSON.stringify({ name: result.matchedName, source: result.source, date: Date.now() }));
    }
    console.log("✅ " + playerName + " → " + result.matchedName + " (" + result.source + ")");
    return await loadImage(buf);
  } catch (e) {
    console.log("❌ تحميل " + playerName + ": " + e.message);
    return null;
  }
}

// ═══════════════════════════════════════════════
// 🎨 رسم التشكيلة (ملعب + لاعبين + أحداث)
// ═══════════════════════════════════════════════

async function generateLineupCard(m, fixtureId) {
  const W = 1600, H = 1200;
  const canvas = createCanvas(W, H);
  const ctx = canvas.getContext("2d");

  // ═══ الخلفية ═══
  const bg = ctx.createLinearGradient(0, 0, 0, H);
  bg.addColorStop(0, "#0a0e27");
  bg.addColorStop(1, "#050816");
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // ═══ الملعب ═══
  const pitchX = 80, pitchY = 180, pitchW = W - 160, pitchH = H - 300;
  const pg = ctx.createLinearGradient(0, pitchY, 0, pitchY + pitchH);
  pg.addColorStop(0, "#0d5c2e");
  pg.addColorStop(0.5, "#0e6b35");
  pg.addColorStop(1, "#0d5c2e");
  ctx.fillStyle = pg;
  roundRect(ctx, pitchX, pitchY, pitchW, pitchH, 25);
  ctx.fill();

  // خطوط الملعب
  ctx.strokeStyle = "rgba(255, 255, 255, 0.35)";
  ctx.lineWidth = 3;
  ctx.strokeRect(pitchX, pitchY, pitchW, pitchH);

  // خط المنتصف
  ctx.beginPath();
  ctx.moveTo(pitchX + pitchW / 2, pitchY);
  ctx.lineTo(pitchX + pitchW / 2, pitchY + pitchH);
  ctx.stroke();

  // دائرة المنتصف
  ctx.beginPath();
  ctx.arc(pitchX + pitchW / 2, pitchY + pitchH / 2, 90, 0, Math.PI * 2);
  ctx.stroke();

  // منطقة الجزاء العلوية
  ctx.strokeRect(pitchX + pitchW / 2 - 250, pitchY, 500, 130);
  ctx.strokeRect(pitchX + pitchW / 2 - 130, pitchY, 260, 55);
  // منطقة الجزاء السفلية
  ctx.strokeRect(pitchX + pitchW / 2 - 250, pitchY + pitchH - 130, 500, 130);
  ctx.strokeRect(pitchX + pitchW / 2 - 130, pitchY + pitchH - 55, 260, 55);

  // ═══ جلب البيانات ═══
  const [lineup, events, info] = await Promise.all([
    fetchLineup(fixtureId),
    fetchLiveEvents(fixtureId),
    fetchFixtureInfo(fixtureId),
  ]);

  const homeScore = info?.goals?.home ?? 0;
  const awayScore = info?.goals?.away ?? 0;
  const minute = info?.fixture?.status?.elapsed ?? 0;
  const status = info?.fixture?.status?.short ?? "NS";

  // ═══ الهيدر (نتيجة حية) ═══
  ctx.fillStyle = "rgba(20, 25, 50, 0.9)";
  roundRect(ctx, W / 2 - 350, 30, 700, 130, 25);
  ctx.fill();
  ctx.strokeStyle = "rgba(120, 160, 255, 0.6)";
  ctx.lineWidth = 3;
  roundRect(ctx, W / 2 - 350, 30, 700, 130, 25);
  ctx.stroke();

  // الأعلام
  const f1 = await loadImageFromUrl(m.logo1).catch(() => null);
  const f2 = await loadImageFromUrl(m.logo2).catch(() => null);
  if (f1) ctx.drawImage(f1, W / 2 - 320, 55, 80, 80);
  if (f2) ctx.drawImage(f2, W / 2 + 240, 55, 80, 80);

  // النتيجة
  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 70px LatinFont, ArabicFont, sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText(homeScore + " - " + awayScore, W / 2, 95);

  // الدقيقة
  ctx.font = "bold 24px LatinFont, ArabicFont, sans-serif";
  ctx.fillStyle = "rgba(180, 200, 255, 0.9)";
  const statusTxt = status === "FT" ? "انتهت" : status === "HT" ? "استراحة" : status === "1H" || status === "2H" ? minute + "'" : "قريباً";
  ctx.fillText(statusTxt, W / 2, 140);

  // أسماء الفرق
  ctx.font = "bold 22px LatinFont, ArabicFont, sans-serif";
  ctx.fillStyle = "#ffffff";
  ctx.textAlign = "left";
  ctx.fillText(m.team1.slice(0, 20), W / 2 - 230, 95);
  ctx.textAlign = "right";
  ctx.fillText(m.team2.slice(0, 20), W / 2 + 230, 95);

  // ═══ رسم اللاعبين ═══
  function drawTeamPlayers(teamLineup, side) {
    if (!teamLineup || !teamLineup.startXI) return;
    const side_ = side === "home" ? 1 : -1; // 1 = فوق، -1 = تحت
    const colors = jerseyColor(teamLineup.team?.name || "");

    // نجمع حسب الصفوف
    const rows = {};
    for (const p of teamLineup.startXI) {
      const grid = p.player?.grid;
      if (!grid) continue;
      const parts = grid.split(":");
      const row = parseInt(parts[0]);
      const col = parseInt(parts[1]);
      if (isNaN(row) || isNaN(col)) continue;
      if (!rows[row]) rows[row] = [];
      rows[row].push({ ...p.player, _col: col, _row: row });
    }

    const rowKeys = Object.keys(rows).map(Number).sort((a, b) => a - b);
    const maxRow = rowKeys.length ? Math.max(...rowKeys) : 4;

    const fieldTop = pitchY + 60;
    const fieldBot = pitchY + pitchH - 60;
    const fieldH = fieldBot - fieldTop;

    for (const rk of rowKeys) {
      const players = rows[rk].sort((a, b) => a._col - b._col);
      const n = players.length;

      // موقع الصف
      let yPos;
      if (side === "home") {
        // فريق فوق: يبدأ من الأعلى
        const fraction = rk === 1 ? 0.06 : (rk - 1) / (maxRow - 1) * 0.42 + 0.06;
        yPos = fieldTop + fieldH * fraction;
      } else {
        // فريق تحت: يبدأ من الأسفل
        const fraction = rk === 1 ? 0.94 : 1 - ((rk - 1) / (maxRow - 1) * 0.42 + 0.06);
        yPos = fieldTop + fieldH * fraction;
      }

      for (let i = 0; i < n; i++) {
        const p = players[i];
        const xFrac = (i + 1) / (n + 1);
        const xPos = pitchX + pitchW * xFrac;

        // دائرة اللاعب
        const circleR = 26;
        ctx.fillStyle = colors.bg;
        ctx.beginPath();
        ctx.arc(xPos, yPos, circleR, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "rgba(255, 255, 255, 0.9)";
        ctx.lineWidth = 2.5;
        ctx.stroke();

        // الرقم
        ctx.fillStyle = colors.text;
        ctx.font = "bold 24px LatinFont, ArabicFont, sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(p.number || "?", xPos, yPos + 1);

        // الاسم
        ctx.fillStyle = "rgba(255, 255, 255, 0.95)";
        ctx.font = "bold 14px LatinFont, ArabicFont, sans-serif";
        const fullName = p.name || "";
        const lastName = fullName.split(" ").slice(-1)[0] || fullName;
        ctx.fillText(lastName.slice(0, 12), xPos, yPos + circleR + 15);

        // ═══ الأحداث فوق الرأس ═══
        if (events && events.length) {
          const myEvents = events.filter((e) => e.player && (e.player.id == p.id || (e.player.name && nameMatch(e.player.name, p.name))));
          let offsetY = -circleR - 15;
          for (const ev of myEvents) {
            const type = ev.type || "";
            const detail = ev.detail || "";
            let icon = "";
            if (type === "Goal") icon = "⚽";
            else if (type === "Card" && detail === "Yellow Card") icon = "🟨";
            else if (type === "Card" && detail === "Red Card") icon = "🟥";
            else if (type === "subst") icon = "🔁";

            if (icon) {
              ctx.font = "28px sans-serif";
              ctx.fillText(icon, xPos, offsetY);
              offsetY -= 32;
            }
          }
        }
      }
    }
  }

  if (lineup && lineup.length >= 2) {
    drawTeamPlayers(lineup[0], "home");
    drawTeamPlayers(lineup[1], "away");
  } else {
    // ماكو تشكيلة — نعرض رسالة
    ctx.fillStyle = "rgba(255, 255, 255, 0.7)";
    ctx.font = "bold 40px LatinFont, ArabicFont, sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("⏳ التشكيلة ما نزلت بعد", W / 2, pitchY + pitchH / 2);
    ctx.font = "bold 24px LatinFont, ArabicFont, sans-serif";
    ctx.fillStyle = "rgba(180, 200, 255, 0.7)";
    ctx.fillText("التشكيلة تظهر عادة قبل المباراة بساعة", W / 2, pitchY + pitchH / 2 + 50);
  }

  // ═══ الفوتر ═══
  ctx.fillStyle = "rgba(120, 130, 180, 0.5)";
  ctx.font = "bold 18px LatinFont, ArabicFont, sans-serif";
  ctx.textAlign = "center";
  ctx.fillText("MRBOT Live • " + (m.league || ""), W / 2, H - 40);

  return canvas.toBuffer("image/png");
}

