function levenshtein(a, b) {
  if (a.length === 0) return b.length;
  if (b.length === 0) return a.length;
  const matrix = [];
  for (let i = 0; i <= b.length; i++) matrix[i] = [i];
  for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
  for (let i = 1; i <= b.length; i++) {
    for (let j = 1; j <= a.length; j++) {
      if (b.charAt(i - 1) === a.charAt(j - 1)) {
        matrix[i][j] = matrix[i - 1][j - 1];
      } else {
        matrix[i][j] = Math.min(
          matrix[i - 1][j - 1] + 1,
          matrix[i][j - 1] + 1,
          matrix[i - 1][j] + 1
        );
      }
    }
  }
  return matrix[b.length][a.length];
}

function similarity(a, b) {
  const A = normName(a), B = normName(b);
  if (!A || !B) return 0;
  if (A === B) return 1;
  const maxLen = Math.max(A.length, B.length);
  return 1 - levenshtein(A, B) / maxLen;
}

// ترانسليتريشن عربي تقريبي
function transliterateArabic(str) {
  const map = {
    'ا': 'a', 'أ': 'a', 'إ': 'i', 'آ': 'aa', 'ب': 'b', 'ت': 't', 'ث': 'th',
    'ج': 'j', 'ح': 'h', 'خ': 'kh', 'د': 'd', 'ذ': 'dh', 'ر': 'r', 'ز': 'z',
    'س': 's', 'ش': 'sh', 'ص': 's', 'ض': 'd', 'ط': 't', 'ظ': 'dh', 'ع': 'a',
    'غ': 'gh', 'ف': 'f', 'ق': 'q', 'ك': 'k', 'ل': 'l', 'م': 'm', 'ن': 'n',
    'ه': 'h', 'و': 'w', 'ي': 'y', 'ى': 'a', 'ة': 'a', 'ء': 'a', 'ئ': 'y',
    'ؤ': 'w', 'ﻻ': 'la', 'لا': 'la',
  };
  return str.split('').map((c) => map[c] || c).join('').replace(/\s+/g, ' ').trim();
}

// كلمات مشتركة نتجاهلها
const STOPWORDS = new Set(["de", "da", "do", "van", "der", "den", "la", "le", "el", "al", "bin", "ibn", "ben", "the", "jr", "sr", "ii", "iii"]);

function normName(str) {
  if (!str) return "";
  let out = str.toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  // لو فيه عربي، نحوله
  if (/[\u0600-\u06FF]/.test(out)) {
    out = transliterateArabic(out);
  }
  out = out.replace(/[^a-z0-9 ]/g, " ")
    .replace(/\s+/g, " ").trim();
  // نشيل كلمات مشتركة
  const words = out.split(" ").filter((w) => !STOPWORDS.has(w));
  return words.join(" ");
}

function nameMatch(a, b) {
  const A = normName(a), B = normName(b);
  if (!A || !B) return false;
  if (A === B) return true;
  const sim = similarity(A, B);
  if (sim >= 0.75) return true;
  // كل كلمات a موجودة في b
  const aW = A.split(" ").filter((w) => w.length > 2);
  const bW = B.split(" ").filter((w) => w.length > 2);
  if (aW.length === 0 || bW.length === 0) return false;
  return aW.every((w) => B.includes(w)) || bW.every((w) => A.includes(w));
}

// ═══════════════════════════════════════════
// 🔍 نظام البحث عن اللاعبين (متعدد المصادر)
// ═══════════════════════════════════════════

function normName(str) {
  if (!str) return "";
  return str.toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9 ]/g, " ")
    .replace(/\s+/g, " ").trim();
}

function nameMatch(a, b) {
  const A = normName(a), B = normName(b);
  if (!A || !B) return false;
  if (A === B) return true;
  // نتحقق من كلمات الاسم
  const aW = A.split(" ").filter((w) => w.length > 2);
  const bW = B.split(" ").filter((w) => w.length > 2);
  if (aW.length === 0 || bW.length === 0) return false;
  // كل كلمات a موجودة في b أو العكس
  const allA = aW.every((w) => B.includes(w));
  const allB = bW.every((w) => A.includes(w));
  return allA || allB;
}

// ═══ المصدر 1: API-Football ═══
async function searchAPIFootballPlayer(playerName) {
  try {
    const key = process.env.FOOTBALL_API_KEY;
    if (!key) return null;
    const url = "https://v3.football.api-sports.io/players?search=" + encodeURIComponent(playerName);
    const r = await fetch(url, { headers: { "x-apisports-key": key } });
    const j = await r.json();
    if (!j.response || !j.response.length) return null;

    // نختار اللاعب الأقرب للاسم
    let best = null;
    let bestScore = 0;
    for (const item of j.response) {
      if (!item.player || !item.player.name) continue;
      const n = item.player.name;
      if (!nameMatch(n, playerName)) continue;
      // نفضل من عنده photo
      let score = 0;
      if (item.player.photo) score += 10;
      if (item.player.nationality) score += 3;
      if (item.player.age) score += 1;
      // نفضل نفس الاسم بالضبط
      if (normName(n) === normName(playerName)) score += 50;
      if (score > bestScore) { bestScore = score; best = item.player; }
    }
    if (!best || !best.photo) return null;
    return { url: best.photo, source: "apifootball", matchedName: best.name };
  } catch (e) {
    console.log("❌ APIFootball [" + playerName + "]: " + e.message);
    return null;
  }
}

// ═══ المصدر 2: TheSportsDB ═══
async function searchSportsDBPlayer(playerName) {
  try {
    const url = "https://www.thesportsdb.com/api/v1/json/3/searchplayers.php?p=" + encodeURIComponent(playerName);
    const r = await fetch(url);
    const j = await r.json();
    if (!j.player || !j.player.length) return null;

    let best = null;
    let bestScore = 0;
    for (const p of j.player) {
      if (!p.strPlayer) continue;
      if (!nameMatch(p.strPlayer, playerName)) continue;
      if (p.strSport && p.strSport.toLowerCase() !== "soccer") continue;
      // نفضل cutout
      let score = 0;
      if (p.strCutout) score += 30;
      else if (p.strRender) score += 15;
      else if (p.strThumb) score += 5;
      else continue;
      // مطابقة بالضبط
      if (normName(p.strPlayer) === normName(playerName)) score += 50;
      // نفس الجنسية (منتخب)
      if (score > bestScore) { bestScore = score; best = p; }
    }
    if (!best) return null;
    const imgUrl = best.strCutout || best.strRender || best.strThumb;
    if (!imgUrl) return null;
    return { url: imgUrl, source: "thesportsdb", matchedName: best.strPlayer, hasCutout: !!best.strCutout };
  } catch (e) {
    console.log("❌ SportsDB [" + playerName + "]: " + e.message);
    return null;
  }
}

// ═══ المصدر 3: Wikipedia ═══
async function searchWikipediaPlayer(playerName) {
  try {
    const query = encodeURIComponent(playerName + " footballer");
    const url = "https://en.wikipedia.org/w/api.php?action=query&format=json&prop=pageimages&pithumbsize=500&generator=search&gsrsearch=" + query + "&gsrlimit=5&redirects=1";
    const r = await fetch(url, { headers: { "User-Agent": "MRBOT/1.0" } });
    const j = await r.json();
    if (!j.query || !j.query.pages) return null;

    const pages = Object.values(j.query.pages);
    let best = null;
    for (const pg of pages) {
      if (!pg.title) continue;
      if (!pg.thumbnail || !pg.thumbnail.source) continue;
      // نتحقق من الاسم
      const titleClean = pg.title.replace(/\(.*?\)/g, "").trim();
      if (!nameMatch(titleClean, playerName)) continue;
      if (!best) best = pg;
      // نفضل الاسم الأقرب
      if (normName(titleClean) === normName(playerName)) { best = pg; break; }
    }
    if (!best) return null;
    return { url: best.thumbnail.source, source: "wikipedia", matchedName: best.title };
  } catch (e) {
    console.log("❌ Wikipedia [" + playerName + "]: " + e.message);
    return null;
  }
}

// ═══ المصدر 4: FotMob ═══
async function searchFotMobPlayer(playerName) {
  try {
    // FotMob search
    const url = "https://www.fotmob.com/api/searchapi/suggest?term=" + encodeURIComponent(playerName) + "&lang=en";
    const r = await fetch(url, { headers: { "User-Agent": "Mozilla/5.0" } });
    if (!r.ok) return null;
    const j = await r.json();
    if (!j || !j.suggestions) return null;
    for (const sug of j.suggestions) {
      if (sug.type !== "player") continue;
      const n = sug.name || "";
      if (!nameMatch(n, playerName)) continue;
      const id = sug.id;
      if (!id) continue;
      // نجيب معلومات اللاعب (فيها الصورة)
      const r2 = await fetch("https://www.fotmob.com/api/playerData?id=" + id, { headers: { "User-Agent": "Mozilla/5.0" } });
      if (!r2.ok) continue;
      const j2 = await r2.json();
      const img = j2?.player?.img || j2?.player?.imageUrl;
      if (img && img.startsWith("http")) {
        return { url: img, source: "fotmob", matchedName: n, hasCutout: false };
      }
    }
    return null;
  } catch (e) { console.log("❌ FotMob [" + playerName + "]: " + e.message); return null; }
}

// ═══ المصدر 5: Wikidata ═══
async function searchWikidataPlayer(playerName) {
  try {
    // نبحث بالاسم
    const searchUrl = "https://www.wikidata.org/w/api.php?action=wbsearchentities&format=json&language=en&limit=5&search=" + encodeURIComponent(playerName + " footballer");
    const r = await fetch(searchUrl, { headers: { "User-Agent": "MRBOT/1.0" } });
    const j = await r.json();
    if (!j.search || !j.search.length) return null;
    for (const item of j.search) {
      if (!item.label) continue;
      if (!nameMatch(item.label, playerName)) continue;
      const id = item.id;
      // نجيب claims + image
      const detailUrl = "https://www.wikidata.org/w/api.php?action=wbgetentities&format=json&props=claims&ids=" + id;
      const r2 = await fetch(detailUrl, { headers: { "User-Agent": "MRBOT/1.0" } });
      const j2 = await r2.json();
      const ent = j2.entities && j2.entities[id];
      if (!ent || !ent.claims || !ent.claims.P18) continue;
      const file = ent.claims.P18[0]?.mainsnak?.datavalue?.value;
      if (!file) continue;
      const clean = file.replace(/ /g, "_");
      const imgUrl = "https://commons.wikimedia.org/wiki/Special:FilePath/" + encodeURIComponent(clean) + "?width=500";
      return { url: imgUrl, source: "wikidata", matchedName: item.label, hasCutout: false };
    }
    return null;
  } catch (e) { console.log("❌ Wikidata [" + playerName + "]: " + e.message); return null; }
}

// ═══ المصدر 6: DuckDuckGo Images ═══
async function searchDuckDuckGoPlayer(playerName, teamHint) {
  try {
    const query = playerName + (teamHint ? " " + teamHint : "") + " footballer portrait";
    // نجيب vqd من DuckDuckGo
    const vqdUrl = "https://duckduckgo.com/?q=" + encodeURIComponent(query) + "&iax=images&ia=images";
    const r0 = await fetch(vqdUrl, { headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" } });
    const html0 = await r0.text();
    const vqdMatch = html0.match(/vqd=["']?([\d-]+)["']?/);
    if (!vqdMatch) return null;
    const vqd = vqdMatch[1];

    const apiUrl = "https://duckduckgo.com/i.js?l=us-en&o=json&q=" + encodeURIComponent(query) + "&vqd=" + vqd + "&f=,,,,,&p=1";
    const r = await fetch(apiUrl, {
      headers: {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "Referer": "https://duckduckgo.com/",
      },
    });
    if (!r.ok) return null;
    const j = await r.json();
    if (!j.results || !j.results.length) return null;
    // ناخذ أول نتيجة موقوقة
    for (const res of j.results.slice(0, 5)) {
      if (res.image && res.image.startsWith("http") && res.width >= 300) {
        return { url: res.image, source: "ddg", matchedName: playerName, hasCutout: false };
      }
    }
    return null;
  } catch (e) { console.log("❌ DDG [" + playerName + "]: " + e.message); return null; }
}

// ═══ المصدر 7: SofaScore ═══
async function searchSofaScorePlayer(playerName) {
  try {
    const url = "https://api.sofascore.com/api/v1/search/all?q=" + encodeURIComponent(playerName);
    const r = await fetch(url, { headers: { "User-Agent": "Mozilla/5.0" } });
    if (!r.ok) return null;
    const j = await r.json();
    if (!j.results || !j.results.length) return null;
    for (const item of j.results) {
      if (item.type !== "player") continue;
      const entity = item.entity || {};
      if (!entity.name || !entity.id) continue;
      if (!nameMatch(entity.name, playerName)) continue;
      // جيب الصورة
      const imgUrl = "https://api.sofascore.app/api/v1/player/" + entity.id + "/image";
      return { url: imgUrl, source: "sofascore", matchedName: entity.name, hasCutout: false };
    }
    return null;
  } catch (e) { console.log("❌ SofaScore [" + playerName + "]: " + e.message); return null; }
}

// ═══ معالجة الصور: شيل الخلفية البيضاء/الرمادية ═══
async function removeWhiteBg(imgBuffer) {
  try {
    const { createCanvas, loadImage } = require("@napi-rs/canvas");
    const img = await loadImage(imgBuffer);
    const canvas = createCanvas(img.width, img.height);
    const ctx = canvas.getContext("2d");
    ctx.drawImage(img, 0, 0);
    const imgData = ctx.getImageData(0, 0, img.width, img.height);
    const d = imgData.data;
    for (let i = 0; i < d.length; i += 4) {
      const r = d[i], g = d[i + 1], b = d[i + 2];
      // لو اللون قريب من الأبيض/الرمادي الفاتح → شفاف
      if (r > 235 && g > 235 && b > 235) {
        d[i + 3] = 0;
      }
      // قريب من الرمادي الفاتح
      const diff = Math.max(r, g, b) - Math.min(r, g, b);
      if (diff < 15 && r > 200) {
        d[i + 3] = Math.min(d[i + 3], 80);
      }
    }
    ctx.putImageData(imgData, 0, 0);
    return canvas.toBuffer("image/png");
  } catch (e) { return imgBuffer; }
}

// ═══════════════════════════════════════════════
// ⚽ جلب التشكيلات والأحداث الحية
// ═══════════════════════════════════════════════

async function apiFetch(path) {
  const key = process.env.FOOTBALL_API_KEY;
  if (!key) return null;
  try {
    const r = await fetch("https://v3.football.api-sports.io" + path, {
      headers: { "x-apisports-key": key },
    });
    const j = await r.json();
    if (j.errors && Object.keys(j.errors).length) {
      const errStr = JSON.stringify(j.errors).slice(0, 120);
      if (!errStr.includes("free") && !errStr.includes("subscription")) console.log("⚠️ API " + path + ": " + errStr);
      return null;
    }
    return j;
  } catch (e) {
    console.log("api err " + path + ": " + e.message);
    return null;
  }
}

async function fetchLineup(fixtureId) {
  const j = await apiFetch("/fixtures/lineups?fixture=" + fixtureId);
  return j ? j.response : null;
}

async function fetchLiveEvents(fixtureId) {
  const j = await apiFetch("/fixtures/events?fixture=" + fixtureId);
  return j && j.response ? j.response : [];
}

async function fetchLiveFixture(fixtureId) {
  const j = await apiFetch("/fixtures?id=" + fixtureId);
  if (!j || !j.response || !j.response[0]) return null;
  const f = j.response[0];
  return {
    status: f.fixture.status.short,        // NS, 1H, HT, 2H, ET, FT, etc.
    elapsed: f.fixture.status.elapsed,     // الدقيقة الحالية
    extra: f.fixture.status.extra,         // الوقت البدل ضايع
    homeScore: f.goals.home ?? 0,
    awayScore: f.goals.away ?? 0,
    startTime: new Date(f.fixture.date).getTime(),
  };
}

async function fetchFixtureInfo(fixtureId) {
  const j = await apiFetch("/fixtures?id=" + fixtureId);
  return j && j.response && j.response[0] ? j.response[0] : null;
}

// تنسيقات مساعدة
function pitchPos(grid, teamSide) {
  // grid like "1:1" = row:col
  if (!grid) return null;
  const parts = grid.split(":").map((x) => parseInt(x));
  if (parts.length < 2) return null;
  const row = parts[0], col = parts[1];
  return { row, col };
}

function jerseyColor(teamName) {
  const t = (teamName || "").toLowerCase();
  if (t.includes("china")) return { bg: "#c8102e", text: "#ffffff" };
  if (t.includes("iraq")) return { bg: "#ce1126", text: "#ffffff" };
  if (t.includes("saudi")) return { bg: "#006c35", text: "#ffffff" };
  if (t.includes("new zealand")) return { bg: "#000000", text: "#ffffff" };
  if (t.includes("argentina")) return { bg: "#75aadb", text: "#000000" };
  if (t.includes("brazil")) return { bg: "#fedf00", text: "#009c3b" };
  if (t.includes("france")) return { bg: "#0055a4", text: "#ffffff" };
  if (t.includes("germany")) return { bg: "#000000", text: "#ffffff" };
  if (t.includes("spain")) return { bg: "#c60b1e", text: "#ffc400" };
  if (t.includes("italy")) return { bg: "#0066cc", text: "#ffffff" };
  if (t.includes("england")) return { bg: "#ffffff", text: "#cf142b" };
  if (t.includes("portugal")) return { bg: "#006600", text: "#ff0000" };
  if (t.includes("netherlands")) return { bg: "#f36c21", text: "#000000" };
  if (t.includes("mexico")) return { bg: "#006341", text: "#ffffff" };
  if (t.includes("usa") || t.includes("united states")) return { bg: "#002868", text: "#ffffff" };
  if (t.includes("japan")) return { bg: "#0b0f6a", text: "#ffffff" };
  if (t.includes("south korea")) return { bg: "#cd2e3a", text: "#ffffff" };
  return { bg: "#5865f2", text: "#ffffff" };
}

// ═══ الدالة الرئيسية: 8 مصادر ═══
// ═══════════════════════════════════════════════
// 🌍 نظام جلب التشكيلات الكاملة
// ═══════════════════════════════════════════════

const SQUAD_CACHE_DIR = require("path").join(__dirname, "data", "players", "squads");
if (!fs.existsSync(SQUAD_CACHE_DIR)) fs.mkdirSync(SQUAD_CACHE_DIR, { recursive: true });

async function getTeamIdFromSportsDB(teamName) {
  const safeName = teamName.replace(/[^a-zA-Z0-9]/g, "_").toLowerCase();
  const cacheFile = require("path").join(SQUAD_CACHE_DIR, "team_" + safeName + ".json");
  if (fs.existsSync(cacheFile)) {
    try {
      const d = JSON.parse(fs.readFileSync(cacheFile, "utf8"));
      if (d.id && Date.now() - d.t < 30 * 24 * 3600 * 1000) return d;
    } catch {}
  }
  try {
    const url = "https://www.thesportsdb.com/api/v1/json/3/searchteams.php?t=" + encodeURIComponent(teamName);
    const r = await fetch(url);
    const j = await r.json();
    if (!j.teams || !j.teams.length) return null;
    let best = null;
    for (const t of j.teams) {
      if (!t.strTeam) continue;
      if (!nameMatch(t.strTeam, teamName)) continue;
      const isNat = t.strSport === "Soccer" && (t.strTeam.includes("National") || (t.strDescriptionEN && t.strDescriptionEN.toLowerCase().includes("national team")));
      let score = similarity(t.strTeam, teamName) * 100;
      if (isNat) score += 50;
      if (!best || score > best._score) { best = { ...t, _score: score }; }
    }
    if (!best) return null;
    const out = { id: best.idTeam, name: best.strTeam, badge: best.strBadge, t: Date.now() };
    fs.writeFileSync(cacheFile, JSON.stringify(out));
    console.log("🌍 فريق: " + teamName + " → " + best.strTeam);
    return out;
  } catch (e) { console.log("team err " + teamName + ": " + e.message); return null; }
}

async function getTeamSquadFromSportsDB(teamId) {
  const cacheFile = require("path").join(SQUAD_CACHE_DIR, "squad_" + teamId + ".json");
  if (fs.existsSync(cacheFile)) {
    try {
      const d = JSON.parse(fs.readFileSync(cacheFile, "utf8"));
      if (d.players && Date.now() - d.t < 7 * 24 * 3600 * 1000) return d.players;
    } catch {}
  }
  try {
    const url = "https://www.thesportsdb.com/api/v1/json/3/lookup_all_players.php?id=" + teamId;
    const r = await fetch(url);
    const j = await r.json();
    if (!j.player || !j.player.length) return [];
    const players = j.player.map((p) => ({
      name: p.strPlayer, cutout: p.strCutout, thumb: p.strThumb, render: p.strRender,
      position: p.strPosition, nationality: p.strNationality,
      number: p.strNumber, height: p.strHeight, weight: p.strWeight,
      description: p.strDescriptionEN,
    })).filter((p) => p.name);
    fs.writeFileSync(cacheFile, JSON.stringify({ players, t: Date.now() }));
    console.log("👥 تشكيلة " + teamId + ": " + players.length + " لاعب");
    return players;
  } catch (e) { console.log("squad err: " + e.message); return []; }
}

function fameScore(p) {
  let score = 0;
  if (p.cutout) score += 200;
  else if (p.render) score += 100;
  else if (p.thumb) score += 40;
  const pos = (p.position || "").toLowerCase();
  if (pos.includes("forward") || pos.includes("striker") || pos.includes("winger")) score += 80;
  else if (pos.includes("attacking midfield")) score += 70;
  else if (pos.includes("midfielder")) score += 50;
  else if (pos.includes("defender")) score += 30;
  else if (pos.includes("goalkeeper") || pos.includes("keeper")) score += 25;
  if (p.description) {
    if (p.description.length > 2000) score += 60;
    else if (p.description.length > 1000) score += 40;
    else if (p.description.length > 500) score += 20;
  }
  if (p.number) {
    const n = parseInt(p.number);
    if (n === 7 || n === 10 || n === 9 || n === 11) score += 30;
    else if (n === 1) score += 20;
  }
  if (p.height) {
    const h = parseInt(p.height);
    if (h >= 165 && h <= 200) score += 15;
  }
  return score;
}

function pickMostFamousPlayer(players) {
  if (!players || !players.length) return null;
  const scored = players.map((p) => ({ ...p, _score: fameScore(p) })).sort((a, b) => b._score - a._score);
  return scored[0];
}

async function findPlayerFromSquad(teamName) {
  if (!teamName) return null;
  const teamInfo = await getTeamIdFromSportsDB(teamName);
  if (!teamInfo || !teamInfo.id) return null;
  const squad = await getTeamSquadFromSportsDB(teamInfo.id);
  if (!squad.length) return null;
  const best = pickMostFamousPlayer(squad);
  if (!best) return null;
  const img = best.cutout || best.render || best.thumb;
  if (!img) return null;
  return { name: best.name, imgUrl: img, hasCutout: !!best.cutout,
    position: best.position, number: best.number, team: teamInfo.name, source: "squad_auto" };
}

async function findPlayerImage(playerName, teamHint) {
  if (!playerName && !teamHint) return null;

  // ═══ المصدر الجديد الأول: التشكيلة الكاملة ═══
  if (teamHint) {
    try {
      const squadResult = await findPlayerFromSquad(teamHint);
      if (squadResult) {
        console.log("🏆 تشكيلة: " + teamHint + " → " + squadResult.name);
        return { url: squadResult.imgUrl, source: "squad_auto", matchedName: squadResult.name, hasCutout: squadResult.hasCutout };
      }
    } catch (e) { console.log("squad lookup err:", e.message); }
  }

  if (!playerName) return null;

  // APIFootball
  const r1 = await searchAPIFootballPlayer(playerName);
  if (r1) return r1;

  // 5 مصادر متوازية
  const results = await Promise.all([
    searchSportsDBPlayer(playerName).catch(() => null),
    searchWikipediaPlayer(playerName).catch(() => null),
    searchFotMobPlayer(playerName).catch(() => null),
    searchWikidataPlayer(playerName).catch(() => null),
    searchSofaScorePlayer(playerName).catch(() => null),
  ]);

  const valid = results.filter((r) => r && r.url);
  const scored = valid.map((r) => {
    let score = 0;
    if (r.hasCutout) score += 100;
    if (r.source === "thesportsdb") score += 50;
    if (r.source === "apifootball") score += 60;
    if (r.source === "fotmob") score += 40;
    if (r.source === "sofascore") score += 35;
    if (r.source === "wikidata") score += 25;
    if (r.source === "wikipedia") score += 20;
    score += similarity(r.matchedName, playerName) * 30;
    return { ...r, score };
  }).sort((a, b) => b.score - a.score);

  if (scored.length) return scored[0];

  // DDG احتياط
  const ddg = await searchDuckDuckGoPlayer(playerName, teamHint);
  if (ddg) return ddg;

  return null;
}

async function fetchPlayerImage(playerName, teamHint) {
  const keyForCache = playerName || teamHint;
  if (!keyForCache) return null;
  const safeName = keyForCache.replace(/[^a-zA-Z0-9]/g, "_");
  const cacheImg = require("path").join(PLAYER_CACHE_DIR, safeName + ".png");
  const cacheMeta = require("path").join(PLAYER_CACHE_DIR, safeName + ".json");

  if (fs.existsSync(cacheImg) && fs.statSync(cacheImg).size > 1000) {
    try { return await loadImage(fs.readFileSync(cacheImg)); } catch {}
  }

  // ═══ محاولات متعددة ═══
  const attempts = [];
  if (playerName) attempts.push({ type: "name", val: playerName });
  if (teamHint) attempts.push({ type: "team", val: teamHint });

  let finalResult = null;

  for (const att of attempts) {
    if (att.type === "name") {
      const r = await findPlayerImage(att.val, teamHint);
      if (r && r.url) { finalResult = r; break; }
    } else {
      // لو ماكو اسم → نستخدم التشكيلة
      const squad = await findPlayerFromSquad(att.val);
      if (squad && squad.imgUrl) {
        finalResult = { url: squad.imgUrl, source: "squad", matchedName: squad.name, hasCutout: squad.hasCutout };
        break;
      }
    }
  }

  if (!finalResult) {
    console.log("❌ ما لكيت صورة: " + keyForCache);
    return null;
  }

  try {
    let buf = Buffer.from(await (await fetch(finalResult.url, { headers: { "User-Agent": "MRBOT/1.0" } })).arrayBuffer());
    if (buf.length < 2000) return null;
    fs.writeFileSync(cacheImg, buf);
    fs.writeFileSync(cacheMeta, JSON.stringify({
      source: finalResult.source,
      matchedName: finalResult.matchedName,
      originalName: keyForCache,
      hasCutout: finalResult.hasCutout || false,
      size: buf.length,
      date: Date.now(),
    }));
    console.log("✅ " + keyForCache + " ← " + finalResult.matchedName + " (" + finalResult.source + ")");
    return await loadImage(buf);
  } catch (e) {
    console.log("❌ " + keyForCache + ": " + e.message);
    return null;
  }
}

// ═══ الدالة الرئيسية: 8 مصادر ═══
