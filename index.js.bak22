function buildList(items, type) {
  const title = type === "sticker" ? "🏷️ ستيكرات السيرفر" : "🙂 ايموجي السيرفر";
  const lines = items.slice(0, 60).map((it, i) => {
    const num = String(i + 1).padStart(2, "0");
    if (type === "sticker") return "`" + num + "` — " + it.name;
    return "`" + num + "` — " + it.toString() + " " + it.name;
  });
  const embed = new EmbedBuilder()
    .setColor(0x5865f2)
    .setTitle(title)
    .setDescription(
      "**عدد الكل:** " + items.length + "\n\n" +
      (lines.join("\n") || "ماكو شي 🤷‍♂️").slice(0, 3500) +
      "\n\n**📝 اكتب بالأرقام شنو تريد تحذف**\n" +
      "مثال: `1 3 5` أو `1,2,3`\n" +
      "أو اكتب `الكل` حتى تحذف كل شي."
    );
  return embed;
}

// ═══════════════════════════════════════════════
// 🔍 دوال جلب المحتوى من المنصات
// ═══════════════════════════════════════════════

async function safeFetch(url, opts) {
  try {
    const r = await fetch(url, { headers: { "User-Agent": "Mozilla/5.0 (compatible; MRBOT/2.0)" }, ...(opts || {}) });
    if (!r.ok) return null;
    return r;
  } catch (e) { return null; }
}

// ═══ YouTube ═══
async function checkYouTube(username) {
  try {
    // نجيب channel ID
    let url = username.startsWith("@") ? "https://www.youtube.com/@" + username.slice(1) : "https://www.youtube.com/c/" + encodeURIComponent(username);
    const r1 = await safeFetch(url);
    if (!r1) return null;
    const html = await r1.text();
    const idMatch = html.match(/"channelId":"(UC[^"]+)"/);
    if (!idMatch) return null;
    const channelId = idMatch[1];

    // نجيب آخر فيديو من RSS
    const r2 = await safeFetch("https://www.youtube.com/feeds/videos.xml?channel_id=" + channelId);
    if (!r2) return null;
    const xml = await r2.text();
    const videoMatch = xml.match(/<yt:videoId>([^<]+)<\/yt:videoId>/);
    const titleMatch = xml.match(/<title>([^<]+)<\/title>/g);
    const publishedMatch = xml.match(/<published>([^<]+)<\/published>/);
    if (!videoMatch) return null;
    const videoId = videoMatch[1];
    const title = titleMatch && titleMatch[1] ? titleMatch[1].replace(/<[^>]+>/g, "") : "فيديو جديد";
    return {
      type: "video",
      id: videoId,
      title: title,
      url: "https://youtube.com/watch?v=" + videoId,
      channelName: username,
    };
  } catch (e) { console.log("yt err:", e.message); return null; }
}

// ═══ Twitch ═══
async function checkTwitch(username) {
  try {
    const r = await safeFetch("https://decapi.me/twitch/uptime/" + username);
    if (!r) return null;
    const txt = (await r.text()).trim();
    if (txt.toLowerCase().includes("offline") || txt.toLowerCase().includes("error")) return null;
    // حي!
    const gameR = await safeFetch("https://decapi.me/twitch/game/" + username);
    const titleR = await safeFetch("https://decapi.me/twitch/title/" + username);
    const game = gameR ? (await gameR.text()).trim() : "؟";
    const title = titleR ? (await titleR.text()).trim() : "بث مباشر";
    return {
      type: "live",
      id: "twitch_" + username + "_" + Date.now(),
      title: title,
      game: game,
      url: "https://twitch.tv/" + username,
      channelName: username,
    };
  } catch (e) { return null; }
}

// ═══ Kick ═══
async function checkKick(username) {
  try {
    const r = await safeFetch("https://kick.com/api/v2/channels/" + username.toLowerCase());
    if (!r) return null;
    const j = await r.json();
    const isLive = j.livestream && j.livestream.is_live;
    if (!isLive) return null;
    return {
      type: "live",
      id: "kick_" + j.livestream.id,
      title: j.livestream.session_title || "بث مباشر",
      game: j.livestream.categories && j.livestream.categories[0] ? j.livestream.categories[0].name : "؟",
      url: "https://kick.com/" + username,
      channelName: j.slug || username,
      viewers: j.livestream.viewer_count,
    };
  } catch (e) { return null; }
}

// ═══ Rumble ═══
async function checkRumble(username) {
  try {
    const r = await safeFetch("https://rumble.com/c/" + username);
    if (!r) return null;
    const html = await r.text();
    const match = html.match(/"video_id":(\d+)/) || html.match(/href="(\/v[^"]+)"/);
    if (!match) return null;
    const path = match[1].startsWith("/") ? match[1] : null;
    if (!path) return null;
    const titleM = html.match(/<title>([^<]+)<\/title>/);
    const title = titleM ? titleM[1].split("|")[0].trim() : "فيديو جديد";
    return {
      type: "video",
      id: "rumble_" + path,
      title: title,
      url: "https://rumble.com" + path,
      channelName: username,
    };
  } catch (e) { return null; }
}

// ═══ Odysee ═══
async function checkOdysee(username) {
  try {
    const r = await safeFetch("https://odysee.com/$/rss/@" + username);
    if (!r) return null;
    const xml = await r.text();
    const idM = xml.match(/<guid[^>]*>([^<]+)<\/guid>/);
    const titleM = xml.match(/<title>([^<]+)<\/title>/);
    if (!idM) return null;
    const url = xml.match(/<link>([^<]+)<\/link>/);
    return {
      type: "video",
      id: idM[1],
      title: titleM ? titleM[1] : "فيديو جديد",
      url: url ? url[1] : "https://odysee.com/@" + username,
      channelName: username,
    };
  } catch (e) { return null; }
}

// ═══ Trovo ═══
async function checkTrovo(username) {
  try {
    const r = await safeFetch("https://api.trovo.live/page/liveinfo", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ username }),
    });
    if (!r) return null;
    const j = await r.json();
    if (!j || !j.live_info || !j.live_info.live_title) return null;
    return {
      type: "live",
      id: "trovo_" + username + "_" + j.live_info.started_at,
      title: j.live_info.live_title,
      game: j.live_info.category_name || "؟",
      url: "https://trovo.live/" + username,
      channelName: username,
    };
  } catch (e) { return null; }
}

// ═══ TikTok ═══
async function checkTikTokV2(username) {
  try {
    const key = process.env.OMKAR_API_KEY;
    if (!key) { console.log("❌ ماكو OMKAR_API_KEY"); return null; }

    const url = "https://tiktok-scraper.omkar.cloud/tiktok/users/videos?handle=" + encodeURIComponent(username) + "&max_results=10";
    const r = await fetch(url, {
      headers: { "API-Key": key },
    });

    if (!r.ok) {
      const txt = await r.text();
      console.log("❌ TikWM API: " + r.status + " — " + txt.slice(0, 100));
      return null;
    }

    const j = await r.json();
    const videos = j.videos || [];

    // ═══ 1) بث مباشر ═══
    // هذا الـ API ما يعطي معلومات البث، نتحقق من صفحة TikTok مباشرة
    try {
      const rLive = await fetch("https://www.tiktok.com/@" + username, {
        headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" },
      });
      if (rLive.ok) {
        const html = await rLive.text();
        const uniMatch = html.match(/<script id="__UNIVERSAL_DATA_FOR_REHYDRATION__"[^>]*>([\s\S]*?)<\/script>/);
        if (uniMatch) {
          try {
            const data = JSON.parse(uniMatch[1]);
            const userInfo = data["__DEFAULT_SCOPE__"]?.["webapp.user-detail"]?.userInfo;
            if (userInfo && userInfo.user.isLive) {
              return {
                type: "live",
                id: "tiktok_live_" + username + "_" + (userInfo.user.roomId || "live"),
                title: "بث مباشر على TikTok",
                url: "https://www.tiktok.com/@" + username + "/live",
                channelName: userInfo.user.nickname || username,
                allIds: [],
              };
            }
          } catch (e) {}
        }
      }
    } catch (e) {}

    // ═══ 2) فيديوهات ═══
    if (videos.length === 0) return null;

    const sorted = [...videos].sort((a, b) => (b.created_at || 0) - (a.created_at || 0));
    const ids = sorted.map((v) => String(v.video_id));

    const newest = sorted[0];

    return {
      type: "video",
      id: "tiktok_" + newest.video_id,
      title: newest.caption || "فيديو جديد على TikTok",
      url: "https://www.tiktok.com/@" + username + "/video/" + newest.video_id,
      channelName: newest.author?.handle || username,
      allIds: ids,
      cover: newest.media?.video_url ? null : null,
    };
  } catch (e) {
    console.log("tiktok err:", e.message);
    return null;
  }
}

async function checkTikTok(username) {
  return await checkTikTokV2(username);
}

async function checkInstagram(username) {
  try {
    const r = await safeFetch("https://www.instagram.com/" + username + "/?__a=1&__d=dis");
    if (!r) return null;
    const j = await r.json();
    const post = j.graphql && j.graphql.user && j.graphql.user.edge_owner_to_timeline_media && j.graphql.user.edge_owner_to_timeline_media.edges[0];
    if (!post) return null;
    const shortcode = post.node.shortcode;
    return {
      type: "video",
      id: "ig_" + shortcode,
      title: "منشور جديد على Instagram",
      url: "https://www.instagram.com/p/" + shortcode + "/",
      channelName: username,
    };
  } catch (e) { return null; }
}

// ═══ Twitter/X ═══
async function checkTwitter(username) {
  try {
    // نستخدم Nitter instances
    const instances = ["nitter.net", "nitter.privacydev.net", "nitter.poast.org"];
    for (const host of instances) {
      const r = await safeFetch("https://" + host + "/" + username + "/rss");
      if (!r) continue;
      const xml = await r.text();
      const idM = xml.match(/<guid[^>]*>([^<]+)<\/guid>/);
      if (!idM) continue;
      const titleM = xml.match(/<title>([^<]+)<\/title>/);
      return {
        type: "tweet",
        id: "tw_" + idM[1],
        title: titleM ? titleM[1].replace(/<[^>]+>/g, "").slice(0, 200) : "تغريدة جديدة",
        url: idM[1],
        channelName: username,
      };
    }
    return null;
  } catch (e) { return null; }
}

// ═══ Facebook ═══
async function checkFacebook(username) {
  try {
    // ما في طريقة موثوقة بدون API — نحاول RSS عبر rsshub
    const r = await safeFetch("https://rsshub.app/facebook/page/" + username);
    if (!r) return null;
    const xml = await r.text();
    const idM = xml.match(/<guid[^>]*>([^<]+)<\/guid>/);
    if (!idM) return null;
    const titleM = xml.match(/<title>([^<]+)<\/title>/);
    return {
      type: "post",
      id: "fb_" + idM[1],
      title: titleM ? titleM[1] : "منشور جديد",
      url: idM[1],
      channelName: username,
    };
  } catch (e) { return null; }
}

async function checkPlatform(platform, username) {
  const checkers = {
    youtube: checkYouTube,
    twitch: checkTwitch,
    kick: checkKick,
    tiktok: checkTikTok,
  };
  const fn = checkers[platform];
  if (!fn) return null;
  return await fn(username);
}

async function checkNotifications() {
  if (!notifData.subs || !notifData.subs.length) return;
  console.log("📢 فحص الإشعارات (" + notifData.subs.length + ")...");

  for (const sub of notifData.subs) {
    try {
      const result = await checkPlatform(sub.platform, sub.username);
      if (!result) continue;

      // ═══ 1) أول مرة — نحفظ بدون إرسال ═══
      if (!sub.lastContentId) {
        console.log("🆕 أول حفظ: " + sub.username + " → " + result.id);
        sub.lastContentId = result.id;
        if (result.allIds && result.allIds.length) sub.knownIds = result.allIds;
        saveNotifData();
        continue;
      }

      // ═══ 2) للبث — نقارن بـ lastContentId فقط ═══
      if (result.type === "live") {
        if (sub.lastContentId === result.id) continue;
        sub.lastContentId = result.id;
        saveNotifData();
      } else {
        // ═══ 3) للفيديو — نستخدم knownIds ═══
        const known = sub.knownIds || [sub.lastContentId.replace("tiktok_", "")];
        const currentIds = result.allIds || [result.id.replace("tiktok_", "")];

        // نلگى أي ID جديد
        const newIds = currentIds.filter((id) => !known.includes(id));
        if (newIds.length === 0) continue;

        // نرسل أول واحد فقط (الأحدث)
        const newestId = newIds[0];
        console.log("🆕 فيديو جديد: " + sub.username + " → " + newestId);

        sub.lastContentId = "tiktok_" + newestId;
        sub.knownIds = currentIds;
        saveNotifData();

        // نحدث النتيجة
        result.id = "tiktok_" + newestId;
        result.url = "https://www.tiktok.com/@" + sub.username + "/video/" + newestId;
      }

      // ═══ 4) نرسل الإشعار ═══
      const p = getPlatform(sub.platform);
      const guild = client.guilds.cache.get(GUILD_ID);
      if (!guild) continue;
      const ch = guild.channels.cache.get(sub.channelId) || await guild.channels.fetch(sub.channelId).catch(() => null);
      if (!ch) continue;

      const isLive = result.type === "live";
      const embed = new EmbedBuilder()
        .setColor(p ? p.color : 0x5865f2)
        .setAuthor({ name: (p ? p.emoji + " " + p.name : "منصة") + " • " + (isLive ? "بث مباشر" : "محتوى جديد") })
        .setTitle((isLive ? "🔴 مباشر الآن! " : "🎬 ") + result.title.slice(0, 200))
        .setURL(result.url)
        .setDescription(
          "**" + (p ? p.emoji : "") + " " + result.channelName + "**\n\n" +
          (isLive && result.game ? "🎮 **اللعبة:** " + result.game + "\n" : "") +
          (isLive && result.viewers ? "👁️ **المشاهدين:** " + result.viewers + "\n" : "") +
          "\n" + (isLive ? "**[🎥 ادخل للبث](" + result.url + ")**" : "**[▶️ شاهد الفيديو](" + result.url + ")**")
        )
        .setFooter({ text: "MRBOT Notifications" })
        .setTimestamp();

      const content = buildNotifContent(sub);
      await ch.send({ content: content, embeds: [embed] }).catch(() => {});
      console.log("✅ أرسلت إشعار: " + sub.username + " (" + sub.platform + ")");
    } catch (e) {
      console.log("notif err [" + sub.username + "]: " + e.message);
    }
    await new Promise((r) => setTimeout(r, 2000));
  }
}

async function updateLiveMatches() {
  if (!autoData.matches || !autoData.matches.length) return;
  const now = Date.now();

  for (const m of autoData.matches) {
    // نتجاهل اللي ما بدأت بعد أو اللي منتهية من زمان
    if (!m.fixtureId) continue;
    if (now < m.startTime - 5 * 60 * 1000) continue; // قبل بداية المباراة بـ5 دقائق
    if (now > m.startTime + 4 * 3600 * 1000) continue; // بعد 4 ساعات (خلصت)
    if (!m.channelId || !m.messageId) continue;

    try {
      const live = await fetchLiveFixture(m.fixtureId);
      if (!live) continue;

      // نتحقق إذا في تغيير
      const oldStatus = m.liveData ? m.liveData.status : null;
      const oldHome = m.liveData ? m.liveData.homeScore : null;
      const oldAway = m.liveData ? m.liveData.awayScore : null;
      const oldElapsed = m.liveData ? m.liveData.elapsed : null;

      const changed = (
        oldStatus !== live.status ||
        oldHome !== live.homeScore ||
        oldAway !== live.awayScore ||
        Math.abs((oldElapsed || 0) - (live.elapsed || 0)) >= 1
      );

      if (!changed) continue;

      m.liveData = live;

      // إذا المباراة بدأت → نقفل التوقع
      if (live.status !== "NS" && !m.closed) {
        m.closed = true;
        console.log("🔴 بدأت المباراة — أقفلت التوقع: " + m.team1 + " vs " + m.team2);
      }

      // نحدث المنشور
      const guild = client.guilds.cache.get(GUILD_ID);
      if (guild) {
        const ch = guild.channels.cache.get(m.channelId) || await guild.channels.fetch(m.channelId).catch(() => null);
        if (ch) {
          const msg = await ch.messages.fetch(m.messageId).catch(() => null);
          if (msg) {
            const options = {
              embeds: [buildMatchEmbed(m)],
              components: m.closed ? [] : [new ActionRowBuilder().addComponents(
                new ButtonBuilder().setCustomId("predict_btn_" + m.id).setLabel("خمن النتيجة").setEmoji("🎯").setStyle(ButtonStyle.Primary)
              )],
            };
            await msg.edit(options).catch(() => {});
            console.log("🔄 حدثت: " + m.team1 + " " + live.homeScore + "-" + live.awayScore + " " + m.team2 + " (" + live.status + " " + (live.elapsed || "") + "')");
          }
        }
      }
      saveAutoData();
    } catch (e) {
      console.log("live update err: " + e.message);
    }
    await new Promise((r) => setTimeout(r, 1500));
  }
}

client.once("ready", async () => {
  // ═══ Scheduler المباريات التلقائية ═══
  if (!global.AUTO_MATCHES_SCHEDULER) {
    global.AUTO_MATCHES_SCHEDULER = true;

    // أول تشغيل: تحديث فوري
    setTimeout(async () => {
      if (autoData.channelId) {
        try { await refreshAutoMatches(true); } catch (e) { console.log("init fetch err:", e.message); }
      }
    }, 5000);

    // ═══ Scheduler الإشعارات (كل 5 دقائق) ═══
    if (!global.NOTIF_SCHEDULER_RUNNING) {
      global.NOTIF_SCHEDULER_RUNNING = true;
      setTimeout(async () => {
        try { await checkNotifications(); } catch (e) { console.log("notif init err:", e.message); }
      }, 15000);
      setInterval(async () => {
        try { await checkNotifications(); } catch (e) { console.log("notif sched err:", e.message); }
      }, 5 * 60 * 1000);
      console.log("📢 Scheduler الإشعارات شغال (كل 5 دقائق)");
    }

    // كل 5 دقائق: نحدث المباريات الحية
    setInterval(async () => {
      try { await updateLiveMatches(); } catch (e) { console.log("live sched err:", e.message); }
    }, 30000);

    // كل 5 دقائق: نرسل المباريات المستحقة
    setInterval(async () => {
      if (!autoData.channelId || autoData.matches.length === 0) return;
      const now = Date.now();
      for (const m of autoData.matches) {
        // إرسال قبل ساعتين
        const sendAt = m.startTime - 2 * 3600 * 1000;
        if (!m.sentAt && now >= sendAt && now < m.startTime) {
          try {
            const guild = client.guilds.cache.get(GUILD_ID) || await client.guilds.fetch(GUILD_ID).catch(() => null);
            if (!guild) continue;
            const ch = guild.channels.cache.get(m.channelId) || await guild.channels.fetch(m.channelId).catch(() => null);
            if (!ch) continue;
            const msg = await sendMatchCard(ch, m, true);
            m.sentAt = Date.now();
            m.messageId = msg.id;
            saveAutoData();
            console.log("✅ أرسلت: " + m.team1 + " vs " + m.team2);
          } catch (e) { console.log("send err:", e.message); }
        }
        // إغلاق بعد بدء المباراة
        if (!m.closed && now >= m.startTime) {
          m.closed = true;
          saveAutoData();
          try {
            const guild = client.guilds.cache.get(GUILD_ID);
            if (guild && m.channelId && m.messageId) {
              const ch = guild.channels.cache.get(m.channelId) || await guild.channels.fetch(m.channelId).catch(() => null);
              if (ch) await editMatchCard(ch, m.messageId, m, false);
            }
          } catch (e) {}
        }
      }
    }, 30000);

    // كل 6 ساعات: تحديث المباريات
    setInterval(async () => {
      if (!autoData.channelId) return;
      try { await refreshAutoMatches(false); } catch (e) { console.log("refresh err:", e.message); }
    }, 6 * 3600 * 1000);

    console.log("⚽ Scheduler المباريات التلقائية شغال");
  }

  // ═══ scheduler المباريات ═══
  if (!global.MATCH_SCHEDULER_RUNNING) {
    global.MATCH_SCHEDULER_RUNNING = true;
    setInterval(async () => {
      const now = Date.now();
      for (const match of matchesData.matches) {
        // إرسال قبل ساعتين
        const sendAt = match.startTime - 2 * 60 * 60 * 1000;
        if (!match.sentAt && now >= sendAt && now < match.startTime) {
          try {
            const guild = client.guilds.cache.get(GUILD_ID) || await client.guilds.fetch(GUILD_ID).catch(() => null);
            if (!guild) continue;
            const ch = guild.channels.cache.get(match.channelId) || await guild.channels.fetch(match.channelId).catch(() => null);
            if (!ch) { console.log("match ch err: " + match.channelId); continue; }
            const msg = await sendMatchCard(ch, match, true);
            match.sentAt = Date.now();
            match.messageId = msg.id;
            saveMatchesData();
            console.log("✅ أرسلت مباراة: " + match.team1 + " vs " + match.team2);
          } catch (e) { console.log("match send err:", e.message); }
        }
        // إغلاق عند بداية المباراة
        if (!match.closed && now >= match.startTime) {
          match.closed = true;
          saveMatchesData();
          try {
            const guild = client.guilds.cache.get(GUILD_ID);
            if (guild && match.channelId && match.messageId) {
              const ch = guild.channels.cache.get(match.channelId) || await guild.channels.fetch(match.channelId).catch(() => null);
              if (ch) await editMatchCard(ch, match.messageId, match, false);
            }
            console.log("🔴 أقفلت التوقع: " + match.team1 + " vs " + match.team2);
          } catch (e) { console.log("match close err:", e.message); }
        }
      }
    }, 30000);
    console.log("⏰ scheduler المباريات شغال (كل 5 دقائق)");
  }

  // ────────── فحص سريع عند البدء ──────────
  const C = { g: "\x1b[32m", y: "\x1b[33m", r: "\x1b[31m", c: "\x1b[36m", x: "\x1b[0m" };
  console.log(C.c + "\n🔍 فحص أولي..." + C.x);
  try {
    const fsx = require("fs");
    const px = require("path");
    const checks = [];
    checks.push(fsx.existsSync(px.join(__dirname, ".env")) ? C.g + "✅ .env" : C.r + "❌ .env");
    checks.push(process.env.BOT_TOKEN && process.env.BOT_TOKEN.length > 60 ? C.g + "✅ Token" : C.r + "❌ Token");
    checks.push(process.env.GIPHY_KEY ? C.g + "✅ Giphy" : C.y + "⚠️ Giphy");
    console.log("   " + checks.join(" | ") + C.x);
    logger.info("startup", "البوت بدأ", { tag: client.user.tag, guilds: client.guilds.cache.size });
  } catch (e) { console.log(C.r + "فحص فاشل: " + e.message + C.x); }

  console.log("✅ " + client.user.tag + " شغال الحين");
  const allUsers = [...ALLOWED, ...members.keys()];
  for (const uid of allUsers) {
    try {
      const user = await client.users.fetch(uid);
      const dm = await user.createDM();
      await dm.send(mainPanel(uid));
      console.log("📩 دزيت اللوحة لـ " + user.tag);
    } catch (e) {
      console.log("⚠️ ما كدرت ادز لـ " + uid + ": " + e.message);
    }
  }
});

async function sendOnboardingQuestion(dmChannel, userId) {
  const session = onboardingSessions.get(userId);
  if (!session) return;
  const q = onboarding.questions[session.step];
  if (!q) {
    await dmChannel.send("🎉 **خلصنا!** تم إعطائك كل الأدوار.\nأهلاً بيك في السيرفر 💙").catch(() => {});
    onboardingSessions.delete(userId);
    return;
  }
  const embed = new EmbedBuilder()
    .setColor(0x9b59b6)
    .setTitle("❓ " + q.text)
    .setDescription("اختار من الأزرار:")
    .setFooter({ text: "سؤال " + (session.step + 1) + " من " + onboarding.questions.length });
  const btns = q.options.map((o, j) =>
    new ButtonBuilder()
      .setCustomId("onb_ans_" + session.step + "_" + j)
      .setLabel(o.label)
      .setStyle(ButtonStyle.Primary)
      .setEmoji(o.emoji || null)
  );
  const rows = [];
  for (let i = 0; i < btns.length; i += 5) {
    rows.push(new ActionRowBuilder().addComponents(btns.slice(i, i + 5)));
  }
  await dmChannel.send({ embeds: [embed], components: rows }).catch(() => {});
}

client.on("guildMemberAdd", async (member) => {
  return; // ⛔ النظام معطّل — نستخدم Onboarding الأصلي مال ديسكورد
  if (member.guild.id !== GUILD_ID) return;
  if (!onboarding.enabled || !onboarding.questions.length) return;

  const userId = member.id;
  onboardingSessions.set(userId, { step: 0, answers: [] });

  try {
    const dm = await member.createDM();
    await dm.send("🎉 هلا بيك في **" + member.guild.name + "**!\n\nجاوب على " + onboarding.questions.length + " سؤال سريع حتى نعطيك أدوارك:");
    await new Promise((r) => setTimeout(r, 500));
    await sendOnboardingQuestion(dm, userId);
  } catch (e) {
    console.log("⚠️ ما كدرت ادز للعضو " + member.user.tag + ": " + e.message);
  }
});

client.on("messageCreate", async (message) => {
  if (message.author.bot) return;
  if (!isAllowed(message.author.id)) return;

  if (!message.guild) {
    if (paused) return;
    const uid = message.author.id;
    const txt = message.content.trim();
    const ps = sessions.get(uid);

    if (ps && ps.mode === "awaiting_member_id") {
      const mid = txt.replace(/[^0-9]/g, "");
      if (mid.length < 17 || mid.length > 20) return message.reply("✍️ اكتب ID صحيح (17-20 رقم)");
      if (ALLOWED.includes(mid) || members.has(mid)) return message.reply("ℹ️ مضاف أصلاً");
      let target;
      try { target = await client.users.fetch(mid); } catch { return message.reply("❌ ما لكيت العضو"); }
      ps.pendingMember = { id: mid, tag: target.tag || target.username, features: ["convert","delete","giphy"] };
      ps.mode = "awaiting_member_features";
      sessions.set(uid, ps);
      return message.reply(buildMemberPanel(ps.pendingMember));
    }

    // ---- نظام الاختيارات: نص السؤال ----
    if (ps && ps.mode === "onb_q_text") {
      const q = txt.trim();
      if (q.length < 3 || q.length > 200) return message.reply("✍️ اكتب سؤال (3-200 حرف)");
      ps.onbQuestion = q;
      ps.mode = "onb_choices";
      sessions.set(uid, ps);
      return message.reply(
        "✅ السؤال: **" + q + "**\n\n" +
        "هسه دزلي الخيارات. **كل سطر = خيار** بالشكل:\n" +
        "\`\`\`\n" +
        "ولد | 123456789012345678 | 💙\n" +
        "بنت | 987654321098765432 | 💗\n" +
        "\`\`\`\n" +
        "الترتيب: **الاسم | ID الدور | إيموجي (اختياري)**"
      );
    }

    // ---- نظام الاختيارات: الخيارات ----
    if (ps && ps.mode === "onb_choices") {
      const lines = txt.split("\n").map((x) => x.trim()).filter(Boolean);
      if (lines.length < 2) return message.reply("✍️ اكتب خيارين على الأقل، كل سطر خيار");
      if (lines.length > 5) return message.reply("✍️ الحد الأقصى 5 خيارات");
      const options = [];
      const errors = [];
      for (const line of lines) {
        const parts = line.split("|").map((x) => x.trim());
        if (parts.length < 2) { errors.push("❌ ناقص شي: " + line); continue; }
        const [label, roleId, emoji] = parts;
        if (!/^\d{17,20}$/.test(roleId)) { errors.push("❌ ID غلط: " + line); continue; }
        // نتأكد من الدور موجود بالسيرفر
        let guild = client.guilds.cache.get(GUILD_ID);
        if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
        if (!guild) { errors.push("❌ ما كدرت اوصل للسيرفر"); break; }
        const role = guild.roles.cache.get(roleId) || await guild.roles.fetch(roleId).catch(() => null);
        if (!role) { errors.push("❌ ما لكيت الدور: " + roleId); continue; }
        options.push({ label: label.slice(0, 80), roleId, emoji: emoji || null });
      }
      if (errors.length) return message.reply(errors.join("\n").slice(0, 1900));
      if (options.length < 2) return message.reply("✍️ لازم خيارين صحيحة على الأقل");

      ps.onbOptions = options;
      ps.mode = "onb_confirm";
      sessions.set(uid, ps);

      let summary = "📝 **السؤال:** " + ps.onbQuestion + "\n\n**الخيارات:**\n";
      options.forEach((o, i) => {
        summary += (i + 1) + ") " + (o.emoji || "") + " " + o.label + " → \`" + o.roleId + "\`\n";
      });
      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("onb_save").setLabel("حفظ").setEmoji("💾").setStyle(ButtonStyle.Success),
        new ButtonBuilder().setCustomId("onb_cancel").setLabel("إلغاء").setEmoji("✖️").setStyle(ButtonStyle.Danger)
      );
      return message.reply({ content: summary, components: [row] });
    }

    // ---- إنشاء رتب: استقبال الأسماء ----
    if (ps && ps.mode === "awaiting_role_names") {
      let names = txt.split(/[\n,،]+/).map((x) => x.trim()).filter(Boolean);
      names = [...new Set(names)];
      if (names.length === 0) return message.reply("✍️ اكتب أسماء رتب");
      if (names.length > 30) return message.reply("⚠️ الحد الأقصى 30 رتبة. عندك " + names.length);

      const wait = await message.reply("⏳ جاري إنشاء " + names.length + " رتبة...");

      let guild = client.guilds.cache.get(GUILD_ID);
      if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
      if (!guild) return wait.edit("❌ ما كدرت اوصل للسيرفر");

      const results = [];
      let ok = 0, fail = 0;

      for (const name of names) {
        const safeName = name.slice(0, 100);
        if (guild.roles.cache.find((r) => r.name === safeName)) {
          fail++;
          results.push("⚠️ موجودة أصلاً: **" + safeName + "**");
          continue;
        }
        try {
          const role = await guild.roles.create({
            name: safeName,
            color: 0x99aab5,
            reason: "إنشاء تلقائي من البوت",
          });
          ok++;
          results.push("✅ " + role.name);
        } catch (e) {
          fail++;
          results.push("❌ " + safeName + ": " + e.message.split("\n")[0].slice(0, 80));
        }
        await new Promise((r) => setTimeout(r, 400));
      }

      sessions.delete(uid);

      const e2 = new EmbedBuilder()
        .setColor(fail > 0 ? 0xffaa00 : 0x57f287)
        .setTitle("🎭 نتيجة إنشاء الرتب")
        .setDescription(
          "🌍 السيرفر: **" + guild.name + "**\n" +
          "✅ نجح: **" + ok + "**\n" +
          "❌ فشل: **" + fail + "**\n\n" +
          results.join("\n").slice(0, 3500)
        )
        .setFooter({ text: "MRBOT" });

      return wait.edit({ content: "", embeds: [e2] });
    }

    // ═══ الرومات: استقبال إضافة ═══
    if (ps && ps.mode === "awaiting_channel_list") {
      const lines = txt.split("\n").map((l) => l.trim()).filter(Boolean);
      if (lines.length === 0) return message.reply("✍️ اكتب قائمة");
      if (lines.length > 40) return message.reply("⚠️ الحد 40 سطر");
      const categories = [];
      const channels = [];
      let currentCat = null;
      for (const line of lines) {
        if (line.startsWith("!")) {
          const name = line.slice(1).trim().slice(0, 100);
          if (!name) continue;
          currentCat = { name, channels: [] };
          categories.push(currentCat);
        } else if (line.startsWith(".")) {
          const name = line.slice(1).trim().slice(0, 100);
          if (!name) continue;
          if (currentCat) currentCat.channels.push({ name });
          else channels.push({ name });
        }
      }
      if (categories.length === 0 && channels.length === 0) {
        return message.reply("⚠️ لازم يبدأ السطر بـ \`!\` أو \`.\`");
      }
      ps.pendingChannels = { categories, channels };
      ps.mode = "channels_confirm";
      sessions.set(uid, ps);
      const preview = buildChannelPreview(channels, categories);
      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("channels_save").setLabel("حفظ وإنشاء").setEmoji("✅").setStyle(ButtonStyle.Success),
        new ButtonBuilder().setCustomId("channels_cancel").setLabel("إلغاء").setEmoji("✖️").setStyle(ButtonStyle.Danger)
      );
      return message.reply({ embeds: [preview], components: [row] });
    }

    // ═══ الرومات: حذف بالأرقام ═══
    if (ps && ps.mode === "channels_delete_list" && ps.data) {
      const { cats, orphans, guild } = ps.data;

      if (txt.trim().startsWith("كل ")) {
        const n = parseInt(txt.trim().slice(3));
        const cat = cats.find((c) => c.idx === n);
        if (!cat || cat.rooms.length === 0) return message.reply("❌ ماكو رومات بالقناة " + n);
        let ok = 0, fail = 0;
        for (const r of cat.rooms) {
          try {
            const ch = guild.channels.cache.get(r.id) || await guild.channels.fetch(r.id).catch(() => null);
            if (ch) { await ch.delete("حذف من البوت"); ok++; }
          } catch { fail++; }
          await new Promise((rr) => setTimeout(rr, 500));
        }
        cat.rooms = [];
        sessions.set(uid, ps);
        return message.reply({
          content: "🗑️ حذفت **" + ok + "** من القناة **" + cat.name + "**" + (fail ? " | فشل: " + fail : ""),
          embeds: [buildChannelsTree(ps.data, "🗑️ حذف رومات", 0xe74c3c)],
        });
      }

      const pairs = [...txt.matchAll(/(\d+)\s*[:：]\s*(\d+)/g)].map((mm) => ({ cat: parseInt(mm[1]), room: parseInt(mm[2]) }));
      if (pairs.length === 0) return message.reply("✍️ اكتب مثل \`1:2\` أو \`1:2 3:1\`");

      let ok = 0, fail = 0;
      const results = [];
      for (const p of pairs) {
        let target = null;
        if (p.cat === 0) target = orphans.find((r) => r.roomIdx === p.room);
        else { const cat = cats.find((c) => c.idx === p.cat); if (cat) target = cat.rooms.find((r) => r.roomIdx === p.room); }
        if (!target) { fail++; results.push("❌ " + p.cat + ":" + p.room); continue; }
        try {
          const ch = guild.channels.cache.get(target.id) || await guild.channels.fetch(target.id).catch(() => null);
          if (!ch) { fail++; results.push("❌ " + target.name); continue; }
          await ch.delete("حذف من البوت");
          ok++;
          results.push("✅ " + target.name);
          if (p.cat === 0) { const i = orphans.indexOf(target); if (i > -1) orphans.splice(i, 1); }
          else {
            const cat = cats.find((c) => c.idx === p.cat);
            if (cat) { const i = cat.rooms.indexOf(target); if (i > -1) cat.rooms.splice(i, 1); cat.rooms.forEach((r, i) => r.roomIdx = i + 1); }
          }
        } catch (e) { fail++; results.push("❌ " + target.name + ": " + e.message.slice(0, 60)); }
        await new Promise((rr) => setTimeout(rr, 500));
      }

      sessions.set(uid, ps);
      if (cats.every((c) => c.rooms.length === 0) && orphans.length === 0) {
        sessions.delete(uid);
        return message.reply("🗑️ **خلصنا!**\n✅ **" + ok + "** | ❌ **" + fail + "**\n\n" + results.join("\n").slice(0, 3000));
      }
      return message.reply({
        content: "📊 ✅ **" + ok + "** | ❌ **" + fail + "**\n" + results.join("\n").slice(0, 1000),
        embeds: [buildChannelsTree(ps.data, "🗑️ حذف رومات", 0xe74c3c)],
      });
    }

    // ═══ الرومات: تعديل ═══
    if (ps && ps.mode === "channels_edit" && ps.data) {
      const { cats, orphans, guild } = ps.data;
      const lines = txt.split("\n").map((l) => l.trim()).filter(Boolean);
      if (lines.length === 0) return message.reply("✍️ اكتب صيغة تعديل");
      const results = [];
      let ok = 0, fail = 0;

      for (const line of lines) {
        if (/^del!\s+\d+/.test(line)) {
          const n = parseInt(line.match(/\d+/)[0]);
          const cat = cats.find((c) => c.idx === n);
          if (!cat) { fail++; results.push("❌ قناة " + n); continue; }
          try {
            const ch = guild.channels.cache.get(cat.id) || await guild.channels.fetch(cat.id).catch(() => null);
            if (ch) { await ch.delete("حذف من البوت"); ok++; results.push("🗑️ حذف قناة: " + cat.name); cats.splice(cats.indexOf(cat), 1); cats.forEach((c, i) => c.idx = i + 1); }
          } catch (e) { fail++; results.push("❌ " + cat.name); }
          await new Promise((r) => setTimeout(r, 500));
          continue;
        }
        if (/^del\s+\d+\s*[:：]\s*\d+/.test(line)) {
          const mm = line.match(/(\d+)\s*[:：]\s*(\d+)/);
          const p = { cat: parseInt(mm[1]), room: parseInt(mm[2]) };
          let target = null;
          if (p.cat === 0) target = orphans.find((r) => r.roomIdx === p.room);
          else { const cat = cats.find((c) => c.idx === p.cat); if (cat) target = cat.rooms.find((r) => r.roomIdx === p.room); }
          if (!target) { fail++; results.push("❌ " + p.cat + ":" + p.room); continue; }
          try {
            const ch = guild.channels.cache.get(target.id) || await guild.channels.fetch(target.id).catch(() => null);
            if (ch) { await ch.delete("حذف من البوت"); ok++; results.push("🗑️ " + target.name); }
            if (p.cat === 0) orphans.splice(orphans.indexOf(target), 1);
            else { const cat = cats.find((c) => c.idx === p.cat); cat.rooms.splice(cat.rooms.indexOf(target), 1); cat.rooms.forEach((r, i) => r.roomIdx = i + 1); }
          } catch (e) { fail++; results.push("❌ " + target.name); }
          await new Promise((r) => setTimeout(r, 500));
          continue;
        }
        if (/^!\d+\s+/.test(line)) {
          const mm = line.match(/^!(\d+)\s+(.+)$/);
          const n = parseInt(mm[1]);
          const newName = mm[2].trim().slice(0, 100);
          const cat = cats.find((c) => c.idx === n);
          if (!cat) { fail++; results.push("❌ قناة " + n); continue; }
          try {
            const ch = guild.channels.cache.get(cat.id) || await guild.channels.fetch(cat.id).catch(() => null);
            if (ch) { await ch.setName(newName); cat.name = newName; ok++; results.push("✏️ " + newName); }
          } catch (e) { fail++; results.push("❌ " + cat.name); }
          await new Promise((r) => setTimeout(r, 500));
          continue;
        }
        const mm = line.match(/^(\d+)\s*[:：]\s*(\d+)\s+(.+)$/);
        if (mm) {
          const p = { cat: parseInt(mm[1]), room: parseInt(mm[2]) };
          const newName = mm[3].trim().slice(0, 100);
          let target = null;
          if (p.cat === 0) target = orphans.find((r) => r.roomIdx === p.room);
          else { const cat = cats.find((c) => c.idx === p.cat); if (cat) target = cat.rooms.find((r) => r.roomIdx === p.room); }
          if (!target) { fail++; results.push("❌ " + p.cat + ":" + p.room); continue; }
          try {
            const ch = guild.channels.cache.get(target.id) || await guild.channels.fetch(target.id).catch(() => null);
            if (ch) { await ch.setName(newName); target.name = newName; ok++; results.push("✏️ " + newName); }
          } catch (e) { fail++; results.push("❌ " + target.name); }
          await new Promise((r) => setTimeout(r, 500));
          continue;
        }
        fail++;
        results.push("❌ صيغة غلط: " + line.slice(0, 40));
      }

      sessions.set(uid, ps);
      return message.reply({
        content: "📊 ✅ **" + ok + "** | ❌ **" + fail + "**\n" + results.join("\n").slice(0, 1500),
        embeds: [buildChannelsTree(ps.data, "✏️ تعديل الرومات", 0xf39c12)],
      });
    }

    // ═══ الإرسال الجماعي: استقبال الرسالة ═══
    if (ps && ps.mode === "broadcast_text") {
      if (!txt || txt.length < 2) return message.reply("✍️ اكتب رسالة (حرفين على الأقل)");
      if (txt.length > 2000) return message.reply("⚠️ الحد 2000 حرف");

      ps.broadcastMsg = txt;
      ps.mode = "broadcast_confirm";
      sessions.set(uid, ps);

      const preview = new EmbedBuilder()
        .setColor(0xe74c3c)
        .setTitle("📢 معاينة الرسالة")
        .setDescription(txt.slice(0, 1900))
        .setFooter({ text: "الرسالة راح ترسل لكل الأعضاء" });

      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("bc_send").setLabel("إرسال للكل").setEmoji("📢").setStyle(ButtonStyle.Danger),
        new ButtonBuilder().setCustomId("bc_cancel").setLabel("إلغاء").setEmoji("✖️").setStyle(ButtonStyle.Secondary)
      );
      return message.reply({ embeds: [preview], components: [row] });
    }

    // ═══ المباريات التلقائية: تحديد الروم ═══
    if (ps && ps.mode === "auto_set_channel") {
      const cid = txt.replace(/[^0-9]/g, "");
      if (!/^\d{17,20}$/.test(cid)) return message.reply("✍️ اكتب ID روم صحيح (17-20 رقم)");
      let guild = client.guilds.cache.get(GUILD_ID);
      if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
      if (!guild) return message.reply("❌ ما كدرت اوصل للسيرفر");
      const ch = guild.channels.cache.get(cid) || await guild.channels.fetch(cid).catch(() => null);
      if (!ch) return message.reply("❌ ما لكيت هذا الروم");
      autoData.channelId = cid;
      saveAutoData();
      sessions.delete(uid);
      await message.reply("✅ تم تحديد الروم: <#" + cid + ">\n\n🔄 جاري جلب المباريات...");
      const added = await refreshAutoMatches(true);
      return message.reply("📊 تم جلب **" + added + "** مباراة.\nاضغط **🧪 تجربة** حتى تجرب.");
    }

    // ═══ الإشعارات: اختيار الاشتراك لتعديل رسالته ═══
    if (ps && ps.mode === "notif_edit_pick") {
      const n = parseInt(txt.trim());
      if (isNaN(n) || n < 1 || n > notifData.subs.length) {
        return message.reply("✍️ اكتب رقم صحيح (من 1 إلى " + notifData.subs.length + ")");
      }
      const sub = notifData.subs[n - 1];
      if (!sub) return message.reply("❌ ما لكيت الاشتراك");

      ps.mode = "notif_edit_choice";
      ps.editSubIndex = n - 1;
      sessions.set(uid, ps);

      const p = getPlatform(sub.platform);
      const tl = TYPE_LABELS[sub.type || "live"];
      const tpl = NOTIF_TEMPLATES[sub.platform + "_" + (sub.type || "live")];

      const previewDefault = tpl
        ? tpl.emoji + " **" + (sub.customName || sub.username) + "** " + tpl.text + " <@&" + tpl.role + ">"
        : "_ماكو قالب_";

      const e = buildPanelEmbed({
        icon: "✏️",
        title: "خيارات التعديل",
        color: p ? p.color : 0x5865f2,
        description:
          "### " + (p ? p.emoji : "") + " " + (p ? p.name : "?") + " • **" + sub.username + "** " + (tl ? tl.emoji : "") + "\n\n" +
          "**📝 القالب الافتراضي:**\n> " + previewDefault + "\n\n" +
          "**✏️ اختار شنو تعدل:**\n" +
          "> **1** = تعديل **اسم العرض** (يبدل اليوزر بالقالب)\n" +
          "> **2** = كتابة **رسالة كاملة مخصصة** (بدون قالب)\n" +
          "> **3** = رجوع للافتراضي\n\u200b",
        thumbnail: false,
      });
      return message.reply({ embeds: [e] });
    }

    if (ps && ps.mode === "notif_edit_choice") {
      const ch = txt.trim();
      const idx = ps.editSubIndex;
      const sub = notifData.subs[idx];
      if (!sub) return message.reply("❌ ما لكيت الاشتراك");

      if (ch === "1") {
        ps.mode = "notif_edit_name";
        sessions.set(uid, ps);
        return message.reply("✍️ اكتب **اسم العرض** الجديد (يبدل اليوزر في القالب):");
      }
      if (ch === "2") {
        ps.mode = "notif_edit_text";
        sessions.set(uid, ps);
        return message.reply("✍️ اكتب **الرسالة الكاملة** (بدون قالب، ما راح يكون فيه رتبة تلقائي):");
      }
      if (ch === "3") {
        delete sub.customName;
        delete sub.customMessage;
        saveNotifData();
        sessions.delete(uid);
        return message.reply("✅ تم الرجوع للقالب الافتراضي");
      }
      return message.reply("✍️ اكتب 1 أو 2 أو 3");
    }

    if (ps && ps.mode === "notif_edit_name") {
      const newName = txt.trim();
      if (newName.length === 0) return message.reply("✍️ اكتب اسم");
      if (newName.length > 100) return message.reply("⚠️ الحد 100 حرف");
      const idx = ps.editSubIndex;
      const sub = notifData.subs[idx];
      if (!sub) return message.reply("❌ ما لكيت الاشتراك");
      sub.customName = newName;
      saveNotifData();
      sessions.delete(uid);
      const finalMsg = buildNotifContent(sub);
      return message.reply({
        content: "✅ **تم حفظ الاسم!**\n\n**الشكل النهائي:**\n" + (finalMsg || "_ماكو قالب_"),
      });
    }

    if (ps && ps.mode === "notif_edit_text") {
      const newMsg = txt.trim();
      if (newMsg.length === 0) return message.reply("✍️ اكتب نص");
      if (newMsg.length > 2000) return message.reply("⚠️ الحد 2000 حرف");

      const idx = ps.editSubIndex;
      const sub = notifData.subs[idx];
      if (!sub) return message.reply("❌ ما لكيت الاشتراك");

      const reset = newMsg === "افتراضي" || newMsg === "default";
      if (reset) delete sub.customMessage;
      else sub.customMessage = newMsg;
      saveNotifData();
      sessions.delete(uid);

      const p = getPlatform(sub.platform);
      const e = buildPanelEmbed({
        icon: "✅",
        title: "تم الحفظ",
        color: 0x57f287,
        description:
          "### ✅ تم التعديل\n" +
          "> " + (p ? p.emoji + " " + p.name : "?") + " • **" + sub.username + "**\n\n" +
          "**📝 الرسالة:**\n" +
          (reset ? "> _افتراضي_\n" : "> \`" + sub.customMessage.slice(0, 500) + "\`\n") + "\u200b",
        thumbnail: false,
      });
      return message.reply({ embeds: [e] });
    }

    // ═══ الإشعارات: استقبال اسم المستخدم ═══
    if (ps && ps.mode === "notif_username") {
      const uname = txt.trim().replace(/^@/, "");
      if (uname.length < 2) return message.reply("✍️ اكتب اسم مستخدم صحيح");
      ps.notifUsername = uname;

      const p = getPlatform(ps.platform);

      if (p.types && p.types.length > 1) {
        ps.mode = "notif_type";
        sessions.set(uid, ps);
        const menu = new StringSelectMenuBuilder()
          .setCustomId("notif_type_sel")
          .setPlaceholder("🎯 اختر نوع المحتوى...")
          .setMinValues(1)
          .setMaxValues(1);
        for (const t of p.types) {
          const tl = TYPE_LABELS[t];
          menu.addOptions(new StringSelectMenuOptionBuilder()
            .setLabel(tl.emoji + "  " + tl.name)
            .setDescription(tl.desc)
            .setValue(t));
        }
        const e = buildPanelEmbed({
          icon: p.emoji,
          title: "اختر نوع المحتوى",
          color: p.color,
          description: "### " + p.emoji + " " + p.name + " • **" + uname + "**\n> **الخطوة 2/3:** اختر شنو تريد تراقب\n\u200b",
          thumbnail: false,
        });
        return message.reply({ embeds: [e], components: [new ActionRowBuilder().addComponents(menu)] });
      }

      ps.notifType = p.types ? p.types[0] : "live";
      ps.mode = "notif_channel";
      sessions.set(uid, ps);
      const tl = TYPE_LABELS[ps.notifType];
      const e = buildPanelEmbed({
        icon: "📍",
        title: "اختر الروم",
        color: p.color,
        description: "### " + p.emoji + " " + p.name + " • **" + uname + "**\n> **النوع:** " + tl.emoji + " " + tl.name + "\n\n> **الخطوة 2/2:** اكتب ID الروم\n\u200b",
        thumbnail: false,
      });
      return message.reply({ embeds: [e] });
    }

    // ═══ الإشعارات: استقبال ID الروم ═══
    if (ps && ps.mode === "notif_channel") {
      const cid = txt.replace(/[^0-9]/g, "");
      if (!/^\d{17,20}$/.test(cid)) return message.reply("✍️ اكتب ID روم صحيح (17-20 رقم)");
      let guild = client.guilds.cache.get(GUILD_ID);
      if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
      if (!guild) return message.reply("❌ ما كدرت اوصل للسيرفر");
      const ch = guild.channels.cache.get(cid) || await guild.channels.fetch(cid).catch(() => null);
      if (!ch) return message.reply("❌ ما لكيت هذا الروم");

      const wait = await message.reply("⏳ جاري التحقق...");
      const testResult = await checkPlatform(ps.platform, ps.notifUsername);
      const p = getPlatform(ps.platform);

      const newSub = {
        id: "sub_" + Date.now(),
        platform: ps.platform,
        username: ps.notifUsername,
        type: ps.notifType || "live",
        channelId: cid,
        lastContentId: testResult ? testResult.id : null,
        addedAt: Date.now(),
        addedBy: uid,
      };
      notifData.subs.push(newSub);
      saveNotifData();
      sessions.delete(uid);

      const tl = TYPE_LABELS[ps.notifType];
      const e = buildPanelEmbed({
        icon: "✅",
        title: "تم إضافة الاشتراك",
        color: 0x57f287,
        description:
          "### ✅ تم بنجاح\n" +
          "> " + p.emoji + " **" + p.name + "** • **" + ps.notifUsername + "**\n" +
          "> 🎯 النوع: " + (tl ? tl.emoji + " " + tl.name : "؟") + "\n" +
          "> 📍 الروم: <#" + cid + ">\n" +
          "> 🕐 المراقبة: كل 5 دقائق\n\u200b",
        thumbnail: false,
        footer: "MRBOT Notifications",
      });
      return wait.edit({ content: "", embeds: [e] });
    }

    // ---- Giphy: اسم البحث ----
    if (ps && ps.mode === "awaiting_giphy_query") {
      const q = txt.trim();
      if (!q || q.length < 2) return message.reply("✍️ اكتب اسم واضح (حرفين على الأقل)");
      ps.giphyQuery = q;
      ps.mode = "awaiting_giphy_count";
      sessions.set(uid, ps);
      return message.reply("🔎 تبحث عن: **" + q + "**\n\nهسه اكتب **عدد الملصقات** (من 1 إلى 50)");
    }

    // ---- Giphy: العدد ----
    if (ps && ps.mode === "awaiting_giphy_count") {
      const n = parseInt(txt);
      if (isNaN(n) || n < 1 || n > 50) return message.reply("✍️ اكتب رقم من **1** إلى **50**");
      const wait = await message.reply("⏳ جاري البحث...");
      ps.giphyOffset = 0;
      const results = await searchGiphy(ps.giphyQuery, n, ps.giphyOffset);
      if (!results || results.length === 0) {
        sessions.delete(uid);
        return wait.edit("❌ ما لكيت نتائج لـ: **" + ps.giphyQuery + "**\nجرب اسم ثاني بالإنجليزي.");
      }
      ps.attachments = results;
      ps.mode = "awaiting_giphy_action";
      sessions.set(uid, ps);
      return sendGiphyPreview(wait, ps);
    }

    // ---- قائمة الحذف ----
    const list = lists.get(uid);
    if (list && list.items.length > 0) {
      if (txt === "الكل" || txt === "كل") {
        const all = list.items.map((_, i) => i + 1);
        return handleDelete(message, list, all);
      }
      const nums = txt.split(/[\s,،]+/).map((x) => parseInt(x)).filter((x) => !isNaN(x));
      if (nums.length > 0) return handleDelete(message, list, nums);
      return message.reply({
        content: "✍️ اكتب أرقام مثل \`1 3 5\` أو \`الكل\`",
        embeds: [buildList(list.items, list.type)],
      });
    }

    // ---- في انتظار نتيجة Giphy: نطلب منه يدوس زر ----
    if (ps && ps.mode === "awaiting_giphy_action") {
      return message.reply("👆 اضغط على زر **إيموجي** أو **ستيكرات** بالأعلى");
    }

    // ---- تحويل صور عادي ----
    const session = sessions.get(uid);
    if (!session || session.mode !== "awaiting_images") {
      return message.reply(mainPanel(uid));
    }

    const images = [...message.attachments.values()].filter((a) =>
      a.contentType?.startsWith("image/")
    );
    if (images.length === 0) return message.reply("ما لكيت صور 🤔 دزلي صور بس.");

    session.attachments.push(...images);
    sessions.set(uid, session);

    const embed = new EmbedBuilder()
      .setColor(0x00c853)
      .setTitle("✅ وصلت الصور")
      .setDescription("عدد الصور: **" + session.attachments.length + "**\n\nاختار شنو تريد تسوي بيها:");

    const row = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("conv_emoji").setLabel("إيموجي").setEmoji("🙂").setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId("conv_sticker").setLabel("ستيكرات").setEmoji("🏷️").setStyle(ButtonStyle.Secondary),
      new ButtonBuilder().setCustomId("conv_more").setLabel("أزيد صور").setEmoji("➕").setStyle(ButtonStyle.Success),
      new ButtonBuilder().setCustomId("conv_reset").setLabel("إلغاء").setEmoji("✖️").setStyle(ButtonStyle.Danger),
    );
    return message.reply({ embeds: [embed], components: [row] });
  }

  if (message.guild.id !== GUILD_ID) return;
  const t = message.content.trim();

  if (t === "اطفاء البوت" || t === "ايقاف البوت") {
    paused = true;
    return message.reply("🔴 تم اطفاء البوت");
  }

  if (t === "تشغيل البوت") {
    paused = false;
    for (const uid of ALLOWED) {
      try {
        const user = await client.users.fetch(uid);
        const dm = await user.createDM();
        await dm.send(mainPanel(uid));
      } catch {}
    }
    return message.reply("🟢 تم تشغيل البوت، ودزيت اللوحة للخاص");
  }

  if (paused) return;

  if (t === "تحويل" || t === "لوحة") {
    try {
      const dm = await message.author.createDM();
      await dm.send(mainPanel(uid));
      await message.reply("✅ دزيتلك اللوحة بالخاص");
    } catch {
      await message.reply("⚠️ ما كدرت ادزلك خاص.");
    }
  }
});

async function handleDelete(message, list, nums) {
  const uid = message.author.id;
  let guild = client.guilds.cache.get(GUILD_ID);
  if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
  if (!guild) return message.reply("ما كدرت اوصل للسيرفر");

  const unique = [...new Set(nums)];
  const results = [];
  let ok = 0, fail = 0;
  const deleted = new Set();

  for (const n of unique) {
    const it = list.items[n - 1];
    if (!it) { fail++; results.push("❌ رقم **" + n + "** مو موجود"); continue; }
    try {
      if (list.type === "sticker") await guild.stickers.delete(it.id);
      else await guild.emojis.delete(it.id);
      ok++;
      deleted.add(it.id);
      results.push("✅ حذفت: **" + it.name + "**");
    } catch (e) {
      fail++;
      results.push("❌ **" + it.name + "**: " + e.message.split("\n")[0].slice(0, 80));
    }
  }

  list.items = list.items.filter((it) => !deleted.has(it.id));

  if (list.items.length === 0) {
    lists.delete(uid);
    return message.reply("🗑️ **خلصنا!**\n✅ نجح: **" + ok + "**\n❌ فشل: **" + fail + "**\n\n" + results.join("\n").slice(0, 3500));
  }

  lists.set(uid, list);
  return message.reply({
    content: "📊 **النتيجة** — ✅ نجح: **" + ok + "** | ❌ فشل: **" + fail + "**\n" + results.join("\n").slice(0, 1500),
    embeds: [buildList(list.items, list.type)],
  });
}

client.on("interactionCreate", async (interaction) => {
  // ═══ النافذة: حفظ التوقع ═══
  if (interaction.isModalSubmit() && interaction.customId.startsWith("predict_modal_")) {
    const matchId = interaction.customId.replace("predict_modal_", "");
    const m = matchesData.matches.find((x) => x.id === matchId) || autoData.matches.find((x) => x.id === matchId);
    if (!m) return interaction.reply({ content: "❌ المباراة مو موجودة", ephemeral: true });
    if (m.closed || Date.now() >= m.startTime) return interaction.reply({ content: "🔴 التوقع مقفل", ephemeral: true });
    const s1 = interaction.fields.getTextInputValue("score1").trim();
    const s2 = interaction.fields.getTextInputValue("score2").trim();
    if (!/^\d{1,2}$/.test(s1) || !/^\d{1,2}$/.test(s2)) {
      return interaction.reply({ content: "⚠️ اكتب أرقام من 0 إلى 99", ephemeral: true });
    }
    m.predictions[interaction.user.id] = { s1: parseInt(s1), s2: parseInt(s2), tag: interaction.user.tag };
    if (m.source === "auto") saveAutoData(); else saveMatchesData();
    // نحدث الصورة
    try {
      const guild = client.guilds.cache.get(GUILD_ID);
      if (guild && m.channelId && m.messageId) {
        const ch = guild.channels.cache.get(m.channelId) || await guild.channels.fetch(m.channelId).catch(() => null);
        if (ch) await editMatchCard(ch, m.messageId, m, true);
      }
    } catch (e) { console.log("edit after pred err:", e.message); }
    return interaction.reply({
      content: "✅ **تم حفظ توقعك:**\n" + flagEmoji(m.flag1) + " " + m.team1 + " **" + s1 + " - " + s2 + "** " + m.team2 + " " + flagEmoji(m.flag2),
      ephemeral: true,
    });
  }

  // ═══ زر "خمن" ═══
  if (interaction.isButton() && interaction.customId.startsWith("lineup_")) {
    const fid = interaction.customId.replace("lineup_", "");
    await interaction.deferReply();
    let guild = client.guilds.cache.get(GUILD_ID);
    if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
    const m = autoData.matches.find((x) => x.id === "auto_" + fid || String(x.fixtureId) === fid) ||
              matchesData.matches.find((x) => x.id === fid);
    if (!m) return interaction.editReply("❌ ما لقيت المباراة");
    const fixtureId = m.fixtureId || fid;
    try {
      const buf = await generateLineupCard(m, fixtureId);
      const file = new AttachmentBuilder(buf, { name: "lineup_" + fixtureId + ".png" });
      return interaction.editReply({ files: [file] });
    } catch (e) {
      console.log("lineup err:", e.message);
      return interaction.editReply("❌ فشل التوليد: " + e.message.slice(0, 100));
    }
  }

  if (interaction.isButton() && interaction.customId.startsWith("predict_btn_")) {
    const matchId = interaction.customId.replace("predict_btn_", "");
    const m = matchesData.matches.find((x) => x.id === matchId) || autoData.matches.find((x) => x.id === matchId);
    if (!m) return interaction.reply({ content: "❌ المباراة مو موجودة", ephemeral: true });
    if (m.closed || Date.now() >= m.startTime) return interaction.reply({ content: "🔴 التوقع مقفل", ephemeral: true });

    const modal = new ModalBuilder()
      .setCustomId("predict_modal_" + matchId)
      .setTitle("🎯 توقع النتيجة");
    const i1 = new TextInputBuilder()
      .setCustomId("score1")
      .setLabel(m.team1.slice(0, 45))
      .setStyle(TextInputStyle.Short)
      .setPlaceholder("اكتب عدد الأهداف")
      .setMinLength(1).setMaxLength(2)
      .setRequired(true);
    const i2 = new TextInputBuilder()
      .setCustomId("score2")
      .setLabel(m.team2.slice(0, 45))
      .setStyle(TextInputStyle.Short)
      .setPlaceholder("اكتب عدد الأهداف")
      .setMinLength(1).setMaxLength(2)
      .setRequired(true);
    modal.addComponents(
      new ActionRowBuilder().addComponents(i1),
      new ActionRowBuilder().addComponents(i2)
    );
    return interaction.showModal(modal);
  }


  if (interaction.isButton() && interaction.customId.startsWith("onb_ans_")) {
    const uid = interaction.user.id;
    const session = onboardingSessions.get(uid);
    if (!session) {
      return interaction.reply({ content: "❌ ماكو جلسة نشطة.", ephemeral: true });
    }
    const parts = interaction.customId.split("_");
    const qIdx = parseInt(parts[2]);
    const oIdx = parseInt(parts[3]);
    if (qIdx !== session.step) {
      return interaction.reply({ content: "❌ هذا السؤال قديم.", ephemeral: true });
    }
    const q = onboarding.questions[qIdx];
    const opt = q && q.options[oIdx];
    if (!opt) return interaction.reply({ content: "❌ خيار غير صحيح", ephemeral: true });

    let guild = client.guilds.cache.get(GUILD_ID);
    if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
    let roleGiven = false;
    if (guild) {
      const mem = guild.members.cache.get(uid) || await guild.members.fetch(uid).catch(() => null);
      if (mem) {
        try { await mem.roles.add(opt.roleId); roleGiven = true; }
        catch (e) { console.log("⚠️ role add err:", e.message); }
      }
    }

    session.answers.push({ q: q.text, a: opt.label });
    session.step++;
    onboardingSessions.set(uid, session);

    await interaction.update({
      content: "✅ اختاريت: **" + opt.label + "**" + (roleGiven ? "" : " (⚠️ ما كدرت اعطيك الدور)"),
      embeds: [],
      components: [],
    });

    await new Promise((r) => setTimeout(r, 300));
    await sendOnboardingQuestion(interaction.channel, uid);
    return;
  }


  if (interaction.isStringSelectMenu() && interaction.customId === "member_features") {
    const uid2 = interaction.user.id;
    const ps = sessions.get(uid2);
    if (!ps || !ps.pendingMember) {
      return interaction.update({ content: "❌ ماكو عضو قيد الإضافة", embeds: [], components: [] });
    }
    ps.pendingMember.features = interaction.values;
    sessions.set(uid2, ps);
    return interaction.update(buildMemberPanel(ps.pendingMember));
  }

  if (!interaction.isButton() && !interaction.isStringSelectMenu()) return;
  if (!isAllowed(interaction.user.id)) {
    return interaction.reply({ content: "🚫 خاص.", ephemeral: true });
  }
  if (paused) return interaction.reply({ content: "🔴 البوت مطفي هسه.", ephemeral: true });
  const uid = interaction.user.id;
  let id = interaction.customId;
  if (id === "main_menu" && interaction.isStringSelectMenu()) {
    id = interaction.values[0];
  }

  if (id === "panel_auto_matches") {
    const chTxt = autoData.channelId ? "<#" + autoData.channelId + ">" : "❌ ما محدد";
    const e = new EmbedBuilder().setColor(0x2ecc71).setTitle("⚽ المباريات التلقائية")
      .setDescription(
        "📡 **الحالة:** " + (autoData.channelId ? "🟢 شغال" : "🔴 ما محدد روم") + "\n" +
        "📍 **الروم:** " + chTxt + "\n" +
        "📊 **المباريات المحفوظة:** " + autoData.matches.length + "\n" +
        "🕐 **آخر تحديث:** " + (autoData.lastFetch ? new Date(autoData.lastFetch).toLocaleString("ar") : "أبداً") + "\n\n" +
        "**الدوريات المتابعة (" + TRACKED_LEAGUES.length + "):**\n" +
        TRACKED_LEAGUES.map((l) => "• " + l.name).join("\n") + "\n\n" +
        "🔔 البوت يرسل منشور **قبل ساعتين** من كل مباراة تلقائياً."
      );
    const r1 = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("auto_set_ch").setLabel("تحديد الروم").setEmoji("📍").setStyle(ButtonStyle.Success),
      new ButtonBuilder().setCustomId("auto_refresh").setLabel("تحديث الآن").setEmoji("🔄").setStyle(ButtonStyle.Primary),
    );
    const r2 = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("auto_view").setLabel("عرض المباريات").setEmoji("📋").setStyle(ButtonStyle.Secondary),
      new ButtonBuilder().setCustomId("auto_clear").setLabel("مسح الكل").setEmoji("🗑️").setStyle(ButtonStyle.Danger),
      new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary),
    );
    return interaction.update({ embeds: [e], components: [r1, r2] });
  }

  if (id === "auto_set_ch") {
    sessions.set(uid, { mode: "auto_set_channel" });
    const e = new EmbedBuilder().setColor(0x2ecc71).setTitle("📍 تحديد الروم")
      .setDescription("اكتب **ID الروم** اللي تريد البوت يرسل فيه المباريات\n\n📝 مثال: \`1234567890123456789\`");
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "auto_refresh") {
    await interaction.deferReply();
    const added = await refreshAutoMatches(true);
    // نحدث الحية كذلك
    try { await updateLiveMatches(); } catch {}
    return interaction.editReply({
      content: "✅ تم التحديث!\n📊 إضافة: **" + added + "** مباراة جديدة\n📁 المجموع: **" + autoData.matches.length + "**",
    });
  }

  if (id === "auto_view") {
    if (autoData.matches.length === 0) return interaction.reply({ content: "📋 ماكو مباريات", ephemeral: true });
    const sorted = [...autoData.matches].sort((a, b) => a.startTime - b.startTime).slice(0, 20);
    const lines = sorted.map((m, i) => {
      const st = m.closed ? "🔴" : (m.sentAt ? "🟡" : "🟢");
      return (i + 1) + ". " + st + " " + m.team1 + " vs " + m.team2 + " — " + formatIraqTime(m.startTime) + (m.league ? " (" + m.league + ")" : "");
    });
    const e = new EmbedBuilder().setColor(0x3498db).setTitle("📋 المباريات التلقائية")
      .setDescription(lines.join("\n").slice(0, 3900));
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_auto_matches").setLabel("رجوع").setEmoji("↩️").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "auto_clear") {
    autoData.matches = [];
    saveAutoData();
    return interaction.reply({ content: "🗑️ تم مسح كل المباريات", ephemeral: true });
  }

  if (id === "panel_matches") {
    const e = new EmbedBuilder().setColor(0x9b59b6).setTitle("🎯 المباريات")
      .setDescription("اختار شنو تريد تسوي:\n\n📊 عدد المباريات: **" + matchesData.matches.length + "**");
    const r = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("match_add").setLabel("إضافة مباراة").setEmoji("➕").setStyle(ButtonStyle.Success),
      new ButtonBuilder().setCustomId("match_list").setLabel("عرض المباريات").setEmoji("📋").setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId("match_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
    );
    return interaction.update({ embeds: [e], components: [r] });
  }

  if (id === "match_back") {
    sessions.delete(uid);
    return interaction.update(mainPanel(uid));
  }

  if (id === "match_add") {
    sessions.set(uid, { mode: "match_add_wizard" });
    const e = new EmbedBuilder().setColor(0x9b59b6).setTitle("➕ إضافة مباراة")
      .setDescription(
        "📝 اكتب **كل المعلومات** برسالة وحدة بهذا الشكل:\n\n" +
        "\`\`\`\nالسعودية | sa | العراق | iq | 30/09/2026 20:30 | 1234567890\`\`\`\n\n" +
        "**الترتيب:**\n" +
        "1. اسم الفريق الأول\n" +
        "2. كود العلم الأول (حرفين، مثال: \`sa\` \`iq\` \`br\`)\n" +
        "3. اسم الفريق الثاني\n" +
        "4. كود العلم الثاني\n" +
        "5. التاريخ والوقت (بغداد): \`DD/MM/YYYY HH:mm\`\n" +
        "6. ID الروم اللي يرسل فيه المنشور\n\n" +
        "🔸 الوقت: 24 ساعة (20:30 = 8:30 مساءً)"
      );
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("match_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "match_list") {
    if (matchesData.matches.length === 0) {
      return interaction.reply({ content: "📋 ماكو مباريات", ephemeral: true });
    }
    const lines = matchesData.matches.slice(0, 20).map((m, i) => {
      const st = m.closed ? "🔴" : (m.sentAt ? "🟡" : "🟢");
      return (i + 1) + ". " + st + " " + flagEmoji(m.flag1) + " " + m.team1 + " vs " + m.team2 + " " + flagEmoji(m.flag2) + " — " + formatIraqTime(m.startTime);
    });
    const e = new EmbedBuilder().setColor(0x9b59b6).setTitle("📋 المباريات").setDescription(lines.join("\n").slice(0, 3900));
    const r = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("match_del").setLabel("حذف مباراة").setEmoji("🗑️").setStyle(ButtonStyle.Danger),
      new ButtonBuilder().setCustomId("match_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
    );
    return interaction.update({ embeds: [e], components: [r] });
  }

  if (id === "match_del") {
    sessions.set(uid, { mode: "match_delete" });
    return interaction.update({
      embeds: [new EmbedBuilder().setColor(0xe74c3c).setTitle("🗑️ حذف مباراة").setDescription("اكتب **رقم المباراة** اللي تريد تحذفها")],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("match_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "channels_save") {
    const ps = sessions.get(uid);
    if (!ps || !ps.pendingChannels) {
      return interaction.update({ content: "❌ ماكو قائمة. اضغط ➕ إضافة رومات من جديد.", embeds: [], components: [] });
    }
    await interaction.deferReply();
    let guild = client.guilds.cache.get(GUILD_ID);
    if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
    if (!guild) return interaction.editReply("❌ ما كدرت اوصل للسيرفر");

    const { categories, channels } = ps.pendingChannels;
    const results = [];
    let okCat = 0, okChan = 0, fail = 0;

    for (const ch of channels) {
      try {
        await guild.channels.create({ name: ch.name, type: 0 });
        okChan++;
        results.push("💬 " + ch.name);
      } catch (e) {
        fail++;
        results.push("❌ " + ch.name + ": " + e.message.slice(0, 60));
      }
      await new Promise((r) => setTimeout(r, 700));
    }

    for (const cat of categories) {
      let catObj = null;
      try {
        catObj = await guild.channels.create({ name: cat.name, type: 4 });
        okCat++;
        results.push("📁 " + cat.name);
      } catch (e) {
        fail++;
        results.push("❌ " + cat.name + ": " + e.message.slice(0, 60));
        continue;
      }
      await new Promise((r) => setTimeout(r, 700));

      for (const ch of cat.channels) {
        try {
          await guild.channels.create({ name: ch.name, type: 0, parent: catObj.id });
          okChan++;
          results.push("   💬 " + ch.name);
        } catch (e) {
          fail++;
          results.push("   ❌ " + ch.name + ": " + e.message.slice(0, 60));
        }
        await new Promise((r) => setTimeout(r, 700));
      }
    }

    sessions.delete(uid);

    const e2 = new EmbedBuilder()
      .setColor(fail > 0 ? 0xffaa00 : 0x57f287)
      .setTitle("📁 نتيجة الإنشاء")
      .setDescription(
        "✅ قنوات: **" + okCat + "**\n" +
        "✅ رومات: **" + okChan + "**\n" +
        "❌ فشل: **" + fail + "**\n\n" +
        results.join("\n").slice(0, 3500)
      );
    return interaction.editReply({ content: "", embeds: [e2] });
  }

  if (id === "channels_cancel") {
    sessions.delete(uid);
    return interaction.update({ content: "✖️ تم الإلغاء", embeds: [], components: [] });
  }

  if (id === "chan_add") {
    sessions.set(uid, { mode: "awaiting_channel_list" });
    const e = new EmbedBuilder().setColor(0x2ecc71).setTitle("➕ إضافة رومات")
      .setDescription(
        "📝 اكتب القائمة **برسالة وحدة** (سطر جديد = Shift+Enter)\n\n" +
        "\`!\` = **قناة** (Category)\n" +
        "\`.\` = **روم** (داخل القناة)\n\n" +
        "**مثال (انسخ كله والصقه):**\n" +
        "\`\`\`\n! عام\n. الشات\n. الترحيب\n! ترفيه\n. ألعاب\n\`\`\`"
      );
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("chan_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "chan_back") {
    sessions.delete(uid);
    return interaction.update(channelsMenuPanel());
  }

  if (id === "panel_notifications") {
    return interaction.update(notificationsPanel());
  }

  if (id === "notif_edit_msg") {
    // نعرض المنصات المتوفرة (اللي عندها اشتراكات)
    const platformsWithSubs = {};
    for (const sub of notifData.subs) {
      platformsWithSubs[sub.platform] = (platformsWithSubs[sub.platform] || 0) + 1;
    }
    const available = Object.keys(platformsWithSubs);
    if (available.length === 0) {
      return interaction.reply({ content: "📋 ماكو اشتراكات حالياً", ephemeral: true });
    }

    const menu = new StringSelectMenuBuilder()
      .setCustomId("notif_edit_plat")
      .setPlaceholder("🎯 اختر المنصة...")
      .setMinValues(1)
      .setMaxValues(1);

    for (const platId of available) {
      const p = getPlatform(platId);
      if (!p) continue;
      menu.addOptions(new StringSelectMenuOptionBuilder()
        .setLabel(p.emoji + "  " + p.name)
        .setDescription(platformsWithSubs[platId] + " اشتراك")
        .setValue(platId));
    }

    const e = buildPanelEmbed({
      icon: "✏️",
      title: "تعديل الرسالة — اختر المنصة",
      color: 0xfee75c,
      description: "### ✏️ اختر المنصة اللي تريد تعدل اشتراكاتها\n> ثم اختر رقم الاشتراك\n\u200b",
      thumbnail: false,
    });

    return interaction.update({
      embeds: [e],
      components: [
        new ActionRowBuilder().addComponents(menu),
        new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_notifications").setLabel("رجوع").setEmoji("↩️").setStyle(ButtonStyle.Secondary)
        ),
      ],
    });
  }

  if (id === "notif_edit_plat") {
    const platId = interaction.values[0];
    const p = getPlatform(platId);
    if (!p) return interaction.reply({ content: "❌", ephemeral: true });

    // ناخذ اشتراكات هذه المنصة
    const subs = [];
    for (let i = 0; i < notifData.subs.length; i++) {
      if (notifData.subs[i].platform === platId) {
        subs.push({ index: i + 1, sub: notifData.subs[i] });
      }
    }

    if (subs.length === 0) {
      return interaction.reply({ content: "📋 ماكو اشتراكات لهذه المنصة", ephemeral: true });
    }

    // نعرضهم مرقمين
    const lines = subs.map(({ index, sub }) => {
      const tl = TYPE_LABELS[sub.type || "live"];
      const msg = sub.customMessage ? "\`" + sub.customMessage.slice(0, 30) + "\`" : "_افتراضي_";
      return "**" + index + ".** " + (tl ? tl.emoji : "") + " **" + sub.username + "**\n> 📝 الرسالة: " + msg;
    });

    const e = buildPanelEmbed({
      icon: p.emoji,
      title: p.name + " — اشتراكات",
      color: p.color,
      description:
        "### " + p.emoji + " اشتراكات " + p.name + "\n" +
        "> ✍️ اكتب **رقم الاشتراك** بالخاص لتعديل رسالته\n\u200b\n" +
        lines.join("\n"),
      thumbnail: false,
    });

    sessions.set(uid, { mode: "notif_edit_pick", platform: platId, subs });

    return interaction.update({
      embeds: [e],
      components: [
        new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_notifications").setLabel("رجوع").setEmoji("↩️").setStyle(ButtonStyle.Secondary)
        ),
      ],
    });
  }

  if (id === "notif_check_now") {
    await interaction.deferReply();
    if (!notifData.subs.length) {
      return interaction.editReply({ content: "📋 ماكو اشتراكات حالياً." });
    }

    let checked = 0, sent = 0, failed = 0;
    const results = [];

    for (const sub of notifData.subs) {
      checked++;
      try {
        const result = await checkPlatform(sub.platform, sub.username);
        if (!result) { results.push("⚪ " + sub.username + " — ماكو محتوى"); continue; }

        const p = getPlatform(sub.platform);
        const tl = TYPE_LABELS[sub.type || "live"];

        let isNew = false;

        if (!sub.lastContentId) {
          sub.lastContentId = result.id;
          if (result.allIds) sub.knownIds = result.allIds;
          saveNotifData();
          results.push("🆕 " + sub.username + " — حفظ أول محتوى");
          continue;
        }

        if (result.type === "live") {
          if (sub.lastContentId === result.id) { results.push("⚪ " + sub.username + " — نفس البث"); continue; }
          sub.lastContentId = result.id;
          isNew = true;
        } else {
          const known = sub.knownIds || [sub.lastContentId.replace("tiktok_", "")];
          const currentIds = result.allIds || [result.id.replace("tiktok_", "")];
          const newIds = currentIds.filter((id) => !known.includes(id));
          if (newIds.length === 0) { results.push("⚪ " + sub.username + " — ماكو جديد"); continue; }
          const newestId = newIds[0];
          sub.lastContentId = "tiktok_" + newestId;
          sub.knownIds = currentIds;
          result.id = "tiktok_" + newestId;
          result.url = "https://www.tiktok.com/@" + sub.username + "/video/" + newestId;
          isNew = true;
        }

        if (!isNew) continue;

        const guild = client.guilds.cache.get(GUILD_ID);
        if (guild) {
          const ch = guild.channels.cache.get(sub.channelId) || await guild.channels.fetch(sub.channelId).catch(() => null);
          if (ch) {
            const isLive = result.type === "live";
            const emb = new EmbedBuilder()
              .setColor(p ? p.color : 0x5865f2)
              .setAuthor({ name: (p ? p.emoji + " " + p.name : "منصة") + " • " + (isLive ? "بث مباشر" : "فيديو جديد") })
              .setTitle((isLive ? "🔴 مباشر الآن! " : "🎬 ") + result.title.slice(0, 200))
              .setURL(result.url)
              .setDescription(
                "**" + (p ? p.emoji : "") + " " + result.channelName + "**\n\n" +
                (isLive && result.game ? "🎮 **اللعبة:** " + result.game + "\n" : "") +
                (isLive && result.viewers ? "👁️ **المشاهدين:** " + result.viewers + "\n" : "") +
                "\n" + (isLive ? "**[🎥 ادخل للبث](" + result.url + ")**" : "**[▶️ شاهد الفيديو](" + result.url + ")**")
              )
              .setFooter({ text: "MRBOT Notifications • مراجعة يدوية" })
              .setTimestamp();

            const content = buildNotifContent(sub);
            await ch.send({ content: content, embeds: [emb] }).catch(() => {});
            sent++;
            results.push("✅ **" + sub.username + "** (" + (p ? p.name : "?") + ") → أُرسل");
          } else { failed++; results.push("❌ " + sub.username + " — ما لقيت الروم"); }
        }
        saveNotifData();
      } catch (e) {
        failed++;
        results.push("❌ " + sub.username + ": " + e.message.slice(0, 50));
      }
      await new Promise((r) => setTimeout(r, 1000));
    }

    const e = buildPanelEmbed({
      icon: "⚡",
      title: "نتيجة المراجعة الفورية",
      color: sent > 0 ? 0x57f287 : 0x95a5a6,
      description:
        "### ⚡ تم الفحص\n" +
        "> 📊 **تم فحص:**  \`" + checked + "\`\n" +
        "> ✅ **أُرسل:**  \`" + sent + "\`\n" +
        "> ❌ **فشل:**  \`" + failed + "\`\n\u200b",
      fields: [{ name: "📋 التفاصيل", value: results.join("\n").slice(0, 1024) || "ماكو شي" }],
      thumbnail: false,
      footer: "MRBOT Notifications • " + new Date().toLocaleTimeString("ar"),
    });

    return interaction.editReply({ embeds: [e] });
  }

    if (id === "notif_add") {
    // نعرض قائمة المنصات
    const menu = new StringSelectMenuBuilder()
      .setCustomId("notif_plat")
      .setPlaceholder("🎯 اختر المنصة...")
      .setMinValues(1)
      .setMaxValues(1);
    for (const p of PLATFORMS) {
      menu.addOptions(new StringSelectMenuOptionBuilder()
        .setLabel(p.emoji + "  " + p.name)
        .setDescription(p.desc)
        .setValue(p.id));
    }
    const e = buildPanelEmbed({
      icon: "➕",
      title: "إضافة اشتراك — اختر المنصة",
      color: 0x57f287,
      description: "### 🎯 اختر المنصة التي تريد مراقبتها\n> ثم اكتب اسم المستخدم\n\u200b",
      thumbnail: false,
    });
    return interaction.update({
      embeds: [e],
      components: [
        new ActionRowBuilder().addComponents(menu),
        new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_notifications").setLabel("رجوع").setEmoji("↩️").setStyle(ButtonStyle.Secondary)
        ),
      ],
    });
  }

  if (id === "notif_list") {
    if (notifData.subs.length === 0) {
      return interaction.reply({ content: "📋 ماكو اشتراكات حالياً", ephemeral: true });
    }
    const lines = notifData.subs.map((sub, i) => {
      const p = getPlatform(sub.platform);
      const tl = TYPE_LABELS[sub.type || "live"];
      return "**" + (i + 1) + ".** " + (p ? p.emoji : "❓") + " **" + sub.username + "** " + (tl ? tl.emoji : "") + " → <#" + sub.channelId + ">";
    });
    const e = buildPanelEmbed({
      icon: "📋",
      title: "الاشتراكات النشطة",
      color: 0x3498db,
      description: lines.join("\n").slice(0, 3900),
      thumbnail: false,
    });
    return interaction.update({
      embeds: [e],
      components: [
        new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_notifications").setLabel("رجوع").setEmoji("↩️").setStyle(ButtonStyle.Secondary)
        ),
      ],
    });
  }

  if (id === "notif_remove") {
    if (notifData.subs.length === 0) {
      return interaction.reply({ content: "📋 ماكو اشتراكات", ephemeral: true });
    }
    const menu = new StringSelectMenuBuilder()
      .setCustomId("notif_del")
      .setPlaceholder("🗑️ اختر الاشتراك للحذف...")
      .setMinValues(1)
      .setMaxValues(1);
    notifData.subs.slice(0, 25).forEach((sub, i) => {
      const p = getPlatform(sub.platform);
      menu.addOptions(new StringSelectMenuOptionBuilder()
        .setLabel((p ? p.emoji + " " : "") + sub.username)
        .setDescription("المنصة: " + (p ? p.name : "?") + " • الروم: #" + (client.channels.cache.get(sub.channelId)?.name || "?"))
        .setValue(String(i)));
    });
    const e = buildPanelEmbed({
      icon: "🗑️",
      title: "حذف اشتراك",
      color: 0xff6b6b,
      description: "### 🗑️ اختر الاشتراك اللي تريد تحذفه\n\u200b",
      thumbnail: false,
    });
    return interaction.update({
      embeds: [e],
      components: [
        new ActionRowBuilder().addComponents(menu),
        new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_notifications").setLabel("رجوع").setEmoji("↩️").setStyle(ButtonStyle.Secondary)
        ),
      ],
    });
  }

  if (id === "notif_del") {
    const idx = parseInt(interaction.values[0]);
    const sub = notifData.subs[idx];
    if (!sub) return interaction.reply({ content: "❌ غير موجود", ephemeral: true });
    notifData.subs.splice(idx, 1);
    saveNotifData();
    return interaction.reply({ content: "✅ تم حذف الاشتراك", ephemeral: true });
  }

  if (id === "notif_plat") {
    const platId = interaction.values[0];
    const p = getPlatform(platId);
    if (!p) return interaction.reply({ content: "❌ منصة غير معروفة", ephemeral: true });

    // نطلب اسم المستخدم أولاً
    sessions.set(uid, { mode: "notif_username", platform: platId });
    const e = buildPanelEmbed({
      icon: p.emoji,
      title: "إضافة اشتراك — " + p.name,
      color: p.color,
      description:
        "### " + p.emoji + " " + p.name + "\n" +
        "> **الخطوة 1/3:** اكتب اسم المستخدم\n" +
        "> " + p.desc + "\n\u200b",
      thumbnail: false,
    });
    return interaction.update({
      embeds: [e],
      components: [
        new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_notifications").setLabel("إلغاء").setEmoji("✖️").setStyle(ButtonStyle.Danger)
        ),
      ],
    });
  }

  if (id === "notif_type_sel") {
    const type = interaction.values[0];
    const ps = sessions.get(uid);
    if (!ps || ps.mode !== "notif_type") return interaction.reply({ content: "❌ انتهت الجلسة", ephemeral: true });
    ps.notifType = type;
    ps.mode = "notif_channel";
    sessions.set(uid, ps);

    const p = getPlatform(ps.platform);
    const tl = TYPE_LABELS[type];
    const e = buildPanelEmbed({
      icon: "📍",
      title: "اختر الروم",
      color: p.color,
      description:
        "### " + p.emoji + " " + p.name + " • **" + ps.notifUsername + "**\n" +
        "> **النوع:** " + tl.emoji + " " + tl.name + "\n\n" +
        "> **الخطوة 3/3:** اكتب ID الروم\n" +
        "> (اضغط يمين على الروم → Copy Channel ID)\n\u200b",
      thumbnail: false,
    });
    return interaction.update({ embeds: [e], components: [] });
  }

  if (id === "panel_channels") {
    return interaction.update(channelsMenuPanel());
  }

  if (id === "chan_back") {
    sessions.delete(uid);
    return interaction.update(channelsMenuPanel());
  }

  if (id === "panel_broadcast") {
    sessions.set(uid, { mode: "broadcast_text" });
    const e = new EmbedBuilder().setColor(0xe74c3c).setTitle("📢 إرسال جماعي")
      .setDescription(
        "📝 اكتب **الرسالة** الي تريد ترسلها لكل الأعضاء\n\n" +
        "⚠️ **تنبيهات:**\n" +
        "• تروح لكل الأعضاء (إلا البوتات)\n" +
        "• بعض الأعضاء عندهم الخاص مسكر → ما توصلهم\n" +
        "• الإرسال يأخذ وقت بسبب Rate Limit"
      );
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("bc_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "bc_back") {
    sessions.delete(uid);
    return interaction.update(mainPanel(uid));
  }

  if (id === "bc_send") {
    const ps = sessions.get(uid);
    if (!ps || !ps.broadcastMsg) return interaction.reply({ content: "❌ ماكو رسالة", ephemeral: true });
    await interaction.deferReply();

    let guild = client.guilds.cache.get(GUILD_ID);
    if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
    if (!guild) return interaction.editReply("❌ ما كدرت اوصل للسيرفر");

    await guild.members.fetch().catch(() => {});
    const members = guild.members.cache.filter((m) => !m.user.bot && m.id !== client.user.id);
    const total = members.size;

    await interaction.editReply({ content: "⏳ **بدي الإرسال لـ " + total + " عضو...**", embeds: [], components: [] });

    let sent = 0, failed = 0, closedDM = 0;
    const errors = [];

    for (const m of members.values()) {
      try {
        const dm = await m.createDM();
        await dm.send({ content: ps.broadcastMsg });
        sent++;
      } catch (e) {
        if (e.code === 50007) closedDM++;
        else { failed++; errors.push(m.user.tag + ": " + (e.message || "").slice(0, 40)); }
      }
      if ((sent + failed + closedDM) % 10 === 0) {
        await interaction.editReply({
          content: "⏳ **جاري الإرسال...**\n✅ وصل: " + sent + " | 📪 مسكر: " + closedDM + " | ❌ فشل: " + failed + "\nمن أصل **" + total + "**",
          embeds: [], components: [],
        }).catch(() => {});
      }
      await new Promise((r) => setTimeout(r, 1300));
    }

    sessions.delete(uid);
    const e2 = new EmbedBuilder().setColor(0x57f287).setTitle("📢 نتيجة الإرسال الجماعي")
      .setDescription(
        "📊 **الأعضاء الكلي:** " + total + "\n\n" +
        "✅ **وصلهم:** " + sent + "\n" +
        "📪 **مسكرين الخاص:** " + closedDM + "\n" +
        "❌ **فشل:** " + failed + "\n\n" +
        (errors.length ? "**أخطاء:**\n" + errors.slice(0, 5).join("\n") : "")
      )
      .setFooter({ text: "MRBOT Broadcast" });
    return interaction.editReply({ content: "", embeds: [e2], components: [] });
  }

  if (id === "bc_cancel") {
    sessions.delete(uid);
    return interaction.update({ content: "✖️ تم الإلغاء", embeds: [], components: [] });
  }

  if (id === "panel_add_roles") {
    sessions.set(uid, { mode: "awaiting_role_names" });
    const e = new EmbedBuilder().setColor(0x57f287).setTitle("🎭 إنشاء رتب")
      .setDescription(
        "📝 اكتب أسماء الرتب — **كل سطر = رتبة**\n\n" +
        "**مثال:**\n" +
        "\`PUBG\`\n\`Minecraft\`\n\`Roblox\`\n\n" +
        "أو بفاصلة: \`PUBG, Minecraft, Roblox\`\n\n" +
        "🔸 **بحد أقصى 30 رتبة**"
      );
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "panel_add_member") {
    sessions.set(uid, { mode: "awaiting_member_id" });
    const e = new EmbedBuilder().setColor(0x57f287).setTitle("➕ إضافة عضو")
      .setDescription("📝 اكتب **ID العضو** الي تريد تضيفه");
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "member_confirm") {
    const ps = sessions.get(uid);
    if (!ps || !ps.pendingMember) return interaction.reply({ content: "❌ ماكو عضو", ephemeral: true });
    const pm = ps.pendingMember;
    if (!pm.features || !pm.features.length) return interaction.reply({ content: "❌ اختار نظام", ephemeral: true });
    members.set(pm.id, { features: pm.features });
    sessions.delete(uid);
    let sent = false;
    try {
      const user = await client.users.fetch(pm.id);
      const dm = await user.createDM();
      await dm.send(mainPanel(pm.id));
      sent = true;
    } catch {}
    return interaction.update({
      content: "✅ تم إضافة **" + pm.tag + "**" + (sent ? " ودزيتله اللوحة ✉️" : " ⚠️ ما كدرت ادزله خاص"),
      embeds: [], components: [],
    });
  }

  if (id === "member_cancel") {
    sessions.delete(uid);
    return interaction.update({ content: "✖️ تم الإلغاء", embeds: [], components: [] });
  }

  if (id === "giphy_retry") {
    const ps = sessions.get(uid);
    if (!ps || ps.mode !== "awaiting_giphy_action") {
      return interaction.reply({ content: "❌ ماكو بحث فعّال", ephemeral: true });
    }
    await interaction.deferReply();
    const limit = ps.attachments.length;
    let newOffset = (ps.giphyOffset || 0) + limit;
    // Giphy يوقف عند ~4999، إذا وصلنا نرجع من الأول
    if (newOffset > 4900) newOffset = 0;
    let results = await searchGiphy(ps.giphyQuery, limit, newOffset);
    // إذا ما لكى نتائج بهذا الـ offset، نجرب عشوائي
    if (!results || !results.length) {
      newOffset = Math.floor(Math.random() * 200);
      results = await searchGiphy(ps.giphyQuery, limit, newOffset);
    }
    if (!results || !results.length) {
      return interaction.editReply("❌ ما لكيت نتائج جديدة، جرب اسم ثاني.");
    }
    ps.giphyOffset = newOffset;
    ps.attachments = results;
    sessions.set(uid, ps);
    const embeds = buildGiphyPreviewEmbeds(ps.attachments, ps.giphyQuery);
    const rows = buildGiphyActionRows();
    return interaction.editReply({ content: "", embeds, components: rows });
  }

  if (id.startsWith("cat_")) {
    const cat = id.slice(4);

    // بكيفك: ما يطلب عدد مباشر، يطلب اسم أول
    if (cat === "custom") {
      sessions.set(uid, { mode: "awaiting_giphy_query" });
      const e = new EmbedBuilder()
        .setColor(0x5865f2)
        .setTitle("✍️ بكيفك")
        .setDescription("اكتب **أي اسم** بالإنجليزي\nمثال: minecraft, spider man, lol");
      return interaction.update({
        embeds: [e],
        components: [new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
        )],
      });
    }

    const hint = CATEGORY_HINTS[cat];
    if (!hint) return interaction.reply({ content: "❌ نوع غير معروف", ephemeral: true });

    sessions.set(uid, { mode: "awaiting_giphy_query", category: cat });
    const e = new EmbedBuilder()
      .setColor(0x5865f2)
      .setTitle(hint.title)
      .setDescription("✍️ اكتب شنو تبحث بالضبط\n\n**أمثلة:** " + hint.ex);
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "panel_back") {
    sessions.delete(uid);
    lists.delete(uid);
    return interaction.update(mainPanel(uid));
  }

  if (id === "panel_onboarding") {
    return interaction.update(onboardingPanel());
  }

  if (id === "onb_save") {
    const ps = sessions.get(uid);
    if (!ps || ps.mode !== "onb_confirm" || !ps.onbOptions) {
      return interaction.reply({ content: "❌ ماكو سؤال قيد الحفظ", ephemeral: true });
    }
    onboarding.questions.push({ text: ps.onbQuestion, options: ps.onbOptions });
    saveOnboarding();
    sessions.delete(uid);
    return interaction.update({
      content: "✅ تم حفظ السؤال: **" + ps.onbQuestion + "**",
      embeds: [],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Primary)
      )],
    });
  }

  if (id === "onb_cancel") {
    sessions.delete(uid);
    return interaction.update({
      content: "✖️ تم الإلغاء",
      embeds: [],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Primary)
      )],
    });
  }

  if (id === "onb_add") {
    sessions.set(uid, { mode: "onb_q_text" });
    const e = new EmbedBuilder().setColor(0x9b59b6).setTitle("➕ إضافة سؤال - خطوة 1/2")
      .setDescription("📝 اكتب **نص السؤال** الي يظهر للعضو\n\nمثال: ولد أو بنت");
    return interaction.update({
      embeds: [e],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "onb_list") {
    if (onboarding.questions.length === 0) {
      const e = new EmbedBuilder().setColor(0xffaa00).setTitle("📋 الأسئلة").setDescription("ماكو أسئلة بعد 🤷‍♂️");
      return interaction.update({
        embeds: [e],
        components: [new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
        )],
      });
    }
    let list = "";
    onboarding.questions.forEach((q, i) => {
      list += "**" + (i + 1) + ".** " + q.text + "\n";
      q.options.forEach((o, j) => {
        list += "   " + (j + 1) + ") " + (o.emoji || "") + " " + o.label + " → \`" + o.roleId + "\`\n";
      });
      list += "\n";
    });
    const e = new EmbedBuilder().setColor(0x9b59b6).setTitle("📋 الأسئلة")
      .setDescription(list.slice(0, 3800))
      .setFooter({ text: "المجموع: " + onboarding.questions.length });
    const rows = [new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("onb_del_menu").setLabel("حذف سؤال").setEmoji("🗑️").setStyle(ButtonStyle.Danger),
      new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary)
    )];
    return interaction.update({ embeds: [e], components: rows });
  }

  if (id === "onb_toggle") {
    onboarding.enabled = !onboarding.enabled;
    saveOnboarding();
    return interaction.update(onboardingPanel());
  }

  if (id === "panel_stickers_menu") {
    return interaction.update(stickersMenuPanel(uid));
  }

  if (id === "panel_stickers") {
    sessions.delete(uid);
    return interaction.update(deletePanel());
  }

  if (id === "panel_giphy") {
    lists.delete(uid);
    sessions.set(uid, { mode: "awaiting_giphy_category" });
    const e = new EmbedBuilder()
      .setColor(0x5865f2)
      .setTitle("🔎 بحث ملصقات")
      .setDescription("اختار نوع الملصقات:");
    const r1 = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("cat_games").setLabel("ألعاب").setEmoji("🎮").setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId("cat_funny").setLabel("مضحك").setEmoji("😂").setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId("cat_flags").setLabel("أعلام").setEmoji("🏳️").setStyle(ButtonStyle.Primary),
    );
    const r2 = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("cat_movies").setLabel("أفلام").setEmoji("🎬").setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId("cat_series").setLabel("مسلسلات").setEmoji("📺").setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId("cat_anime").setLabel("أنمي").setEmoji("🇯🇵").setStyle(ButtonStyle.Primary),
    );
    const r2b = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("cat_custom").setLabel("بكيفك").setEmoji("✍️").setStyle(ButtonStyle.Success),
      new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Secondary),
    );
    return interaction.update({ embeds: [e], components: [r1, r2, r2b] });
  }

  if (id === "list_stickers") {
    let guild = client.guilds.cache.get(GUILD_ID);
    if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
    if (!guild) return interaction.reply({ content: "ما كدرت اوصل للسيرفر", ephemeral: true });
    await interaction.deferReply();
    const fetched = await guild.stickers.fetch().catch(() => null);
    const items = fetched ? [...fetched.values()] : [...guild.stickers.cache.values()];
    if (items.length === 0) return interaction.editReply({ content: "ماكو ستيكرات 🤷‍♂️" });
    lists.set(uid, { type: "sticker", items });
    return interaction.editReply({ embeds: [buildList(items, "sticker")] });
  }

  if (id === "list_emojis") {
    let guild = client.guilds.cache.get(GUILD_ID);
    if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
    if (!guild) return interaction.reply({ content: "ما كدرت اوصل للسيرفر", ephemeral: true });
    await interaction.deferReply();
    await guild.emojis.fetch().catch(() => {});
    const items = [...guild.emojis.cache.values()];
    if (items.length === 0) return interaction.editReply({ content: "ماكو ايموجي 🤷‍♂️" });
    lists.set(uid, { type: "emoji", items });
    return interaction.editReply({ embeds: [buildList(items, "emoji")] });
  }

  if (id === "panel_convert") {
    lists.delete(uid);
    sessions.set(uid, { mode: "awaiting_images", attachments: [] });
    const embed = new EmbedBuilder()
      .setColor(0x5865f2)
      .setTitle("🖼️ تحويل صور")
      .setDescription("دزلي الصور هسه بالخاص ورا بعض.");
    return interaction.update({
      embeds: [embed],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("↩️").setStyle(ButtonStyle.Secondary)
      )],
    });
  }

  if (id === "conv_more") {
    const s = sessions.get(uid);
    if (s) { s.mode = "awaiting_images"; sessions.set(uid, s); }
    return interaction.reply({ content: "👍 دز الصور.", ephemeral: true });
  }

  if (id === "conv_reset") {
    sessions.delete(uid);
    return interaction.update({
      content: "✖️ تم الإلغاء.",
      embeds: [],
      components: [new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع").setEmoji("🏠").setStyle(ButtonStyle.Primary)
      )],
    });
  }

  if (id === "conv_emoji" || id === "conv_sticker" || id === "conv_emoji_static" || id === "conv_sticker_static") {
    return handleConvert(interaction);
  }
});

async function handleConvert(interaction) {
  const uid = interaction.user.id;
  const session = sessions.get(uid);
  if (!session || session.attachments.length === 0) {
    return interaction.reply({ content: "ماكو صور 🤔", ephemeral: true });
  }
  let guild = client.guilds.cache.get(GUILD_ID);
  if (!guild) guild = await client.guilds.fetch(GUILD_ID).catch(() => null);
  if (!guild) return interaction.reply({ content: "ما كدرت اوصل للسيرفر", ephemeral: true });

  await interaction.deferReply();
  await guild.emojis.fetch().catch(() => {});
  await guild.stickers.fetch().catch(() => {});

  const tier = guild.premiumTier;
  const emojiMax = ({ 0: 50, 1: 100, 2: 150, 3: 250 })[tier] ?? 50;
  const stickerMax = ({ 0: 5, 1: 15, 2: 30, 3: 60 })[tier] ?? 5;

  const isStatic = interaction.customId.endsWith("_static");
  const type = interaction.customId.includes("emoji") ? "emoji" : "sticker";
  const results = [];
  let ok = 0, fail = 0;

  for (const [i, att] of session.attachments.entries()) {
    let baseName;
    if (session.packName) {
      baseName = session.packName + "_" + (i + 1);
    } else {
      baseName =
        (att.name || "").replace(/\.[^.]+$/, "").replace(/[^a-zA-Z0-9_]/g, "_").slice(0, 25) ||
        "mr_" + Date.now().toString().slice(-6);
    }
    const safeName = baseName.slice(0, 30);
    let useUrl = att.url;
    if (isStatic && att.staticUrl) useUrl = att.staticUrl;
    else if (type === "emoji" && att.emojiUrl) useUrl = att.emojiUrl;
    else if (type === "sticker" && att.stickerUrl) useUrl = att.stickerUrl;

    try {
      if (type === "sticker") {
        if (guild.stickers.cache.size >= stickerMax) {
          results.push("❌ خلصت خزنة الستيكرات (" + stickerMax + ")");
          fail++; continue;
        }
        const st = await guild.stickers.create({ file: useUrl, name: safeName, tags: "😀" });
        results.push("✅ ستيكر: **" + st.name + "**");
        ok++;
      } else {
        if (guild.emojis.cache.size >= emojiMax) {
          results.push("❌ خلصت خزنة الايموجي (" + emojiMax + ")");
          fail++; continue;
        }
        const em = await guild.emojis.create({ attachment: useUrl, name: safeName });
        results.push("✅ ايموجي: " + em + " **" + em.name + "**");
        ok++;
      }
    } catch (err) {
      fail++;
      results.push("❌ صورة " + (i + 1) + ": " + err.message.split("\n")[0].slice(0, 100));
    }
  }

  sessions.delete(uid);

  const embed = new EmbedBuilder()
    .setColor(fail > 0 ? 0xffaa00 : 0x57f287)
    .setTitle("📊 نتيجة التحويل " + (isStatic ? "(ثابت)" : "(متحرك)"))
    .setDescription(
      "🌍 السيرفر: **" + guild.name + "**\n" +
      "✅ نجح: **" + ok + "**\n" +
      "❌ فشل: **" + fail + "**\n\n" +
      results.join("\n").slice(0, 3800)
    )
    .setFooter({ text: "MRBOT" })
    .setTimestamp();

  await interaction.editReply({
    embeds: [embed],
    components: [new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId("panel_back").setLabel("رجوع للوحة").setEmoji("🏠").setStyle(ButtonStyle.Primary)
    )],
  });
}

client.login(process.env.BOT_TOKEN);
