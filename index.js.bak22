      },
      {
        name: "🎯 الصلاحية",
        value: "> **أنت:**  " + (f.has("admin") ? "👑 **مالك**" : "👤 عضو") + "\n" +
               "> **الخدمات:**  \`" + f.size + "\` متاحة\n" +
               "> **المستخدم:**  <@" + uid + ">",
        inline: true,
      },
    ],
    footer: "MRBOT • v2.0 • " + new Date().getFullYear(),
  });

  const menu = new StringSelectMenuBuilder()
    .setCustomId("main_menu")
    .setPlaceholder("🎯  اختر خدمة من القائمة...")
    .setMinValues(1)
    .setMaxValues(1);

  if (f.has("convert")) {
    menu.addOptions(new StringSelectMenuOptionBuilder()
      .setLabel("🖼️  تحويل صور")
      .setDescription("حول صورك إلى إيموجي أو ستيكرات بسهولة")
      .setValue("panel_convert"));
  }
  if (f.has("delete") || f.has("giphy")) {
    menu.addOptions(new StringSelectMenuOptionBuilder()
      .setLabel("🏷️  إدارة الملصقات")
      .setDescription("حذف أو بحث عن ملصقات وإيموجيات السيرفر")
