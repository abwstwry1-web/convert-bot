});

function getFeatures(uid) {
  if (uid === OWNER_ID) return new Set(["convert","delete","giphy","admin"]);
  if (ALLOWED.includes(uid)) return new Set(["convert","delete","giphy"]);
  const m = members.get(uid);
  return m ? new Set(m.features) : null;
}
function isAllowed(id) {
  return ALLOWED.includes(id) || members.has(id);
}
function hasFeature(uid, feat) {
  const f = getFeatures(uid);
  return f ? f.has(feat) : false;
}
function checkFeature(id, uid) {
  if (!id) return true;
  if (id === "main_menu" || id === "panel_back" || id.startsWith("stk_page_")) return true;
  if (id.startsWith("cat_")) return hasFeature(uid, "giphy");
  const map = {
    panel_convert:"convert", conv_emoji:"convert", conv_emoji_static:"convert",
    conv_sticker:"convert", conv_sticker_static:"convert",
    conv_more:"convert", conv_reset:"convert",
    panel_stickers:"delete", list_stickers:"delete", list_emojis:"delete",
    stk_delete_selected:"delete", stk_delete_all:"delete",
    panel_giphy:"giphy", giphy_retry:"giphy",
    panel_add_member:"admin", panel_add_roles:"admin", 
    main_menu:"public", panel_channels:"admin", panel_notifications:"admin", notif_add:"admin", notif_list:"admin", notif_remove:"admin", notif_plat:"admin", notif_check_now:"admin", notif_edit_msg:"admin", notif_edit_plat:"admin", notif_back:"admin", chan_add:"admin", chan_del:"admin", chan_backup:"admin", chan_back:"admin",
    panel_broadcast:"admin", bc_send:"admin", bc_cancel:"admin", bc_back:"admin",
    panel_matches:"admin", match_add:"admin", match_list:"admin", match_del:"admin", match_back:"admin",
    panel_auto_matches:"admin", auto_set_ch:"admin", auto_refresh:"admin", auto_view:"admin", auto_clear:"admin", auto_test:"admin",
    member_features:"admin", member_confirm:"admin", member_cancel:"admin",
  };
  const f = map[id];
  return f ? hasFeature(uid, f) : true;
}

function buildGiphyPreviewEmbeds(items, query) {
  const embeds = [];
  const max = Math.min(items.length, 10);
  for (let i = 0; i < max; i++) {
    const e = new EmbedBuilder().setColor(0x5865f2).setImage(items[i].url);
    if (i === 0) {
      e.setTitle("🔎 " + query + " — " + items.length + " ملصق");
      e.setDescription("👇 إذا عجبك الملصقات اختر نوع الإضافة، وإذا ما عجبك اضغط **إعادة**");
    }
    e.setFooter({ text: "#" + (i + 1) });
    embeds.push(e);
  }
  return embeds;
}

function buildGiphyActionRows() {
  const r1 = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId("giphy_retry").setLabel("إعادة").setEmoji("🔄").setStyle(ButtonStyle.Secondary),
    new ButtonBuilder().setCustomId("conv_emoji").setLabel("إيموجي متحرك").setEmoji("🙂").setStyle(ButtonStyle.Primary),
    new ButtonBuilder().setCustomId("conv_emoji_static").setLabel("إيموجي ثابت").setEmoji("🖼️").setStyle(ButtonStyle.Primary),
  );
  const r2 = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId("conv_sticker").setLabel("ستيكر متحرك").setEmoji("🏷️").setStyle(ButtonStyle.Success),
    new ButtonBuilder().setCustomId("conv_sticker_static").setLabel("ستيكر ثابت").setEmoji("📌").setStyle(ButtonStyle.Success),
    new ButtonBuilder().setCustomId("conv_reset").setLabel("إلغاء").setEmoji("✖️").setStyle(ButtonStyle.Danger),
  );
  return [r1, r2];
}

async function sendGiphyPreview(target, session) {
  const embeds = buildGiphyPreviewEmbeds(session.attachments, session.giphyQuery);
  const rows = buildGiphyActionRows();
  return target.edit({ content: "", embeds, components: rows });
}

async function translateToEnglish(text) {
  try {
    const url = "https://api.mymemory.translated.net/get?q=" + encodeURIComponent(text) + "&langpair=ar|en";
    const res = await fetch(url);
    const data = await res.json();
    const out = data?.responseData?.translatedText;
    if (out && typeof out === "string" && out.length > 0 && !out.includes("MYMEMORY WARNING")) {
      return out;
    }
    return null;
  } catch (e) { return null; }
}

async function giphySearchOnce(query, limit, offset, lang) {
  const key = process.env.GIPHY_KEY;
  if (!key) return null;
  const safeLimit = Math.min(Math.max(limit, 1), 50);
  const off = Math.max(0, parseInt(offset) || 0);
  const url = "https://api.giphy.com/v1/stickers/search?api_key=" + key +
    "&q=" + encodeURIComponent(query) +
    "&limit=" + safeLimit +
    "&offset=" + off +
    "&rating=pg-13&lang=" + lang;
  try {
    const res = await fetch(url);
    const data = await res.json();
    if (!data.data || !data.data.length) return [];
    return data.data.map((g) => ({
      url: g.images.fixed_height_small?.url || g.images.fixed_height?.url || g.images.original.url,
      emojiUrl: g.images.fixed_height_small?.url || g.images.fixed_height?.url,
      stickerUrl: g.images.downsized?.url || g.images.fixed_height?.url,
      staticUrl: g.images.fixed_height_small_still?.url || g.images.fixed_height_still?.url || g.images.original_still?.url || g.images.fixed_height_small?.url,
      _id: g.id,
    }));
  } catch (e) {
    console.log("❌ Giphy error:", e.message);
    return [];
  }
}

async function searchGiphy(query, limit, offset) {
  const safeLimit = Math.min(Math.max(limit, 1), 50);
  const off = Math.max(0, parseInt(offset) || 0);

  // تنظيف الكلمة: نشيل التشكيل والرموز الزائدة
  let q = query.trim().replace(/[\u064B-\u065F\u0670]/g, "").replace(/\s+/g, " ");
  if (!q) q = query;

  const hasArabic = /[\u0600-\u06FF]/.test(q);

  // 1) جرب البحث الأصلي
  let results = await giphySearchOnce(q, safeLimit, off, hasArabic ? "ar" : "en");

  // 2) إذا عربي ونتائج قليلة → نترجم للإنجليزي
  let usedQuery = q;
  if (hasArabic && results.length < Math.ceil(safeLimit / 2)) {
    const translated = await translateToEnglish(q);
    if (translated && translated !== q) {
      console.log("🌐 ترجمة: " + q + " → " + translated);
      const tr = await giphySearchOnce(translated, safeLimit, off, "en");
      // دمج: ناخذ العربي أولاً، بعدين الإنجليزي (بدون تكرار)
      const seen = new Set(results.map((r) => r._id));
      for (const r of tr) {
        if (!seen.has(r._id)) { results.push(r); seen.add(r._id); }
      }
      usedQuery = translated;
    }
  }

  // 3) إذا بعدها فاضي → نجرب trending
  if (results.length === 0) {
    const key = process.env.GIPHY_KEY;
    if (key) {
      try {
        const url = "https://api.giphy.com/v1/stickers/trending?api_key=" + key + "&limit=" + safeLimit + "&rating=pg-13";
        const res = await fetch(url);
        const data = await res.json();
        if (data.data && data.data.length) {
          results = data.data.map((g) => ({
            url: g.images.fixed_height_small?.url || g.images.fixed_height?.url,
            emojiUrl: g.images.fixed_height_small?.url || g.images.fixed_height?.url,
            stickerUrl: g.images.downsized?.url || g.images.fixed_height?.url,
            staticUrl: g.images.fixed_height_small_still?.url || g.images.fixed_height_still?.url || g.images.fixed_height_small?.url,
            _id: g.id,
          }));
          console.log("🔥 رجعت trending بدل البحث");
        }
      } catch {}
    }
  }

  if (!results.length) return null;

  // نحدد الاسم النهائي
  let clean = usedQuery.replace(/[^a-zA-Z0-9]/g, "_").replace(/_+/g, "_").replace(/^_+|_+$/g, "").slice(0, 18);
  if (!clean) clean = "pack";

  return results.slice(0, safeLimit).map((r, i) => ({
    url: r.url,
    emojiUrl: r.emojiUrl,
    stickerUrl: r.stickerUrl,
    staticUrl: r.staticUrl,
    name: (clean + "_" + (i + 1)).slice(0, 30),
  }));
}

