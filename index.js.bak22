function buildNotifContent(sub) {
  // إذا المستخدم كتب رسالة مخصصة كاملة → استخدمها
  if (sub.customMessage && sub.customMessage.length > 0) {
    return sub.customMessage;
  }
  // نجيب القالب حسب المنصة والنوع
  const type = sub.type || "live";
  const key = sub.platform + "_" + type;
  const tpl = NOTIF_TEMPLATES[key];
  if (!tpl) return null;

  // الاسم: customName أو username
  const name = sub.customName || sub.username;
  return tpl.emoji + " **" + name + "** " + tpl.text + " <@&" + tpl.role + ">";
}

