const PANEL_COLORS = {
  main: 0x5865f2,
  convert: 0x57f287,
  stickers: 0xeb459e,
  channels: 0x3498db,
  roles: 0x9b59b6,
  members: 0xfee75c,
  broadcast: 0xe74c3c,
  matches: 0x2ecc71,
  danger: 0xff6b6b,
  warn: 0xffaa00,
};

const PANEL_ICONS = {
  main: "🎛️",
  convert: "🖼️",
  stickers: "🏷️",
  channels: "📁",
  roles: "🎭",
  members: "👥",
  broadcast: "📢",
  matches: "⚽",
  danger: "🗑️",
};

function buildPanelEmbed(opts) {
  const {
    icon = "🎛️",
    title = "لوحة التحكم",
    description = "",
    color = PANEL_COLORS.main,
    fields = [],
    stats = null,
    footer = "MRBOT • v2.0",
    thumbnail = true,
    timestamp = true,
  } = opts;

  const embed = new EmbedBuilder()
    .setColor(color)
    .setAuthor({ name: icon + "  " + title })
    .setDescription(description)
    .setFooter({ text: footer });

  // الإحصائيات على شكل شبكة أنيقة
  if (stats && stats.length) {
    const lines = [];
    lines.push("**╭──────────── 📊 ────────────╮**");
    for (const st of stats) {
      const val = String(st.value || 0).padStart(6, " ");
      lines.push("**│** " + (st.emoji || "▪️") + "  **" + st.label + "**  \`" + val + "\`");
    }
    lines.push("**╰──────────────────────────╯**");
    embed.addFields({ name: "\u200b", value: lines.join("\n") });
  }

  // حقول إضافية
  for (const f of fields) {
    embed.addFields({ name: f.name, value: f.value, inline: f.inline || false });
  }

  if (thumbnail) {
    try {
      const g = client.guilds.cache.get(GUILD_ID);
      if (g && g.iconURL()) embed.setThumbnail(g.iconURL({ size: 256 }));
    } catch {}
  }

  if (timestamp) embed.setTimestamp();

  return embed;
}

function getGuildStats() {
  try {
    const g = client.guilds.cache.get(GUILD_ID);
    if (!g) return null;
    return {
      members: g.memberCount || 0,
      online: g.members.cache.filter((m) => m.presence && m.presence.status !== "offline").size || 0,
      roles: g.roles.cache.size || 0,
      emojis: g.emojis.cache.size || 0,
      stickers: g.stickers.cache.size || 0,
      boosts: g.premiumSubscriptionCount || 0,
      tier: g.premiumTier || 0,
      channels: [...g.channels.cache.values()].filter((c) => c.type === 4).length || 0,
      rooms: [...g.channels.cache.values()].filter((c) => c.type !== 4).length || 0,
      name: g.name,
      icon: g.iconURL({ size: 256 }),
    };
  } catch (e) { return null; }
}

