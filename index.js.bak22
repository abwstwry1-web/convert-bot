      .setValue("panel_add_member"));
    menu.addOptions(new StringSelectMenuOptionBuilder()
      .setLabel("📢  إرسال جماعي")
      .setDescription("إرسال رسالة خاصة لكل الأعضاء")
      .setValue("panel_broadcast"));
    menu.addOptions(new StringSelectMenuOptionBuilder()
      .setLabel("⚽  مباريات تلقائية")
      .setDescription("توقعات المباريات الدولية الحية")
      .setValue("panel_auto_matches"));

    menu.addOptions(new StringSelectMenuOptionBuilder()
      .setLabel("📢  الإشعارات")
