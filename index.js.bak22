function flagEmoji(code) {
  if (!code || code.length !== 2) return "🏳️";
  return code.toUpperCase().replace(/./g, function(c) {
    return String.fromCodePoint(c.charCodeAt(0) + 127397);
  });
}

function formatIraqTime(ms) {
  try {
    const d = new Date(ms + 3 * 3600 * 1000);
    const y = d.getUTCFullYear();
    const mo = String(d.getUTCMonth() + 1).padStart(2, "0");
    const da = String(d.getUTCDate()).padStart(2, "0");
    const h = String(d.getUTCHours()).padStart(2, "0");
    const mi = String(d.getUTCMinutes()).padStart(2, "0");
    return y + "-" + mo + "-" + da + " " + h + ":" + mi;
  } catch { return "?"; }
}

function parseIraqTime(str) {
  let m = str.match(/(\d{4})-(\d{1,2})-(\d{1,2})\s+(\d{1,2}):(\d{2})/);
  let y, mo, d, h, mi;
  if (m) { y = m[1]; mo = m[2]; d = m[3]; h = m[4]; mi = m[5]; }
  else {
    m = str.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(\d{1,2}):(\d{2})/);
    if (!m) return null;
    d = m[1]; mo = m[2]; y = m[3]; h = m[4]; mi = m[5];
  }
  return Date.UTC(parseInt(y), parseInt(mo) - 1, parseInt(d), parseInt(h) - 3, parseInt(mi));
}

function buildMatchEmbed(m) {
  const now = Date.now();
  const remain = m.startTime - now;

  // ═══ الحالة ═══
  const live = m.liveData || null;
  let statusLine = "";

  if (m.closed && live) {
    // المباراة شغالة أو منتهية
    const s = live.status;
    const min = live.elapsed || 0;
    const ex = live.extra || 0;

    if (s === "NS") {
      statusLine = "🕐 **تبدأ قريباً**";
    } else if (s === "1H" || s === "2H") {
      statusLine = "🔴 **" + min + "'**";
      if (ex > 0) statusLine += " **+" + ex + "**";
    } else if (s === "HT") {
      statusLine = "⏸️ **استراحة**";
    } else if (s === "ET") {
      statusLine = "🔴 **الوقت الإضافي " + min + "'**";
      if (ex > 0) statusLine += " **+" + ex + "**";
    } else if (s === "BT") {
      statusLine = "⏸️ **استراحة الوقت الإضافي**";
    } else if (s === "P" || s === "PEN") {
      statusLine = "🥅 **ركلات الترجيح**";
    } else if (s === "FT" || s === "AET") {
      statusLine = "🏁 **انتهت المباراة**";
    } else if (s === "SUSP" || s === "INT") {
      statusLine = "⏸️ **موقوفة مؤقتاً**";
    } else if (s === "PST") {
      statusLine = "📅 **مؤجلة**";
    } else if (s === "CANC") {
      statusLine = "❌ **ملغاة**";
    } else {
      statusLine = s;
    }
  } else if (m.closed || remain <= 0) {
    statusLine = "🔴 **التوقع مقفل**";
  } else if (remain > 0) {
    const h = Math.floor(remain / 3600000);
    const mn = Math.floor((remain % 3600000) / 60000);
    statusLine = "⏳ متبقي: " + (h > 0 ? h + " ساعة " : "") + mn + " دقيقة";
  }

  // ═══ النتيجة ═══
  const hs = live ? live.homeScore : 0;
  const as_ = live ? live.awayScore : 0;
  let scoreLine = "";
  if (m.closed && live && live.status !== "NS") {
    scoreLine = "\n\n**" + hs + " - " + as_ + "**\n";
  }

  const preds = Object.keys(m.predictions || {}).length;

  const embed = new EmbedBuilder()
    .setColor(m.closed ? 0xe74c3c : 0x9b59b6)
    .setTitle(flagEmoji(m.flag1) + "  " + m.team1 + "  VS  " + m.team2 + "  " + flagEmoji(m.flag2))
    .setDescription(
      scoreLine +
      "📅 **الموعد:** " + formatIraqTime(m.startTime) + " (بغداد)\n" +
      statusLine + "\n\n" +
      "🎯 **المتوقعين:** " + preds
    )
    .setFooter({ text: "MRBOT Matches" });
  if (m.logo1) embed.setThumbnail(m.logo1);
  return embed;
}

async function loadImageFromUrl(url) {
  try {
    if (!url) return null;
    const r = await fetch(url);
    if (!r.ok) return null;
    const buf = Buffer.from(await r.arrayBuffer());
    return await loadImage(buf);
  } catch (e) { return null; }
}

async function sendMatchCard(channel, m, withButton) {
  const buf = await generateMatchCard(m);
  const fileName = "match_" + m.id + ".png";
  const file = new AttachmentBuilder(buf, { name: fileName });
  const preds = Object.keys(m.predictions || {}).length;
  const closed = m.closed || Date.now() >= m.startTime;
  const embed = new EmbedBuilder()
    .setColor(closed ? 0x95a5a6 : 0x5865f2)
    .setImage("attachment://" + fileName)
    .setFooter({ text: (closed ? "🔴 التوقع مقفل" : "🎯 المتوقعين: " + preds) + " • MRBOT" });
  const options = { embeds: [embed], files: [file] };
  const btns = [];
  if (withButton && !closed) btns.push(new ButtonBuilder().setCustomId("predict_btn_" + m.id).setLabel("خمن النتيجة").setEmoji("🎯").setStyle(ButtonStyle.Primary));
  btns.push(new ButtonBuilder().setCustomId("lineup_" + (m.fixtureId || m.id)).setLabel("التشكيلة").setEmoji("👥").setStyle(ButtonStyle.Secondary));
  if (btns.length) options.components = [new ActionRowBuilder().addComponents(btns)];
  return channel.send(options);
}

async function editMatchCard(channel, messageId, m, withButton) {
  try {
    const buf = await generateMatchCard(m);
    const fileName = "match_" + m.id + ".png";
    const file = new AttachmentBuilder(buf, { name: fileName });
    const preds = Object.keys(m.predictions || {}).length;
    const closed = m.closed || Date.now() >= m.startTime;
    const embed = new EmbedBuilder()
      .setColor(closed ? 0x95a5a6 : 0x5865f2)
      .setImage("attachment://" + fileName)
      .setFooter({ text: (closed ? "🔴 التوقع مقفل" : "🎯 المتوقعين: " + preds) + " • MRBOT" });
    const msg = await channel.messages.fetch(messageId).catch(() => null);
    if (!msg) return null;
    const options = { embeds: [embed], files: [file] };
    if (withButton && !closed) {
      const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId("predict_btn_" + m.id).setLabel("خمن النتيجة").setEmoji("🎯").setStyle(ButtonStyle.Primary)
      );
      options.components = [row];
    } else {
      options.components = [];
    }
    return msg.edit(options);
  } catch (e) { console.log("edit card err:", e.message); return null; }
}

// ═══════════ تسجيل الخطوط ═══════════
let AR = "bold 30px sans-serif"; // الخط العربي
try {
  const path = require("path");
  const fontsDir = path.join(__dirname, "fonts");
  let loaded = false;
  if (fs.existsSync(fontsDir)) {
    const files = fs.readdirSync(fontsDir).filter((f) => f.endsWith(".ttf") || f.endsWith(".otf") || f.endsWith(".woff"));
    for (const f of files) {
      const p = path.join(fontsDir, f);
      const sz = fs.statSync(p).size;
      if (sz < 5000) { console.log("⚠️ " + f + " صغير (" + sz + "b) — نتخطى"); continue; }
      try {
        GlobalFonts.registerFromPath(p, "ArabicFont");
        console.log("✅ سُجل: " + f + " (" + Math.round(sz / 1024) + " KB)");
        loaded = true;
        break;
      } catch (e) { console.log("❌ " + f + ": " + e.message); }
    }
  }
  // خط لاتيني
  const latinPath = path.join(fontsDir, "NotoSans-Bold.ttf");
  let latinLoaded = false;
  if (fs.existsSync(latinPath) && fs.statSync(latinPath).size > 5000) {
    try {
      GlobalFonts.registerFromPath(latinPath, "LatinFont");
      console.log("✅ سُجل: NotoSans-Bold.ttf (لاتيني)");
      latinLoaded = true;
    } catch (e) { console.log("❌ latin:", e.message); }
  }

  if (loaded && latinLoaded) {
    AR = "bold 30px LatinFont, ArabicFont";
    console.log("✅ الخطوط جاهزة (لاتيني + عربي)");
  } else if (loaded) {
    AR = "bold 30px LatinFont, ArabicFont";
    console.log("✅ عربي بس");
  } else if (latinLoaded) {
    AR = "bold 30px LatinFont";
    console.log("⚠️ لاتيني بس");
  } else {
    console.log("⚠️ ماكو خط عربي — راح تستخدم الافتراضي (الأحرف العربية ما تظهر)");
  }
} catch (e) { console.log("font err:", e.message); }

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

function fitFont(ctx, text, maxW, baseSize) {
  let size = baseSize;
  ctx.font = "bold " + size + "px LatinFont, ArabicFont, sans-serif";
  while (ctx.measureText(text).width > maxW && size > 16) {
    size -= 2;
    ctx.font = "bold " + size + "px LatinFont, ArabicFont, sans-serif";
  }
  return size;
}

