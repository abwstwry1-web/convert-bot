const NOTIF_FILE = require("path").join(__dirname, "data", "notifications.json");
function loadNotifData() {
  try {
    if (fs.existsSync(NOTIF_FILE)) return JSON.parse(fs.readFileSync(NOTIF_FILE, "utf8"));
  } catch (e) { console.log("notif load err:", e.message); }
  return { subs: [] };
}
function saveNotifData() {
  try {
    const dir = require("path").dirname(NOTIF_FILE);
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(NOTIF_FILE, JSON.stringify(notifData, null, 2));
  } catch (e) { console.log("notif save err:", e.message); }
}
let notifData = loadNotifData();

