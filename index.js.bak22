function mainPanel(uid) {
  const f = getFeatures(uid) || new Set();
  const stats = getGuildStats();

  const now = new Date();
  const iraq = new Date(now.getTime() + 3 * 3600 * 1000);
  const hour = iraq.getUTCHours();
  const greeting = hour < 5 ? "🌙 ليلة هادئة" : hour < 12 ? "☀️ صباح الخير" : hour < 17 ? "🌤️ مساء النور" : hour < 21 ? "🌆 مساء الخير" : "🌙 مساء الخير";
  const timeStr = String(iraq.getUTCHours()).padStart(2, "0") + ":" + String(iraq.getUTCMinutes()).padStart(2, "0");

  const statLines = stats ? [
    { emoji: "👥", label: "الأعضاء الكلي   ", value: stats.members },
    { emoji: "🟢", label: "المتصلين حالياً  ", value: stats.online },
    { emoji: "🎭", label: "الرتب            ", value: stats.roles },
    { emoji: "😀", label: "الإيموجيات      ", value: stats.emojis },
    { emoji: "🎨", label: "الملصقات        ", value: stats.stickers },
    { emoji: "💎", label: "البوستات        ", value: stats.boosts + " (T" + stats.tier + ")" },
  ] : [];

  const embed = buildPanelEmbed({
    icon: "🎛️",
    title: "لوحة التحكم الرئيسية",
    color: PANEL_COLORS.main,
    description:
      "### 🏠 " + (stats ? stats.name : "MR AWSY Community") + "\n" +
      "> **" + greeting + "**  •  ⏰ \`" + timeStr + "\` (بغداد)\n" +
      "> اختر الخدمة من القائمة بالأسفل 👇\n\u200b",
    stats: statLines,
    fields: [
      {
        name: "📌 حالة النظام",
        value: "> **البوت:**  " + (paused ? "🔴 مطفي" : "🟢 شغال") + "\n" +
               "> **الاتصال:**  🟢 سليم\n" +
               "> **الخوادم:**  \`" + client.guilds.cache.size + "\`",
